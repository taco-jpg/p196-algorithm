def ModularAutonomy.EventualReverseResidueDet : Nat → Prop :=
fun M =>
  ∃ B,
    ∀ (L : Nat),
      B ≤ L →
        ∀ (n m : Nat) (d e : Nat → Nat),
          DecimalDigits.Canonical n d L →
            DecimalDigits.Canonical m e L → n % M = m % M → Lychrel196.reverse10 n % M = Lychrel196.reverse10 m % M
def ModularAutonomy.EventualStepResidueDet : Nat → Prop :=
fun M =>
  ∃ B,
    ∀ (L : Nat),
      B ≤ L →
        ∀ (n m : Nat) (d e : Nat → Nat),
          DecimalDigits.Canonical n d L →
            DecimalDigits.Canonical m e L → n % M = m % M → Lychrel196.step n % M = Lychrel196.step m % M
def DecimalDigits.Canonical : Nat → (Nat → Nat) → Nat → Prop :=
fun n d L => 0 < L ∧ (∀ (i : Nat), i < L → d i ≤ 9) ∧ 0 < d (L - 1) ∧ DecimalDigits.value d L = n
def Lychrel196.reverse10 : Nat → Nat :=
fun n => Lychrel196.reverseFuel n n 0
def Lychrel196.step : Nat → Nat :=
fun n => n + Lychrel196.reverse10 n
