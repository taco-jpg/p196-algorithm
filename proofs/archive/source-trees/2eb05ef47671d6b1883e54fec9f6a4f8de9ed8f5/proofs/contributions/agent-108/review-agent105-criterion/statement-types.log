def Lychrel196.reverse10 : Nat → Nat :=
fun n => Lychrel196.reverseFuel n n 0
def Lychrel196.step : Nat → Nat :=
fun n => n + Lychrel196.reverse10 n
def Lychrel196.Palindrome : Nat → Prop :=
fun n => Lychrel196.reverse10 n = n
def Lychrel196.orbit : Nat → Nat → Nat :=
fun n x =>
  Nat.brecOn x fun x f =>
    (match (motive := (x : Nat) → Nat.below x → Nat) x with
      | 0 => fun x => n
      | k.succ => fun x => Lychrel196.step x.1)
      f
def DecimalDigits.Canonical : Nat → (Nat → Nat) → Nat → Prop :=
fun n d L => 0 < L ∧ (∀ (i : Nat), i < L → d i ≤ 9) ∧ 0 < d (L - 1) ∧ DecimalDigits.value d L = n
def FoldedDecimal.Admissible : Nat → (Nat → Nat) → Prop :=
fun L q =>
  0 < L ∧
    0 < q 0 ∧
      (∀ (i : Nat), i < L → q i ≤ 18) ∧
        (∀ (i : Nat), i < L → q i = q (L - 1 - i)) ∧ ∀ (i : Nat), i < L → i = L - 1 - i → q i % 2 = 0
def FoldedDecimal.nextWidth : (Nat → Nat) → Nat → Nat :=
fun q L => if DecimalDigits.carry q L = 0 then L else L + 1
def OverflowCarryNormalization.iterPairs : (Nat → Nat) → Nat → Nat → Nat × (Nat → Nat) :=
fun q L x =>
  Nat.brecOn x fun x f =>
    (match (motive := (x : Nat) → Nat.below x → Nat × (Nat → Nat)) x with
      | 0 => fun x => (L, q)
      | k.succ => fun x =>
        let prev := x.1;
        (FoldedDecimal.nextWidth prev.snd prev.fst, FoldedDecimal.nextColumns prev.snd prev.fst))
      f
def HighCarryReduction.HighCarryWord : (Nat → Nat) → Nat → Prop :=
fun q L => (∀ (i : Nat), i < L → 9 ≤ q i ∧ q i ≤ 18) ∧ 10 ≤ q 0
def Agent105.NumericHigh.NumericHigh : Nat → Prop :=
fun n => ∃ d L, DecimalDigits.Canonical n d L ∧ HighCarryReduction.HighCarryWord (DecimalDigits.columnSum d L) L
def Agent105.LocalHigh.actualCarrySum : (Nat → Nat) → Nat → Nat → Nat :=
fun p M i => DecimalDigits.carry p i + DecimalDigits.carry p (M - 1 - i)
def Agent105.LocalHigh.LocalAllowed : Nat → Nat → Prop :=
fun a u => (4 ≤ a ∧ a ≤ 9 ∨ 14 ≤ a ∧ a ≤ 18) ∧ (a = 4 ∨ a = 14 → 1 ≤ u) ∧ (a = 9 → u ≤ 1)
OverflowCarryNormalization.iterPairs_representation (n : Nat) (d q : Nat → Nat) (L k : Nat)
  (hcan : DecimalDigits.Canonical n d L) (hrep : ∀ (i : Nat), i < L → DecimalDigits.columnSum d L i = q i) :
  ∃ e,
    DecimalDigits.Canonical (Lychrel196.orbit n k) e (OverflowCarryNormalization.iterPairs q L k).fst ∧
      ∀ (i : Nat),
        i < (OverflowCarryNormalization.iterPairs q L k).fst →
          DecimalDigits.columnSum e (OverflowCarryNormalization.iterPairs q L k).fst i =
            (OverflowCarryNormalization.iterPairs q L k).snd i
Agent105.ActualHighReturn.high_return_no_second_overflow (q : Nat → Nat) (L : Nat) (ha : FoldedDecimal.Admissible L q)
  (hq : HighCarryReduction.HighCarryWord q L)
  (hr :
    HighCarryReduction.HighCarryWord (OverflowCarryNormalization.iterPairs q L 2).snd
      (OverflowCarryNormalization.iterPairs q L 2).fst) :
  DecimalDigits.carry (FoldedDecimal.nextColumns q L) (L + 1) = 0
Agent105.LocalHigh.nextColumns_formula (p : Nat → Nat) (M i : Nat) (hb : ∀ (j : Nat), j < M → p j ≤ 18)
  (hs : ∀ (j : Nat), j < M → p j = p (M - 1 - j)) (hi : i < M) (hc : DecimalDigits.carry p M = 0) :
  FoldedDecimal.nextColumns p M i =
    if p i < 9 then 2 * p i + Agent105.LocalHigh.actualCarrySum p M i
    else
      if p i = 9 then 18 - 9 * Agent105.LocalHigh.actualCarrySum p M i
      else 2 * p i - 20 + Agent105.LocalHigh.actualCarrySum p M i
Agent105.LocalHigh.nextColumns_high_iff (p : Nat → Nat) (M i : Nat) (hb : ∀ (j : Nat), j < M → p j ≤ 18)
  (hs : ∀ (j : Nat), j < M → p j = p (M - 1 - j)) (hi : i < M) (hc : DecimalDigits.carry p M = 0) :
  9 ≤ FoldedDecimal.nextColumns p M i ∧ FoldedDecimal.nextColumns p M i ≤ 18 ↔
    Agent105.LocalHigh.LocalAllowed (p i) (Agent105.LocalHigh.actualCarrySum p M i)
Agent105.ReturnCriterion.high_return_iff (q : Nat → Nat) (L : Nat) (ha : FoldedDecimal.Admissible L q)
  (hq : HighCarryReduction.HighCarryWord q L) :
  HighCarryReduction.HighCarryWord (OverflowCarryNormalization.iterPairs q L 2).snd
      (OverflowCarryNormalization.iterPairs q L 2).fst ↔
    DecimalDigits.carry (FoldedDecimal.nextColumns q L) (L + 1) = 0 ∧
      14 ≤ q 0 ∧
        ∀ (i : Nat),
          i < L + 1 →
            Agent105.LocalHigh.LocalAllowed (FoldedDecimal.nextColumns q L i)
              (Agent105.LocalHigh.actualCarrySum (FoldedDecimal.nextColumns q L) (L + 1) i)
Agent105.ReturnCriterion.numeric_high_return_iff (n : Nat) (d q : Nat → Nat) (L : Nat)
  (hc : DecimalDigits.Canonical n d L) (hrep : ∀ (i : Nat), i < L → DecimalDigits.columnSum d L i = q i)
  (hq : HighCarryReduction.HighCarryWord q L) :
  Agent105.NumericHigh.NumericHigh (Lychrel196.orbit n 2) ↔
    DecimalDigits.carry (FoldedDecimal.nextColumns q L) (L + 1) = 0 ∧
      14 ≤ q 0 ∧
        ∀ (i : Nat),
          i < L + 1 →
            Agent105.LocalHigh.LocalAllowed (FoldedDecimal.nextColumns q L i)
              (Agent105.LocalHigh.actualCarrySum (FoldedDecimal.nextColumns q L) (L + 1) i)
Agent105.ReturnSafety.numeric_first_palindrome_iff_all_eleven (n : Nat) (d q : Nat → Nat) (L : Nat)
  (hc : DecimalDigits.Canonical n d L) (hrep : ∀ (i : Nat), i < L → DecimalDigits.columnSum d L i = q i)
  (hq : HighCarryReduction.HighCarryWord q L) :
  Lychrel196.Palindrome (Lychrel196.step n) ↔ ∀ (i : Nat), i < L → q i = 11
Agent105.ReturnSafety.numeric_two_outputs_safe_iff_large_adjacent (n : Nat) (d q : Nat → Nat) (L : Nat)
  (hc : DecimalDigits.Canonical n d L) (hrep : ∀ (i : Nat), i < L → DecimalDigits.columnSum d L i = q i)
  (hq : HighCarryReduction.HighCarryWord q L) :
  ¬Lychrel196.Palindrome (Lychrel196.step n) ∧ ¬Lychrel196.Palindrome (Lychrel196.orbit n 2) ↔
    ∃ i, 0 < i ∧ i < L ∧ 28 ≤ q (i - 1) + q i
Agent105.ReturnSafety.numeric_two_outputs_safe_iff_next_pair_large (n : Nat) (d q : Nat → Nat) (L : Nat)
  (hc : DecimalDigits.Canonical n d L) (hrep : ∀ (i : Nat), i < L → DecimalDigits.columnSum d L i = q i)
  (hq : HighCarryReduction.HighCarryWord q L) :
  ¬Lychrel196.Palindrome (Lychrel196.step n) ∧ ¬Lychrel196.Palindrome (Lychrel196.orbit n 2) ↔
    ∃ i, i < FoldedDecimal.nextWidth q L ∧ 10 ≤ FoldedDecimal.nextColumns q L i
