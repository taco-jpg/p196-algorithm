Agent115.ExteriorFactorization.target : Agent115.ExteriorFactorization.Target
def Agent115.ExteriorFactorization.Target : Prop :=
∀ (c : Nat) (B₁ B₂ : List Nat),
  Agent115.ExteriorFactorization.nonneutralPhase c →
    P196.Agent7.Finite.validOuter { c := c, B := B₁ } = true →
      P196.Agent7.Finite.validOuter { c := c, B := B₂ } = true →
        Agent115.ExteriorFactorization.zValue c B₁ = Agent115.ExteriorFactorization.zValue c B₂ →
          Agent115.ExteriorFactorization.rhoNum c B₁ * 10 ^ B₂.length =
              Agent115.ExteriorFactorization.rhoNum c B₂ * 10 ^ B₁.length →
            P196.Agent7.Finite.outerNext { c := c, B := B₁ } = P196.Agent7.Finite.outerNext { c := c, B := B₂ }
'Agent115.ExteriorFactorization.target' depends on axioms: [propext, Classical.choice, Quot.sound]
'Agent115.ExteriorFactorization.factorization_general' depends on axioms: [propext, Classical.choice, Quot.sound]
'Agent115.ExteriorFactorization.outerNext_append_band' depends on axioms: [propext, Classical.choice, Quot.sound]
'Agent115.ExteriorFactorization.outerNext_of_values' depends on axioms: [propext, Quot.sound]
'Agent115.ExteriorFactorization.normalize_eq' depends on axioms: [propext, Quot.sound]
