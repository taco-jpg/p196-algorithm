Agent113.TwoDigit.ancestry_bound_65 : ∀ (A P t : Nat),
  0 < A → Agent113.TwoDigit.PalindromeStartsTwo 6 5 P → Lychrel196.orbit A t = P → t ≤ 6
Agent113.TwoDigit.no_196_thirteen : ∀ (t : Nat) (ab : Nat × Nat),
  ab ∈ Agent113.TwoDigit.thirteenPrefixes →
    ¬Agent113.TwoDigit.PalindromeStartsTwo ab.fst ab.snd (Lychrel196.orbit 196 t)
Agent113.TwoDigit.no_196_thirteen_arith : ∀ (t k : Nat),
  Lychrel196.Palindrome (Lychrel196.orbit 196 t) →
    ¬Lychrel196.orbit 196 t / 10 ^ k ∈ [10, 20, 32, 40, 41, 60, 64, 65, 76, 80, 81, 82, 83]
Agent113.TwoDigit.startsTwo_iff : ∀ (a b P : Nat),
  Agent113.TwoDigit.StartsTwo a b P ↔ 1 ≤ a ∧ a ≤ 9 ∧ b ≤ 9 ∧ ∃ k, P / 10 ^ k = 10 * a + b
def Agent113.TwoDigit.PalindromeStartsTwo : Nat → Nat → Nat → Prop :=
fun a b P => Lychrel196.Palindrome P ∧ Agent113.TwoDigit.StartsTwo a b P
def Agent113.TwoDigit.StartsTwo : Nat → Nat → Nat → Prop :=
fun a b P => ∃ e W, DecimalDigits.Canonical P e W ∧ 2 ≤ W ∧ e (W - 1) = a ∧ e (W - 2) = b
def Agent113.TwoDigit.SharpAt : Nat → Nat → Nat → Nat → Nat → Prop :=
fun a b R h k =>
  Agent113.TwoDigit.PalindromeStartsTwo a b (Lychrel196.orbit R h) ∧
    (∀ (j : Nat), j < h → ¬Lychrel196.Palindrome (Lychrel196.orbit R j)) ∧ Lychrel196.orbit R h / 10 ^ k = 10 * a + b
def Lychrel196.orbit : Nat → Nat → Nat :=
fun n x =>
  Nat.brecOn x fun x f =>
    (match (motive := (x : Nat) → Nat.below x → Nat) x with
      | 0 => fun x => n
      | k.succ => fun x => Lychrel196.step x.1)
      f
def Lychrel196.step : Nat → Nat :=
fun n => n + Lychrel196.reverse10 n
def Lychrel196.reverse10 : Nat → Nat :=
fun n => Lychrel196.reverseFuel n n 0
def Lychrel196.reverseFuel : Nat → Nat → Nat → Nat :=
fun x x_1 x_2 =>
  Nat.brecOn (motive := fun x => Nat → Nat → Nat) x
    (fun x f x_3 x_4 =>
      (match (motive := (x : Nat) → Nat → Nat → Nat.below (motive := fun x => Nat → Nat → Nat) x → Nat) x, x_3, x_4 with
        | 0, x, acc => fun x => acc
        | fuel.succ, n, acc => fun x => if n = 0 then acc else x.1 (n / 10) (10 * acc + n % 10))
        f)
    x_1 x_2
def Lychrel196.Palindrome : Nat → Prop :=
fun n => Lychrel196.reverse10 n = n
def DecimalDigits.Canonical : Nat → (Nat → Nat) → Nat → Prop :=
fun n d L => 0 < L ∧ (∀ (i : Nat), i < L → d i ≤ 9) ∧ 0 < d (L - 1) ∧ DecimalDigits.value d L = n
'Agent113.TwoDigit.ancestry_bound_65' depends on axioms: [propext, Classical.choice, Quot.sound]
'Agent113.TwoDigit.no_196_thirteen' depends on axioms: [propext, Classical.choice, Quot.sound]
