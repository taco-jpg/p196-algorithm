Agent105.ActualHighReturn.numeric_high_returns_le_three (n R : Nat) (hn : LT.lt.{0} 0 n)
  (hH : ∀ (j : Nat), LE.le.{0} j R → Agent105.NumericHigh.NumericHigh (Lychrel196.orbit n (HMul.hMul.{0, 0, 0} 2 j))) :
  LE.le.{0} R 3
Agent105.ActualHighReturn.numeric_high_returns_after_le_three (n start R : Nat) (hn : LT.lt.{0} 0 n)
  (hH :
    ∀ (j : Nat),
      LE.le.{0} j R →
        Agent105.NumericHigh.NumericHigh (Lychrel196.orbit n (HAdd.hAdd.{0, 0, 0} start (HMul.hMul.{0, 0, 0} 2 j)))) :
  LE.le.{0} R 3
def Agent105.NumericHigh.NumericHigh : Nat → Prop :=
fun n => ∃ d L, DecimalDigits.Canonical n d L ∧ HighCarryReduction.HighCarryWord (DecimalDigits.columnSum d L) L
def HighCarryReduction.HighCarryWord : (Nat → Nat) → Nat → Prop :=
fun q L => (∀ (i : Nat), i < L → 9 ≤ q i ∧ q i ≤ 18) ∧ 10 ≤ q 0
def DecimalDigits.Canonical : Nat → (Nat → Nat) → Nat → Prop :=
fun n d L => 0 < L ∧ (∀ (i : Nat), i < L → d i ≤ 9) ∧ 0 < d (L - 1) ∧ DecimalDigits.value d L = n
def DecimalDigits.columnSum : (Nat → Nat) → Nat → Nat → Nat :=
fun d L i => d i + DecimalDigits.reflected d L i
def DecimalDigits.reflected : (Nat → Nat) → Nat → Nat → Nat :=
fun d L i => d (L - 1 - i)
def Lychrel196.orbit : Nat → Nat → Nat :=
fun n x =>
  Nat.brecOn x fun x f =>
    (match (motive := (x : Nat) → Nat.below x → Nat) x with
      | 0 => fun x => n
      | k.succ => fun x => Lychrel196.step x.1)
      f
def Lychrel196.step : Nat → Nat :=
fun n => n + Lychrel196.reverse10 n
def Lychrel196.reverse10 : Nat → Nat :=
fun n => Lychrel196.reverseFuel n n 0
