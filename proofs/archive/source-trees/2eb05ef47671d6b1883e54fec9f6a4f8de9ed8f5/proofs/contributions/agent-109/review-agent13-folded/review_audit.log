Agent13FoldedFamily.exact_binary_family : ∀ (r k : Nat),
  0 < k →
    ∃ f,
      (∀ (i j : Fin (2 ^ r)), (∀ (t : Nat), t < 2 * Agent13FoldedFamily.halfWidth r k → f i t = f j t) → i = j) ∧
        Agent13FoldedFamily.WordSafe (2 * Agent13FoldedFamily.halfWidth r k) (Agent13FoldedFamily.targetWord r k) ∧
          ∀ (j : Fin (2 ^ r)),
            Agent13FoldedFamily.WordSafe (2 * Agent13FoldedFamily.halfWidth r k) (f j) ∧
              DecimalDigits.carry (f j) (2 * Agent13FoldedFamily.halfWidth r k) = 0 ∧
                (∀ (t : Nat),
                    t < 2 * Agent13FoldedFamily.halfWidth r k →
                      FoldedDecimal.nextColumns (f j) (2 * Agent13FoldedFamily.halfWidth r k) t =
                        Agent13FoldedFamily.targetWord r k t) ∧
                  ∃ n d d',
                    0 < n ∧
                      DecimalDigits.Canonical n d (2 * Agent13FoldedFamily.halfWidth r k) ∧
                        (∀ (t : Nat),
                            t < 2 * Agent13FoldedFamily.halfWidth r k →
                              DecimalDigits.columnSum d (2 * Agent13FoldedFamily.halfWidth r k) t = f j t) ∧
                          DecimalDigits.Canonical (Lychrel196.step n) d' (2 * Agent13FoldedFamily.halfWidth r k) ∧
                            (∀ (t : Nat),
                                t < 2 * Agent13FoldedFamily.halfWidth r k →
                                  DecimalDigits.columnSum d' (2 * Agent13FoldedFamily.halfWidth r k) t =
                                    Agent13FoldedFamily.targetWord r k t) ∧
                              ¬Lychrel196.Palindrome n ∧
                                ¬Lychrel196.Palindrome (Lychrel196.step n) ∧
                                  ¬Lychrel196.Palindrome (Lychrel196.step (Lychrel196.step n))
Agent13FoldedFamily.binary_family_actual_step : ∀ (e : Nat → Bool) (r k n : Nat) (d : Nat → Nat),
  0 < k →
    DecimalDigits.Canonical n d (2 * Agent13FoldedFamily.halfWidth r k) →
      (∀ (i : Nat),
          i < 2 * Agent13FoldedFamily.halfWidth r k →
            DecimalDigits.columnSum d (2 * Agent13FoldedFamily.halfWidth r k) i =
              Agent13FoldedFamily.inputWord e r k i) →
        Lychrel196.step n =
            DecimalDigits.value (Agent13FoldedFamily.inputWord e r k) (2 * Agent13FoldedFamily.halfWidth r k) ∧
          ∃ d',
            DecimalDigits.Canonical (Lychrel196.step n) d' (2 * Agent13FoldedFamily.halfWidth r k) ∧
              ∀ (i : Nat),
                i < 2 * Agent13FoldedFamily.halfWidth r k →
                  DecimalDigits.columnSum d' (2 * Agent13FoldedFamily.halfWidth r k) i =
                    Agent13FoldedFamily.targetWord r k i
def Agent13FoldedFamily.WordSafe : Nat → (Nat → Nat) → Prop :=
fun L q => FoldedDecimal.Admissible L q ∧ ¬Lychrel196.Palindrome (DecimalDigits.value q L)
