SafeHighFamily.safe_three_returns_family (m : Nat) :
  0 < SafeHighFamily.seed m ∧
    (∀ (j : Fin 4), SafeHighWitness.high (SafeHighWitness.iterate (SafeHighFamily.seed m) (2 * ↑j)) = true) ∧
      ∀ (t : Fin 7), SafeHighWitness.palindrome (SafeHighWitness.iterate (SafeHighFamily.seed m) ↑t) = false
SafeHighFamily.seed_closed_form (m : Nat) : SafeHighFamily.seed m = 81 * 10 ^ (m + 7) - 1
SafeHighWitness.palindrome_at_eight : SafeHighWitness.palindrome (SafeHighWitness.orbit 8) = true
Agent105.ActualHighReturn.numeric_high_returns_after_le_three (n start R : Nat) (hn : 0 < n)
  (hH : ∀ (j : Nat), j ≤ R → Agent105.NumericHigh.NumericHigh (Lychrel196.orbit n (start + 2 * j))) : R ≤ 3
Agent105.ReturnSafety.numeric_two_outputs_safe_iff_large_adjacent (n : Nat) (d q : Nat → Nat) (L : Nat)
  (hc : DecimalDigits.Canonical n d L) (hrep : ∀ (i : Nat), i < L → DecimalDigits.columnSum d L i = q i)
  (hq : HighCarryReduction.HighCarryWord q L) :
  ¬Lychrel196.Palindrome (Lychrel196.step n) ∧ ¬Lychrel196.Palindrome (Lychrel196.orbit n 2) ↔
    ∃ i, 0 < i ∧ i < L ∧ 28 ≤ q (i - 1) + q i
Agent109.Compat.pairWord_orbit (n k : Nat) :
  Agent109.pairWord (Lychrel196.orbit n k) = Agent8.orbit (Agent109.pairWord n) k
Agent109.Compat.isLychrel_iff (n : Nat) :
  Lychrel196.IsLychrel n ↔
    ¬Lychrel196.Palindrome n ∧
      ∀ (k : Nat),
        List.reverse (Agent8.normalize (Agent8.orbit (Agent109.pairWord n) k) 0) ≠
          Agent8.normalize (Agent8.orbit (Agent109.pairWord n) k) 0
Agent109.Endpoints.no_two_step_actual_template_return (n c : Nat) (B A C : Agent109.Word) (g0 h0 g1 h1 : Nat)
  (hn : n ≠ 0) (hg0 : 0 < g0) (hg1 : 0 < g1) (hq : Agent109.pairWord n = Agent8.template c B A C g0 h0) :
  Agent109.pairWord (Lychrel196.orbit n 2) ≠ Agent8.template c B A C g1 h1
Agent109.Endpoints.no_repeatable_six_step_actual_template_return (n c : Nat) (B A C : Agent109.Word) (g0 h0 g1 h1 : Nat)
  (hn : n ≠ 0) (hc : Agent8.SixPhase c) (hg0 : 0 < g0) (hg : g0 ≤ g1) (hh : h0 ≤ h1)
  (hq : Agent109.pairWord n = Agent8.template c B A C g0 h0) :
  Agent109.pairWord (Lychrel196.orbit n 6) ≠ Agent8.template c B A C g1 h1
P196.Agent6.capTwo_uniform_escape (s : P196.Agent6.Exterior) (hs : P196.Agent6.Canonical s)
  (hlen : List.length s.word ≤ 2) : ∃ t, t ≤ 7 ∧ 2 < List.length (P196.Agent6.iterate t s).word
