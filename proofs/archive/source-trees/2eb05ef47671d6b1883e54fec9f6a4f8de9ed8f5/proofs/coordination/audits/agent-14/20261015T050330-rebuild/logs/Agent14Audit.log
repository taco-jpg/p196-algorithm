SafeHighFamily.ordinary_step {ds : List Nat} (h : SafeHighFamily.DecimalDigits ds) :
  SafeHighWitness.step (SafeHighFamily.value ds) =
    SafeHighFamily.value (SafeHighFamily.normalize (SafeHighFamily.pair ds) 0)
SafeHighFamily.digits10_value {ds : List Nat} (h : SafeHighFamily.DecimalDigits ds) :
  SafeHighWitness.digits10 (SafeHighFamily.value ds) = ds
SafeHighFamily.safe_three_returns_family (m : Nat) :
  0 < SafeHighFamily.seed m ∧
    (∀ (j : Fin 4), SafeHighWitness.high (SafeHighWitness.iterate (SafeHighFamily.seed m) (2 * ↑j)) = true) ∧
      ∀ (t : Fin 7), SafeHighWitness.palindrome (SafeHighWitness.iterate (SafeHighFamily.seed m) ↑t) = false
SafeHighFamily.seed_closed_form (m : Nat) : SafeHighFamily.seed m = 81 * 10 ^ (m + 7) - 1
SafeHighWitness.palindrome_at_eight : SafeHighWitness.palindrome (SafeHighWitness.orbit 8) = true
exit=0
