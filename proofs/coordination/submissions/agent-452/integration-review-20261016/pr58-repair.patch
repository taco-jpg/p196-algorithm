+/-- Finitely many failing candidates have a common finite failure bound. -/
+private theorem finite_failure_bound
+    {α : Type} (Safe : α → Nat → Prop) (K : List α) :
+    (∀ x, x ∈ K → ∃ t, ¬ Safe x t) →
+    ∃ M, ∀ x, x ∈ K → ∃ t, t ≤ M ∧ ¬ Safe x t := by
+  induction K with
+  | nil =>
+      intro _
+      refine ⟨0, ?_⟩
+      intro x hx
+      cases hx
+  | cons a K ih =>
+      intro hbad
+      obtain ⟨ta, ha⟩ := hbad a (List.mem_cons_self)
+      have htail : ∀ x, x ∈ K → ∃ t, ¬ Safe x t := by
+        intro x hx
+        exact hbad x (List.mem_cons_of_mem a hx)
+      obtain ⟨M, hM⟩ := ih htail
+      refine ⟨max ta M, ?_⟩
+      intro x hx
+      cases List.mem_cons.mp hx with
+      | inl h =>
+          subst x
+          exact ⟨ta, Nat.le_max_left ta M, ha⟩
+      | inr h =>
+          obtain ⟨t, ht, hfail⟩ := hM x h
+          exact ⟨t, Nat.le_trans ht (Nat.le_max_right ta M), hfail⟩
