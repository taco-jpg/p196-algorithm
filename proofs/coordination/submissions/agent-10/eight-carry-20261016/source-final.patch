+            for (int t = 0; t < 8; ++t) {
+                if (t) std::cout << ",\n";
+                frame_json(std::cout, examples[j][t], t);
+            }
+            std::cout << ']';
+        }
+        std::cout << "\n]\n}\n";
+        if (!std::cout) throw std::runtime_error("JSON output failure");
+    }
+};
+
+int main(int argc, char** argv) {
+    try {
+        if (argc != 3) throw std::runtime_error("usage: five_prefix_scan 3|4|5 SURVIVORS.csv");
+        if (std::string(argv[1]) == "3") { Scan<3> scan(argv[2]); scan.run(); }
+        else if (std::string(argv[1]) == "4") { Scan<4> scan(argv[2]); scan.run(); }
+        else if (std::string(argv[1]) == "5") { Scan<5> scan(argv[2]); scan.run(); }
+        else throw std::runtime_error("prefix length must be 3, 4, or 5");
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << "ERROR: " << e.what() << '\n';
+        return 1;
+    }
+}
