+bool admissible(const Word& q) {
+  if(q.empty() || q.front()==0)return false;
+  for(std::size_t i=0;i<q.size();++i) {
+    if(q[i]<0 || q[i]>18 || q[i]!=q[q.size()-1-i])return false;
+    if(i==q.size()-1-i && q[i]%2!=0)return false;
+  }
+  return true;
+}
+Word carries(const Word& q) {
+  Word c(q.size()+1,0);
+  for(std::size_t i=0;i<q.size();++i)c[i+1]=(q[i]+c[i])/10;
+  return c;
+}
+Word next_pairs(const Word& q,const Word& c) {
+  Word d;
+  for(std::size_t i=0;i<q.size();++i)d.push_back((q[i]+c[i])%10);
+  if(c.back())d.push_back(c.back());
+  Word result(d.size());
+  for(std::size_t i=0;i<d.size();++i)result[i]=d[i]+d[d.size()-1-i];
+  assert(admissible(result));
+  return result;
+}
