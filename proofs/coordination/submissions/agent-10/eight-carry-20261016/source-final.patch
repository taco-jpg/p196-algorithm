+#!/usr/bin/env python3
+"""Compile and run the small-output exact filtered width-17 lift."""
+from collections import Counter
+from datetime import datetime,timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+from replay_ordinary_integers import replay_pair
+
+HERE = Path(__file__).resolve().parent
+FIRST = HERE/'first_eight_collision.json'
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def announce_pair():
+    pair = json.loads(FIRST.read_text())
+    replay = replay_pair(pair,8)
+    target = HERE/'first_eight_integer_replay.json'
+    target.write_text(json.dumps(replay,indent=2)+'\n')
+    print(json.dumps({
+        'notice':'ACTUAL_EIGHT_WORD_MATCH_INDEPENDENTLY_REPLAYED',
+        'initial_pair_words':pair, 'initial_integers':replay['initial_integers'],
+        'next_integers':replay['next_integers'],
+        'first_mismatch_time':replay['first_mismatch_time'],
+        'first_mismatch_indices':replay['first_mismatch_indices'],
+        'trace_path':str(target),'trace_sha256':sha(target),
+    }),flush=True)
+
+
+def run_record(label,command,output,watch_collision=False):
+    started = time.monotonic()
+    announced = False
+    with (HERE/output).open('xb') as stdout,(HERE/(label+'.stderr.log')).open('xb') as stderr:
+        child = subprocess.Popen(command,cwd=HERE,stdout=stdout,stderr=stderr)
+        while True:
+            pid,status,usage = os.wait4(child.pid,os.WNOHANG)
+            if watch_collision and FIRST.exists() and not announced:
+                # The C++ writer closes this tiny file before flushing its notice.
+                # Wait for complete JSON if this poll overlaps that write.
+                try:
+                    announce_pair()
+                    announced = True
+                except json.JSONDecodeError:
+                    pass
+            if pid:
+                child.returncode = os.waitstatus_to_exitcode(status)
+                break
+            time.sleep(0.05)
+    if watch_collision and FIRST.exists() and not announced:
+        announce_pair()
+    record = {
+        'command':command,'cwd':str(HERE),'exit_code':child.returncode,
+        'elapsed_seconds':time.monotonic()-started,
+        'user_cpu_seconds':usage.ru_utime,'system_cpu_seconds':usage.ru_stime,
+        'peak_child_rss_kib':usage.ru_maxrss,
+        'stdout':output,'stderr':label+'.stderr.log',
+        'stdout_sha256':sha(HERE/output),'stderr_sha256':sha(HERE/(label+'.stderr.log')),
+    }
+    (HERE/(label+'.command.json')).write_text(json.dumps(record,indent=2)+'\n')
+    assert child.returncode == 0, record
+    return record
+
+
+assert sha(HERE/'survivors-5.csv') == '3b310524a4436c062eb66926dea3e78e6d15af7e4b9564ff6478fad5abe2bf3a'
