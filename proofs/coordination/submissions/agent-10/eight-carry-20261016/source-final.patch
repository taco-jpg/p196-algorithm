+            assert high == frame[f'high_{side}_with_inner_bit']
+            assert list(reference_module.next_state(state, bit)) == frame[f'next_{side}']
+            if t < 7:
+                assert frame[f'next_{side}'] == example[t+1][side]
+        assert frame['low_left_with_zero'] == frame['low_right_with_zero']
+        assert frame['high_left_with_inner_bit'] == frame['high_right_with_inner_bit']
+        assert frame['terminal_overflow'] == frame['high_left_with_inner_bit'][0]
