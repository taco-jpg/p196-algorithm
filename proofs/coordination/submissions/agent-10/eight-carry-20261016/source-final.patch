+                            if constexpr (K >= 5) left[2] = right[2] = a2;
+                            left[K-2] = b+1; right[K-2] = b;
+                            left[K-1] = c-3; right[K-1] = c;
+                            start(left, right);
+                        }
+                    }
+                }
+            }
+        }
