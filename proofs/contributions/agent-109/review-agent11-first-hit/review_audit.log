Agent11HighBase.numeric_interval_first_hit : ∀ (b : Int) (digits : List Int),
  3 ≤ b →
    ReverseAdd.DigitBounds b digits →
      PhysicalWidth.PositiveLast digits →
        (∀ (x : Int), x ∈ ReverseAdd.pairs digits → b - 1 ≤ x ∧ x ≤ b + (b - 1) / 2 - 1) →
          b ≤ (ReverseAdd.pairs digits).headD 0 →
            (∀ (t : Nat),
                ReverseAdd.DigitBounds b (Agent11HighBase.digitOrbit b digits t) ∧
                  PhysicalWidth.PositiveLast (Agent11HighBase.digitOrbit b digits t) ∧
                    0 < SignedDigitUniqueness.eval b (Agent11HighBase.digitOrbit b digits t) ∧
                      SignedDigitUniqueness.eval b (Agent11HighBase.digitOrbit b digits (t + 1)) =
                        SignedDigitUniqueness.eval b (Agent11HighBase.digitOrbit b digits t) +
                          SignedDigitUniqueness.eval b (Agent11HighBase.digitOrbit b digits t).reverse) ∧
              (Agent11HighBase.FirstPositivePalindrome b digits 1 ↔
                  ∀ (x : Int), x ∈ ReverseAdd.pairs digits → x = b + 1) ∧
                (Agent11HighBase.FirstPositivePalindrome b digits 2 ↔
                    ¬∀ (x : Int), x ∈ ReverseAdd.pairs digits → x = b + 1) ∧
                  (Agent11HighBase.FirstPositivePalindrome b digits 1 ∨
                    Agent11HighBase.FirstPositivePalindrome b digits 2)
def Agent11HighBase.FirstPositivePalindrome : Int → List Int → Nat → Prop :=
fun b digits t =>
  0 < t ∧
    (Agent11HighBase.digitOrbit b digits t).reverse = Agent11HighBase.digitOrbit b digits t ∧
      ∀ (s : Nat),
        0 < s → s < t → (Agent11HighBase.digitOrbit b digits s).reverse ≠ Agent11HighBase.digitOrbit b digits s
def Agent11HighBase.ordinaryStep : Int → List Int → List Int :=
fun b digits => Agent11HighBase.normalize b (ReverseAdd.pairs digits)
