Agent13SafeFamily.safe_predecessor_family : ∀ (m : Nat),
  2 ≤ m →
    ∃ f,
      (∀ (i j : Fin (9 * 10 ^ (m - 2))), f i = f j → i = j) ∧
        Agent13SafeFamily.Safe (10 ^ (2 * m) + 99 * 10 ^ (m - 1) - 1) ∧
          ∀ (i : Fin (9 * 10 ^ (m - 2))),
            Agent13SafeFamily.Safe (f i) ∧
              Lychrel196.step (f i) = 10 ^ (2 * m) + 99 * 10 ^ (m - 1) - 1 ∧
                f i < 10 ^ (2 * m) ∧ 10 ^ (2 * m) < 10 ^ (2 * m) + 99 * 10 ^ (m - 1) - 1
Agent13SafeFamily.safe_fibers_unbounded : ∀ (N : Nat),
  ∃ y,
    Agent13SafeFamily.Safe y ∧
      ∃ f,
        (∀ (i j : Fin N), f i = f j → i = j) ∧
          ∀ (i : Fin N), Agent13SafeFamily.Safe (f i) ∧ Lychrel196.step (f i) = y ∧ f i < y
Agent13SafeFamily.predecessor_complete : ∀ (r : Nat) (a : Nat → Nat),
  (∀ (i : Nat), i < r + 1 → a i ≤ 9) →
    0 < a r → ∃ j, Agent13SafeFamily.predecessor r j = Agent13SafeFamily.family a (r + 1)
def Agent13SafeFamily.Safe : Nat → Prop :=
fun n => 0 < n ∧ ¬Lychrel196.Palindrome n ∧ ¬Lychrel196.Palindrome (Lychrel196.step n)
