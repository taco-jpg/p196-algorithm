RunAncestry.orbit_ancestry_extinct : ∀ (n : Nat) (d : Nat → Nat) (L c a b : Nat),
  DecimalDigits.Canonical n d L →
    c = 0 ∨ c = 18 →
      RunAncestry.MaximalRun (DecimalDigits.columnSum d L) L c a b →
        (∀ (t : Nat),
            ∃ e,
              DecimalDigits.Canonical (Lychrel196.orbit n t) e
                  (OverflowCarryNormalization.iterPairs (DecimalDigits.columnSum d L) L t).fst ∧
                ∀ (i : Nat),
                  i < (OverflowCarryNormalization.iterPairs (DecimalDigits.columnSum d L) L t).fst →
                    DecimalDigits.columnSum e
                        (OverflowCarryNormalization.iterPairs (DecimalDigits.columnSum d L) L t).fst i =
                      (OverflowCarryNormalization.iterPairs (DecimalDigits.columnSum d L) L t).snd i) ∧
          (∀ (t : Nat),
              (RunAncestry.track (DecimalDigits.columnSum d L) L c a b t).fst <
                  (RunAncestry.track (DecimalDigits.columnSum d L) L c a b t).snd →
                RunAncestry.MaximalRun (OverflowCarryNormalization.iterPairs (DecimalDigits.columnSum d L) L t).snd
                    (OverflowCarryNormalization.iterPairs (DecimalDigits.columnSum d L) L t).fst c
                    (RunAncestry.track (DecimalDigits.columnSum d L) L c a b t).fst
                    (RunAncestry.track (DecimalDigits.columnSum d L) L c a b t).snd ∧
                  t +
                      DecimalWidthGrowth.lowerPotential
                        ((OverflowCarryNormalization.iterPairs (DecimalDigits.columnSum d L) L t).snd 0) ≤
                    4 * (b - a - 1) + DecimalWidthGrowth.lowerPotential (DecimalDigits.columnSum d L 0)) ∧
            ∀ (t : Nat),
              4 * (b - a) - 3 + DecimalWidthGrowth.lowerPotential (DecimalDigits.columnSum d L 0) ≤ t →
                (RunAncestry.track (DecimalDigits.columnSum d L) L c a b t).snd ≤
                  (RunAncestry.track (DecimalDigits.columnSum d L) L c a b t).fst
RunAncestry.extinct_after : ∀ (q : Nat → Nat) (L c a b t : Nat),
  FoldedDecimal.Admissible L q →
    c = 0 ∨ c = 18 →
      RunAncestry.MaximalRun q L c a b →
        4 * (b - a) - 3 + DecimalWidthGrowth.lowerPotential (q 0) ≤ t →
          (RunAncestry.track q L c a b t).snd ≤ (RunAncestry.track q L c a b t).fst
def RunAncestry.MaximalRun : (Nat → Nat) → Nat → Nat → Nat → Nat → Prop :=
fun q L c a b => a < b ∧ b ≤ L ∧ (∀ (i : Nat), a ≤ i → i < b → q i = c) ∧ (a = 0 ∨ q (a - 1) ≠ c) ∧ (b = L ∨ q b ≠ c)
