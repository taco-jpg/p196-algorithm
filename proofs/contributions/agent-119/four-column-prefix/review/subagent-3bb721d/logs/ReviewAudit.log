def FourColumnKernel.Starts3 : Nat → Nat → Nat → Nat → Prop :=
fun a b c P => ∃ e W, DecimalDigits.Canonical P e W ∧ 3 ≤ W ∧ e (W - 1) = a ∧ e (W - 2) = b ∧ e (W - 3) = c
def FourColumnKernel.PalindromeStarts3 : Nat → Nat → Nat → Nat → Prop :=
fun a b c P => Lychrel196.Palindrome P ∧ FourColumnKernel.Starts3 a b c P
def FourColumnKernel.Certificate.Starts2 : Nat → Nat → Nat → Prop :=
fun a b P => ∃ e W, DecimalDigits.Canonical P e W ∧ 2 ≤ W ∧ e (W - 1) = a ∧ e (W - 2) = b
def FourColumnKernel.GrowthPrefix : Nat → Nat → Nat → Prop :=
fun a b c => a = 1 ∧ (b = 1 ∧ c ≤ 1 ∨ b = 2 ∧ 1 ≤ c ∧ c ≤ 2)
def FourColumnKernel.rootWords : Nat → Nat → Nat → List (List Nat) :=
fun a b c => (if c = a ∧ b % 2 = 0 then [[a, b, a]] else []) ++ List.map (fun d => [a, b, c, d]) (List.range 10)
def FourColumnKernel.project4 : (Nat → Nat) → Nat → List Nat :=
fun q L => SevenColumnProjection.wordPrefix q (Min.min L 4)
def FourColumnKernel.ShortDescent : SevenColumn.Certificate.RankTree → Prop :=
fun tree => ∀ (s : List Nat), s ∈ FourColumnKernel.shortWords3 → FourColumnKernel.shortDescentOK tree s = Bool.true
def FourColumnKernel.shortDescentOK : SevenColumn.Certificate.RankTree → List Nat → Bool :=
fun tree s =>
  match SevenColumn.Certificate.lookup tree (SevenColumn.ShortBoundary.nextWord s) with
  | Option.none => Bool.true
  | Option.some r =>
    match SevenColumn.Certificate.lookup tree s with
    | Option.none => Bool.false
    | Option.some k => Decidable.decide (k < r)
def FourColumnKernel.shortWords3 : List (List Nat) :=
SevenColumn.ShortBoundary.rawWords 1 ++ SevenColumn.ShortBoundary.rawWords 2 ++ SevenColumn.ShortBoundary.rawWords 3
def FourColumnKernel.Certificate.entryOK : SevenColumn.Certificate.RankTree → Nat × Nat × Nat × Nat → Bool :=
fun tree x =>
  match x with
  | (a, b, c, B) =>
    !Decidable.decide (FourColumnKernel.GrowthPrefix a b c) && Decidable.decide (1 ≤ B) && Decidable.decide (B ≤ 100) &&
      (FourColumnKernel.rootWords a b c).all (SevenColumn.Certificate.checkInitial tree (B - 1))
def DecimalDigits.Canonical : Nat → (Nat → Nat) → Nat → Prop :=
fun n d L => 0 < L ∧ (∀ (i : Nat), i < L → d i ≤ 9) ∧ 0 < d (L - 1) ∧ DecimalDigits.value d L = n
def DecimalDigits.value : (Nat → Nat) → Nat → Nat :=
fun d x =>
  Nat.brecOn x fun x f =>
    (match (motive := (x : Nat) → Nat.below x → Nat) x with
      | 0 => fun x => 0
      | k.succ => fun x => x.1 + d k * 10 ^ k)
      f
def Lychrel196.orbit : Nat → Nat → Nat :=
fun n x =>
  Nat.brecOn x fun x f =>
    (match (motive := (x : Nat) → Nat.below x → Nat) x with
      | 0 => fun x => n
      | k.succ => fun x => Lychrel196.step x.1)
      f
def Lychrel196.step : Nat → Nat :=
fun n => n + Lychrel196.reverse10 n
def Lychrel196.Palindrome : Nat → Prop :=
fun n => Lychrel196.reverse10 n = n
def Lychrel196.reverse10 : Nat → Nat :=
fun n => Lychrel196.reverseFuel n n 0
def SevenColumn.Certificate.CheckedRows : SevenColumn.Certificate.RankTree →
  (SevenColumn.Certificate.Word → List SevenColumn.Certificate.Word) → Prop :=
fun tree pred =>
  SevenColumn.Certificate.RankTree.All (fun p r => SevenColumn.Certificate.checkRow tree pred p r = Bool.true) tree
def SevenColumn.Certificate.checkRow : SevenColumn.Certificate.RankTree →
  (SevenColumn.Certificate.Word → List SevenColumn.Certificate.Word) → SevenColumn.Certificate.Word → Nat → Bool :=
fun tree pred p r => (pred p).all (SevenColumn.Certificate.checkBelow tree r)
def SevenColumn.Certificate.checkInitial : SevenColumn.Certificate.RankTree →
  Nat → SevenColumn.Certificate.Word → Bool :=
fun tree bound p =>
  match SevenColumn.Certificate.lookup tree p with
  | Option.none => Bool.false
  | Option.some r => Decidable.decide (r ≤ bound)
def SevenColumn.Certificate.longPred : Nat → SevenColumn.Certificate.Word → List SevenColumn.Certificate.Word :=
fun width p => if List.length p = width then SevenColumn.prefixPredecessors p else []
def SevenColumn.Certificate.lookup : SevenColumn.Certificate.RankTree → SevenColumn.Certificate.Word → Option Nat :=
fun tree w => SevenColumn.Certificate.lookupKey tree (SevenColumn.Certificate.wordCode w) w
