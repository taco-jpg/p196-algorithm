Agent101.mem_rawWords (h : List Nat) (c : Option Nat) (ds : List Nat) :
  ds ∈ Agent101.rawWords h c ↔
    ds.length = (Agent101.coefficientWord h c).length ∧
      Agent101.digitsBounded ds ∧ Agent101.digitPairSums ds = Agent101.coefficientWord h c
Agent101.mem_canonicalWords (h : List Nat) (c : Option Nat) (ds : List Nat) :
  ds ∈ Agent101.canonicalWords h c ↔
    Agent101.canonicalDigits ds ∧ Agent101.digitPairSums ds = Agent101.coefficientWord h c
Agent101.canonicalWords_nodup (h : List Nat) (c : Option Nat) : (Agent101.canonicalWords h c).Nodup
Agent101.length_canonicalWords (h : List Nat) (c : Option Nat) :
  (Agent101.canonicalWords h c).length = Agent101.profileCount h c
Agent101.mem_numericFiber (h : List Nat) (c : Option Nat) (n : Nat)
  (hq : ∀ (s : Nat), s ∈ Agent101.coefficientWord h c → s ≤ 18) :
  n ∈ Agent101.numericFiber h c ↔
    Agent101.decimalWidth n (Agent101.coefficientWord h c).length ∧
      Lychrel196.step n = Agent101.natValue (Agent101.coefficientWord h c)
Agent101.numericFiber_nodup (h : List Nat) (c : Option Nat) : (Agent101.numericFiber h c).Nodup
Agent101.length_numericFiber (h : List Nat) (c : Option Nat) :
  (Agent101.numericFiber h c).length = Agent101.profileCount h c
Agent101.length_numericFiber_cons (s : Nat) (h : List Nat) (c : Option Nat) :
  (Agent101.numericFiber (s :: h) c).length =
    Agent101.pairCount true s * Agent101.centerCount c * Agent101.natProduct (List.map (Agent101.pairCount false) h)
Agent101.length_numericFiber_cons_le (s : Nat) (h : List Nat) (c : Option Nat) :
  (Agent101.numericFiber (s :: h) c).length ≤ 9 * 10 ^ h.length
Agent101.sharp_profile_bound (k : Nat) :
  (∀ (s : Nat) (h : List Nat) (c : Option Nat), h.length = k → Agent101.profileCount (s :: h) c ≤ 9 * 10 ^ k) ∧
    Agent101.profileCount (9 :: List.replicate k 9) none = 9 * 10 ^ k ∧
      Agent101.profileCount (9 :: List.replicate k 9) (some 0) = 9 * 10 ^ k
Agent101.all_preimages_887 (n : Nat) : Lychrel196.step n = 887 ↔ n ∈ [790, 691, 592, 493, 394, 295, 196]
