  "recovery_instructions": "Place this manifest and pr104-evidence.tar.xz in the same working directory. Run recovery_command; it verifies archive/member identities before recovering into a new pr104-restored directory. Reproducible exclusions remain listed in excluded_files.",
  "recovery_command": "python3 - <<'RECOVER'\nfrom pathlib import Path,PurePosixPath\nimport json,hashlib,tarfile\nm=json.loads(Path('pr104-package.json').read_text());a=Path(m['archive'])\nassert a.stat().st_size==m['archive_bytes']\nwith a.open('rb') as f:assert hashlib.file_digest(f,'sha256').hexdigest()==m['archive_sha256']\nout=Path('pr104-restored');out.mkdir(exist_ok=False)\nwith tarfile.open(a,'r:xz') as t:\n members=t.getmembers();names=[x.name for x in members]\n assert len(names)==len(set(names)) and set(names)==set(m['files'])\n for x in members:\n  p=PurePosixPath(x.name);assert x.isfile() and not p.is_absolute() and all(v not in ('..','.git','__pycache__') for v in p.parts)\n  b=t.extractfile(x).read();r=m['files'][x.name]\n  assert len(b)==r['bytes'] and hashlib.sha256(b).hexdigest()==r['sha256']\n  f=out/x.name;f.parent.mkdir(parents=True,exist_ok=True);f.write_bytes(b)\nfor name,r in m['files'].items():\n b=(out/name).read_bytes();assert len(b)==r['bytes'] and hashlib.sha256(b).hexdigest()==r['sha256']\nprint('PASS: all packaged PR104 evidence recovered byte-for-byte')\nRECOVER",
