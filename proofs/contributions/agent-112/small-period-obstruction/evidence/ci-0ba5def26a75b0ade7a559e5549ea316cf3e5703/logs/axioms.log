ENDPOINT|Agent112.SmallPeriod.two_phase_next|∀ (c : Nat),
  Agent112.SmallPeriod.TwoPhase c → Agent112.SmallPeriod.TwoPhase (Agent2Exterior.phase c)
ENDPOINT|Agent112.SmallPeriod.two_code_step|∀ (c : Nat),
  Agent112.SmallPeriod.TwoPhase c →
    Agent112.SmallPeriod.twoCode (Agent2Exterior.phase c) = (Agent112.SmallPeriod.twoCode c + 1) % 2
ENDPOINT|Agent112.SmallPeriod.valid_two_phase|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.Valid cert →
    Agent112.SmallPeriod.TwoPhase (cert.st 0).c → ∀ (i : Nat), i < cert.P → Agent112.SmallPeriod.TwoPhase (cert.st i).c
ENDPOINT|Agent112.SmallPeriod.parity_telescope|∀ (r : Nat → Nat) (n : Nat),
  (∀ (i : Nat), i < n → r (i + 1) % 2 = (r i + 1) % 2) → r n % 2 = (r 0 + n) % 2
ENDPOINT|Agent112.SmallPeriod.valid_two_period_even|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.Valid cert → Agent112.SmallPeriod.TwoPhase (cert.st 0).c → cert.P % 2 = 0
ENDPOINT|Agent112.SmallPeriod.checked_positive_exterior|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = true → 0 < Agent110.CarryBudget.exterior (cert.st 0)
ENDPOINT|Agent112.SmallPeriod.checked_saturated_period_mod8|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = true → 2 * Agent110.Accounting.totalGam cert = ↑cert.P → cert.P % 8 = 0
ENDPOINT|Agent112.SmallPeriod.checked_period_ne_four|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = true → cert.P ≠ 4
ENDPOINT|Agent112.SmallPeriod.valid_phase_class|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.Valid cert → Agent2Exterior.SixPhase (cert.st 0).c ∨ Agent112.SmallPeriod.TwoPhase (cert.st 0).c
ENDPOINT|Agent112.SmallPeriod.period_six_overflow_mod3|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.Valid cert →
    cert.P = 6 → Agent112.SmallPeriod.TwoPhase (cert.st 0).c → Agent110.Accounting.totalGam cert % 3 = 0
ENDPOINT|Agent112.SmallPeriod.checked_period_ne_six|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = true → cert.P ≠ 6
ENDPOINT|Agent112.SmallPeriod.checked_period_even|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = true → cert.P % 2 = 0
ENDPOINT|Agent112.SmallPeriod.checked_period_at_least_eight|∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = true → 8 ≤ cert.P
ENDPOINT|Agent112.SmallPeriod.Controls.eight_relaxation|Agent112.SmallPeriod.Controls.Relaxation 8
  Agent112.SmallPeriod.Controls.eightState Agent112.SmallPeriod.Controls.eightInput
  Agent112.SmallPeriod.Controls.phaseAt Agent112.SmallPeriod.Controls.eightCharge
ENDPOINT|Agent112.SmallPeriod.Controls.ten_relaxation|Agent112.SmallPeriod.Controls.Relaxation 10
  Agent112.SmallPeriod.Controls.tenState Agent112.SmallPeriod.Controls.tenInput Agent112.SmallPeriod.Controls.phaseAt
  Agent112.SmallPeriod.Controls.tenCharge
ENDPOINT|Agent112.SmallPeriod.Controls.no_relaxation_period_twelve|¬∀ (p : Nat)
    (s : Nat → P196.Agent4.Saturation.Prefix) (e c : Nat → Nat) (q : Nat → Int),
    Agent112.SmallPeriod.Controls.Relaxation p s e c q → 12 ≤ p
