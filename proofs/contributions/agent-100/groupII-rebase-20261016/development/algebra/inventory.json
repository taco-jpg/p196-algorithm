      "name": "Agent100.GroupIIRebase.rebase_delta_overlap",
      "line": 31,
      "statement": "theorem rebase_delta_overlap (r i : Nat) (hr : 1 \u2264 r) :\n    rebaseDelta r i + previous (rebaseDelta r) i = overflowDefect r i"
    },
    {
      "kind": "theorem",
      "name": "Agent100.GroupIIRebase.rebasedInt_actual_component",
      "line": 41,
      "statement": "theorem rebasedInt_actual_component (r p u v : Nat) (h : UpperDomain r p u v)\n    (i : Nat) :\n    rebasedInt r p u v i =\n      (finiteWord (componentOrbit r p u v 2).1\n        (componentOrbit r p u v 2).2 i : Int) + rebaseDelta r i"
    },
    {
      "kind": "theorem",
      "name": "Agent100.GroupIIRebase.rebasedInt_overlap",
      "line": 51,
      "statement": "theorem rebasedInt_overlap (r p u v i : Nat) (hr : 1 \u2264 r) :\n    rebasedInt r p u v i + previous (rebasedInt r p u v) i =\n      (shiftOne (finiteNextComponent r p u v) i : Int) + overflowDefect r i"
    },
    {
      "kind": "theorem",
      "name": "Agent100.GroupIIRebase.finite_whole_rebasedInt",
      "line": 65,
      "statement": "theorem finite_whole_rebasedInt (r p u v : Nat) (h : UpperDomain r p u v) :\n    \u2200 i, i < 2 * r + 8 \u2192\n      (nextColumns (GroupII.middle r p u v) (2 * r + 7) i : Int) =\n        rebasedInt r p u v i + previous (rebasedInt r p u v) i"
    },
    {
      "kind": "theorem",
      "name": "Agent100.GroupIIRebase.actual_whole_rebasedInt",
      "line": 76,
      "statement": "theorem actual_whole_rebasedInt (r p u v : Nat) (h : UpperDomain r p u v) :\n    \u2200 i, i < 2 * r + 8 \u2192\n      ((wholeOrbit r p u v 2).2 i : Int) =\n        rebasedInt r p u v i + previous (rebasedInt r p u v) i"
    }
