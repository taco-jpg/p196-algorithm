Agent5.ExactDigitStreams.adicNumeratorDigits_length (n : Nat) (a : Int) :
  (Agent5.ExactDigitStreams.adicNumeratorDigits n a).length = n
Agent5.ExactDigitStreams.fractionDigits_length (n r D : Nat) :
  (Agent5.ExactDigitStreams.fractionDigits n r D).length = n
Agent5.ExactDigitStreams.adicNumeratorDigits_bounded (n : Nat) (a : Int) (d : Nat) :
  d ∈ Agent5.ExactDigitStreams.adicNumeratorDigits n a → d ≤ 9
Agent5.ExactDigitStreams.adicNumeratorDigits_prefix (n m : Nat) (a : Int) :
  List.take n (Agent5.ExactDigitStreams.adicNumeratorDigits (n + m) a) =
    Agent5.ExactDigitStreams.adicNumeratorDigits n a
Agent5.ExactDigitStreams.adicNumeratorDigits_column (n x : Nat) (z : Int) :
  Agent5.ExactDigitStreams.adicNumeratorDigits (n + 1) (9 * ↑x + 10 * z) =
    x % 10 :: Agent5.ExactDigitStreams.adicNumeratorDigits n (9 * ↑(x / 10) + z)
Agent5.ExactDigitStreams.adicNumeratorDigits_constant (n t : Nat) (ht : t < 10) :
  Agent5.ExactDigitStreams.adicNumeratorDigits n (-↑t) = List.replicate n t
Agent5.ExactDigitStreams.adicNumeratorDigits_normalize (B : List Nat) (e q : Nat) (c : Int) :
  Agent5.ExactDigitStreams.adicNumeratorDigits (B.length + q)
      (9 * ↑(Agent115.ExteriorFactorization.lowValue B + e) - c * 10 ^ B.length) =
    (P196.Agent7.Finite.normalize B e).fst ++
      Agent5.ExactDigitStreams.adicNumeratorDigits q (9 * ↑(P196.Agent7.Finite.normalize B e).snd - c)
Agent5.ExactDigitStreams.adicNumeratorDigits_phase (c e q : Nat) (hc : Agent115.ExteriorFactorization.nonneutralPhase c)
  (he : e ≤ 1) :
  Agent5.ExactDigitStreams.adicNumeratorDigits (q + 1) (9 * ↑e - ↑c) =
    (c + e - 10 * if 10 ≤ c then 1 else 0) :: List.replicate q (c - 9 * if 10 ≤ c then 1 else 0)
Agent5.ExactDigitStreams.adicNumeratorDigits_exterior (c : Nat) (B : List Nat) (q : Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) (hB : ∀ (x : Nat), x ∈ B → x ≤ 18) :
  Agent5.ExactDigitStreams.adicNumeratorDigits (B.length + 1 + q) (Agent115.ExteriorFactorization.zValue c B - ↑c) =
    (P196.Agent7.Finite.normalize B 0).fst ++
        [c + (P196.Agent7.Finite.normalize B 0).snd - 10 * if 10 ≤ c then 1 else 0] ++
      List.replicate q (c - 9 * if 10 ≤ c then 1 else 0)
Agent5.ExactDigitStreams.fractionDigits_scale (n r D s : Nat) (hs : 0 < s) :
  Agent5.ExactDigitStreams.fractionDigits n (s * r) (s * D) = Agent5.ExactDigitStreams.fractionDigits n r D
Agent5.ExactDigitStreams.fractionDigits_repeat (q t : Nat) (ht : t < 9) :
  Agent5.ExactDigitStreams.fractionDigits q t 9 = List.replicate q t
Agent5.ExactDigitStreams.highValue_cons_digit (x : Nat) (xs : List Nat) :
  Agent115.ExteriorFactorization.highValue (x :: xs) = x * 10 ^ xs.length + Agent115.ExteriorFactorization.highValue xs
Agent5.ExactDigitStreams.highValue_lt_pow (W : List Nat) (hW : ∀ (x : Nat), x ∈ W → x < 10) :
  Agent115.ExteriorFactorization.highValue W < 10 ^ W.length
Agent5.ExactDigitStreams.fractionDigits_of_highValue (W : List Nat) (t q : Nat) (hW : ∀ (x : Nat), x ∈ W → x < 10)
  (ht : t < 9) :
  Agent5.ExactDigitStreams.fractionDigits (W.length + q) (9 * Agent115.ExteriorFactorization.highValue W + t)
      (9 * 10 ^ W.length) =
    W ++ List.replicate q t
Agent5.ExactDigitStreams.normalize_value_conservation (B : List Nat) (carry : Nat) :
  Agent115.ExteriorFactorization.lowValue (P196.Agent7.Finite.normalize B carry).fst +
      10 ^ B.length * (P196.Agent7.Finite.normalize B carry).snd =
    Agent115.ExteriorFactorization.lowValue B + carry
Agent5.ExactDigitStreams.normalize_digits_lt_ten (B : List Nat) (carry x : Nat) :
  x ∈ (P196.Agent7.Finite.normalize B carry).fst → x < 10
Agent5.ExactDigitStreams.highValue_reverse_word (W : List Nat) :
  Agent115.ExteriorFactorization.highValue W.reverse = Agent115.ExteriorFactorization.lowValue W
Agent5.ExactDigitStreams.phase_tail_digit (c : Nat) (hc : Agent115.ExteriorFactorization.nonneutralPhase c) :
  c = (9 * if 10 ≤ c then 1 else 0) + (c - 9 * if 10 ≤ c then 1 else 0) ∧ (c - 9 * if 10 ≤ c then 1 else 0) < 9
Agent5.ExactDigitStreams.fractionDigits_exterior (c : Nat) (B : List Nat) (q : Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) (hB : ∀ (x : Nat), x ∈ B → x ≤ 18) :
  let k := if 10 ≤ c then 1 else 0;
  let t := c - 9 * k;
  let g := (P196.Agent7.Finite.normalize B.reverse k).snd;
  Agent5.ExactDigitStreams.fractionDigits (B.length + 1 + q) (Agent115.ExteriorFactorization.rhoNum c B)
      (9 * 10 ^ B.length * 10 ^ g) =
    (if (g == 0) = true then (P196.Agent7.Finite.normalize B.reverse k).fst.reverse ++ [t]
      else [1] ++ (P196.Agent7.Finite.normalize B.reverse k).fst.reverse) ++
      List.replicate q t
Agent5.ExactDigitStreams.fractionDigits_prefix (n q r D : Nat) :
  List.take n (Agent5.ExactDigitStreams.fractionDigits (n + q) r D) = Agent5.ExactDigitStreams.fractionDigits n r D
Agent5.ExactDigitStreams.fractionDigits_digits_lt_ten (n r D : Nat) (hr : r < D) (d : Nat) :
  d ∈ Agent5.ExactDigitStreams.fractionDigits n r D → d < 10
Agent5.ExactDigitStreams.fractionDigits_exterior_digits_lt_ten (c : Nat) (B : List Nat) (n : Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) (hB : ∀ (x : Nat), x ∈ B → x ≤ 18) :
  let k := if 10 ≤ c then 1 else 0;
  let g := (P196.Agent7.Finite.normalize B.reverse k).snd;
  ∀ (d : Nat),
    d ∈
        Agent5.ExactDigitStreams.fractionDigits n (Agent115.ExteriorFactorization.rhoNum c B)
          (9 * 10 ^ B.length * 10 ^ g) →
      d < 10
Agent5.ExactDigitStreams.strip_zip_append_replicate (a b : List Nat) (t q : Nat) (hlen : a.length = b.length) :
  P196.Agent7.Finite.stripSuffix (2 * t)
      (List.zipWith (fun x y => x + y) (a ++ List.replicate q t) (b ++ List.replicate q t)) =
    P196.Agent7.Finite.stripSuffix (2 * t) (List.zipWith (fun x y => x + y) a b)
Agent5.ExactDigitStreams.outerNext_from_streams (c : Nat) (B : List Nat) (q : Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) (hB : ∀ (x : Nat), x ∈ B → x ≤ 18) :
  P196.Agent7.Finite.outerNext { c := c, B := B } =
    { c := P196.Agent7.Finite.bulkPhase c,
      B :=
        P196.Agent7.Finite.stripSuffix (P196.Agent7.Finite.bulkPhase c)
          (List.zipWith (fun x y => x + y)
            (Agent5.ExactDigitStreams.adicNumeratorDigits (B.length + 1 + q)
              (Agent115.ExteriorFactorization.zValue c B - ↑c))
            (Agent5.ExactDigitStreams.fractionDigits (B.length + 1 + q) (Agent115.ExteriorFactorization.rhoNum c B)
              (9 * 10 ^ B.length * 10 ^ (P196.Agent7.Finite.normalize B.reverse (if 10 ≤ c then 1 else 0)).snd))) }
Agent5.ExactDigitStreams.outerNext_from_streams_of_cutoff (c : Nat) (B : List Nat) (cut : Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) (hB : ∀ (x : Nat), x ∈ B → x ≤ 18)
  (hcut : B.length + 1 ≤ cut) :
  P196.Agent7.Finite.outerNext { c := c, B := B } =
    { c := P196.Agent7.Finite.bulkPhase c,
      B :=
        P196.Agent7.Finite.stripSuffix (P196.Agent7.Finite.bulkPhase c)
          (List.zipWith (fun x y => x + y)
            (Agent5.ExactDigitStreams.adicNumeratorDigits cut (Agent115.ExteriorFactorization.zValue c B - ↑c))
            (Agent5.ExactDigitStreams.fractionDigits cut (Agent115.ExteriorFactorization.rhoNum c B)
              (9 * 10 ^ B.length * 10 ^ (P196.Agent7.Finite.normalize B.reverse (if 10 ≤ c then 1 else 0)).snd))) }
Agent5.ExactDigitStreams.nonneutralPhase_coordinate_bounds (c : Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) : c ≤ 17 ∧ c ≠ 9
Agent5.ExactDigitStreams.overflow_eq_coordinate_selector (c : Nat) (B : List Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) (hB : ∀ (x : Nat), x ∈ B → x ≤ 18) :
  (P196.Agent7.Finite.normalize B.reverse (if 10 ≤ c then 1 else 0)).snd =
    if 9 * 10 ^ B.length ≤ Agent115.ExteriorFactorization.rhoNum c B then 1 else 0
Agent5.ExactDigitStreams.outerNext_from_coordinates (c : Nat) (B : List Nat) (cut : Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) (hB : ∀ (x : Nat), x ∈ B → x ≤ 18)
  (hcut : B.length + 1 ≤ cut) :
  P196.Agent7.Finite.outerNext { c := c, B := B } =
    { c := P196.Agent7.Finite.bulkPhase c,
      B :=
        P196.Agent7.Finite.stripSuffix (P196.Agent7.Finite.bulkPhase c)
          (List.zipWith (fun x y => x + y)
            (Agent5.ExactDigitStreams.adicNumeratorDigits cut (Agent115.ExteriorFactorization.zValue c B - ↑c))
            (Agent5.ExactDigitStreams.fractionDigits cut (Agent115.ExteriorFactorization.rhoNum c B)
              (9 * 10 ^ B.length *
                10 ^ if 9 * 10 ^ B.length ≤ Agent115.ExteriorFactorization.rhoNum c B then 1 else 0))) }
Agent5.ExactDigitStreams.outerNext_from_coordinates_quotient (c : Nat) (B : List Nat) (cut : Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) (hB : ∀ (x : Nat), x ∈ B → x ≤ 18)
  (hcut : B.length + 1 ≤ cut) :
  P196.Agent7.Finite.outerNext { c := c, B := B } =
    { c := P196.Agent7.Finite.bulkPhase c,
      B :=
        P196.Agent7.Finite.stripSuffix (P196.Agent7.Finite.bulkPhase c)
          (List.zipWith (fun x y => x + y)
            (Agent5.ExactDigitStreams.adicNumeratorDigits cut (Agent115.ExteriorFactorization.zValue c B - ↑c))
            (Agent5.ExactDigitStreams.fractionDigits cut (Agent115.ExteriorFactorization.rhoNum c B)
              (9 * 10 ^ B.length * 10 ^ (Agent115.ExteriorFactorization.rhoNum c B / (9 * 10 ^ B.length))))) }
Agent5.ExactDigitStreams.fractionDigits_coordinates_digits_lt_ten (c : Nat) (B : List Nat) (n : Nat)
  (hc : Agent115.ExteriorFactorization.nonneutralPhase c) (hB : ∀ (x : Nat), x ∈ B → x ≤ 18) (x : Nat) :
  x ∈
      Agent5.ExactDigitStreams.fractionDigits n (Agent115.ExteriorFactorization.rhoNum c B)
        (9 * 10 ^ B.length * 10 ^ if 9 * 10 ^ B.length ≤ Agent115.ExteriorFactorization.rhoNum c B then 1 else 0) →
    x < 10
