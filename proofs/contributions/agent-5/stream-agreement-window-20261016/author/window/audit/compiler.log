Agent5.OrdinaryStreamWindow.take_prefix_replicate (L M : List Nat) (t m q : Nat) (hq : q ≤ m) :
  List.take (L.length + q) (L ++ List.replicate m t ++ M) = L ++ List.replicate q t
Agent5.OrdinaryStreamWindow.paired_bands_window (L M R : List Nat) (t e gap q : Nat) (he : e ≤ 1)
  (hlen : L.length = R.length + 1) (hq : q ≤ gap + e) :
  List.take (R.length + 1 + q)
      (P196.Agent6.paired
        (L ++ List.replicate (gap + 1) t ++ M ++ List.replicate (gap + 1) t ++ R ++ P196.Agent6.carryEnd e)) =
    List.zipWith Nat.add (L ++ List.replicate q t)
      ((if (e == 0) = true then R.reverse ++ [t] else 1 :: R.reverse) ++ List.replicate q t)
