'FoldedDecimal.even_folded_trace_sound' depends on axioms: [propext, Quot.sound]
'FoldedDecimal.odd_folded_trace_sound' depends on axioms: [propext, Quot.sound]
'FoldedDecimal.folded_emission_no_overflow' depends on axioms: [propext]
'FoldedDecimal.folded_emission_overflow' depends on axioms: [propext]
'FoldedDecimal.folded_delay_update' depends on axioms: [propext, Quot.sound]
'FoldedDecimal.representation_next' depends on axioms: [propext, Quot.sound]
'FoldedDecimal.valid_word_realizable' depends on axioms: [propext, Quot.sound]
theorem FoldedDecimal.even_folded_trace_sound : ∀ (q a b : Nat → Nat) (k : Nat),
  (∀ (j : Nat), j < 2 * k → q j = q (2 * k - 1 - j)) →
    a 0 = 0 →
      (∀ (i : Nat), i < k → a (i + 1) = (q i + a i) / 10) →
        (∀ (i : Nat), i < k → b i = (q i + b (i + 1)) / 10) →
          a k = b k →
            (∀ (i : Nat), i ≤ k → a i = DecimalDigits.carry q i) ∧
              (∀ (i : Nat), i ≤ k → b i = DecimalDigits.carry q (2 * k - i)) ∧ b 0 = DecimalDigits.carry q (2 * k) :=
fun q a b k hs hzero hlow hhigh hcenter =>
  let_fun ha := FoldedDecimal.forward_trace_unique q a k hzero hlow;
  let_fun hmid :=
    Eq.mpr (id (congrArg (fun _a => _a = DecimalDigits.carry q (2 * k - k)) (Eq.symm hcenter)))
      (Eq.mpr (id (congrArg (fun _a => _a = DecimalDigits.carry q (2 * k - k)) (ha k (Nat.le_refl k))))
        ((fun q q_1 e_q =>
            Eq.rec (motive := fun q_2 e_q =>
              ∀ (a a_1 : Nat), a = a_1 → DecimalDigits.carry q a = DecimalDigits.carry q_2 a_1)
              (fun a a_1 e_a => e_a ▸ Eq.refl (DecimalDigits.carry q a)) e_q)
          q q (Eq.refl q) k (2 * k - k)
          (Decidable.byContradiction fun a_1 => FoldedDecimal.even_folded_trace_sound._proof_138 a b k a_1)));
  let_fun hb :=
    FoldedDecimal.backward_trace_unique q b (2 * k) k
      (Decidable.byContradiction fun a_1 => FoldedDecimal.even_folded_trace_sound._proof_139 q a b k a_1) hs hhigh hmid;
  ⟨ha, ⟨hb, hb 0 (Decidable.byContradiction fun a_1 => FoldedDecimal.even_folded_trace_sound._proof_140 q a b k a_1)⟩⟩
theorem FoldedDecimal.odd_folded_trace_sound : ∀ (q a b : Nat → Nat) (k : Nat),
  (∀ (j : Nat), j < 2 * k + 1 → q j = q (2 * k + 1 - 1 - j)) →
    a 0 = 0 →
      (∀ (i : Nat), i < k → a (i + 1) = (q i + a i) / 10) →
        (∀ (i : Nat), i < k → b i = (q i + b (i + 1)) / 10) →
          b k = (q k + a k) / 10 →
            (∀ (i : Nat), i ≤ k → a i = DecimalDigits.carry q i) ∧
              (∀ (i : Nat), i ≤ k → b i = DecimalDigits.carry q (2 * k + 1 - i)) ∧
                b 0 = DecimalDigits.carry q (2 * k + 1) :=
fun q a b k hs hzero hlow hhigh hcenter =>
  let_fun ha := FoldedDecimal.forward_trace_unique q a k hzero hlow;
  let_fun hind := Decidable.byContradiction fun a_1 => FoldedDecimal.odd_folded_trace_sound._proof_141 q a b k a_1;
  let_fun hmid :=
    Eq.mpr (id (congrArg (fun _a => _a = DecimalDigits.carry q (2 * k + 1 - k)) hcenter))
      (Eq.mpr (id (congrArg (fun _a => (q k + _a) / 10 = DecimalDigits.carry q (2 * k + 1 - k)) (ha k (Nat.le_refl k))))
        (Eq.mpr (id (congrArg (fun _a => (q k + DecimalDigits.carry q k) / 10 = DecimalDigits.carry q _a) hind))
          (Eq.mpr (id (congrArg (fun _a => (q k + DecimalDigits.carry q k) / 10 = _a) (DecimalDigits.carry.eq_2 q k)))
            (Eq.refl ((q k + DecimalDigits.carry q k) / 10)))));
  let_fun hb :=
    FoldedDecimal.backward_trace_unique q b (2 * k + 1) k
      (Decidable.byContradiction fun a_1 => FoldedDecimal.odd_folded_trace_sound._proof_142 q a b k a_1) hs hhigh hmid;
  ⟨ha, ⟨hb, hb 0 (Decidable.byContradiction fun a_1 => FoldedDecimal.even_folded_trace_sound._proof_140 q a b k a_1)⟩⟩
theorem FoldedDecimal.folded_emission_no_overflow : ∀ (q : Nat → Nat) (L i : Nat),
  i < L →
    (∀ (j : Nat), j < L → q j = q (L - 1 - j)) →
      DecimalDigits.carry q L = 0 →
        FoldedDecimal.nextColumns q L i =
          (q i + DecimalDigits.carry q i) % 10 + (q i + DecimalDigits.carry q (L - 1 - i)) % 10 :=
fun q L i hi hs hc =>
  Eq.mpr
    (id
      (congrArg (fun x => x = (q i + DecimalDigits.carry q i) % 10 + (q i + DecimalDigits.carry q (L - 1 - i)) % 10)
        (ite_congr (Eq.trans (congrArg (fun x => x = 0) hc) (eq_self 0))
          (fun a =>
            Eq.refl ((q i + DecimalDigits.carry q i) % 10 + (q (L - 1 - i) + DecimalDigits.carry q (L - 1 - i)) % 10))
          fun a => Eq.refl (DecimalDigits.extended q L i + DecimalDigits.extended q L (L + 1 - 1 - i)))))
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            (q i + DecimalDigits.carry q i) % 10 + (_a + DecimalDigits.carry q (L - 1 - i)) % 10 =
              (q i + DecimalDigits.carry q i) % 10 + (q i + DecimalDigits.carry q (L - 1 - i)) % 10)
          (Eq.symm (hs i hi))))
      (Eq.refl ((q i + DecimalDigits.carry q i) % 10 + (q i + DecimalDigits.carry q (L - 1 - i)) % 10)))
theorem FoldedDecimal.folded_emission_overflow : ∀ (q : Nat → Nat) (L i : Nat),
  i < L →
    DecimalDigits.carry q L = 1 →
      FoldedDecimal.nextColumns q L i = (q i + DecimalDigits.carry q i) % 10 + DecimalDigits.extended q L (L - i) :=
fun q L i hi hc =>
  of_eq_true
    (Eq.trans
      (congr
        (congrArg Eq
          (Eq.trans
            (ite_congr (Eq.trans (congrArg (fun x => x = 0) hc) _proof_112✝)
              (fun a =>
                Eq.refl
                  ((q i + DecimalDigits.carry q i) % 10 + (q (L - 1 - i) + DecimalDigits.carry q (L - 1 - i)) % 10))
              fun a =>
              congr
                (congrArg HAdd.hAdd
                  (Eq.trans
                    (ite_congr (eq_true hi) (fun a => Eq.refl ((q i + DecimalDigits.carry q i) % 10)) fun a => hc)
                    (if_pos (of_eq_true (Eq.refl True)))))
                (ite_congr (congrArg (fun x => x - i < L) (Nat.add_sub_cancel L 1))
                  (fun a =>
                    congrArg (fun x => x % 10)
                      (congr (congrArg (fun x => HAdd.hAdd (q (x - i))) (Nat.add_sub_cancel L 1))
                        (congrArg (fun x => DecimalDigits.carry q (x - i)) (Nat.add_sub_cancel L 1))))
                  fun a => hc))
            (if_false ((q i + DecimalDigits.carry q i) % 10 + (q (L - 1 - i) + DecimalDigits.carry q (L - 1 - i)) % 10)
              ((q i + DecimalDigits.carry q i) % 10 +
                if L - i < L then (q (L - i) + DecimalDigits.carry q (L - i)) % 10 else 1))))
        (congrArg (HAdd.hAdd ((q i + DecimalDigits.carry q i) % 10))
          (ite_congr (Eq.refl (L - i < L)) (fun a => Eq.refl ((q (L - i) + DecimalDigits.carry q (L - i)) % 10))
            fun a => hc)))
      (eq_self
        ((q i + DecimalDigits.carry q i) % 10 +
          if L - i < L then (q (L - i) + DecimalDigits.carry q (L - i)) % 10 else 1)))
theorem FoldedDecimal.folded_delay_update : ∀ (q : Nat → Nat) (L i : Nat),
  i < L →
    (∀ (j : Nat), j < L → q j = q (L - 1 - j)) →
      DecimalDigits.extended q L (L - (i + 1)) = (q i + DecimalDigits.carry q (L - 1 - i)) % 10 :=
fun q L i hi hs =>
  let_fun hind := Decidable.byContradiction fun a => FoldedDecimal.folded_delay_update._proof_118 L i hi a;
  let_fun hm := Decidable.byContradiction fun a => FoldedDecimal.folded_delay_update._proof_119 L i hi a;
  Eq.mpr (id (congrArg (fun _a => DecimalDigits.extended q L _a = (q i + DecimalDigits.carry q (L - 1 - i)) % 10) hind))
    (of_eq_true
      (Eq.trans
        (congrArg (fun x => x = (q i + DecimalDigits.carry q (L - 1 - i)) % 10)
          (Eq.trans
            (ite_congr (eq_true hm)
              (fun a => congrArg (fun x => (x + DecimalDigits.carry q (L - 1 - i)) % 10) (Eq.symm (hs i hi))) fun a =>
              Eq.refl (DecimalDigits.carry q L))
            (if_pos (of_eq_true (Eq.refl True)))))
        (eq_self ((q i + DecimalDigits.carry q (L - 1 - i)) % 10))))
theorem FoldedDecimal.representation_next : ∀ (n : Nat) (d q : Nat → Nat) (L : Nat),
  DecimalDigits.Canonical n d L →
    (∀ (i : Nat), i < L → DecimalDigits.columnSum d L i = q i) →
      ∃ e,
        DecimalDigits.Canonical (Lychrel196.step n) e (FoldedDecimal.nextWidth q L) ∧
          ∀ (i : Nat),
            i < FoldedDecimal.nextWidth q L →
              DecimalDigits.columnSum e (FoldedDecimal.nextWidth q L) i = FoldedDecimal.nextColumns q L i :=
fun n d q L hcan hrep =>
  let_fun hcarry := FoldedDecimal.carry_congr_upto (DecimalDigits.columnSum d L) q L hrep L (Nat.le_refl L);
  Or.casesOn (FoldedDecimal.actual_overflow_cases d L hcan.right.left)
    (fun hc =>
      let_fun hq := Eq.trans (Eq.symm hcarry) hc;
      let_fun hw :=
        of_eq_true
          (Eq.trans
            (congrArg (fun x => x = L)
              (ite_cond_eq_true L (L + 1) (Eq.trans (congrArg (fun x => x = 0) hq) (eq_self 0))))
            (eq_self L));
      Eq.mpr
        (id
          (congrArg
            (fun _a =>
              ∃ e,
                DecimalDigits.Canonical (Lychrel196.step n) e _a ∧
                  ∀ (i : Nat), i < _a → DecimalDigits.columnSum e _a i = FoldedDecimal.nextColumns q L i)
            hw))
        (Exists.intro (DecimalDigits.output (DecimalDigits.columnSum d L))
          ⟨FoldedDecimal.canonical_next_no_overflow n d L hcan hc, fun i hi =>
            let_fun hm := Decidable.byContradiction fun a => FoldedDecimal.representation_next._proof_159 d q L i hi a;
            Eq.mpr
              (id
                (congrArg
                  (Eq
                    (DecimalDigits.output (DecimalDigits.columnSum d L) i +
                      DecimalDigits.output (DecimalDigits.columnSum d L) (L - 1 - i)))
                  (ite_congr (Eq.trans (congrArg (fun x => x = 0) hq) (eq_self 0))
                    (fun a => Eq.refl (DecimalDigits.output q i + DecimalDigits.output q (L - 1 - i))) fun a =>
                    Eq.refl (DecimalDigits.extended q L i + DecimalDigits.extended q L (L + 1 - 1 - i)))))
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      _a + DecimalDigits.output (DecimalDigits.columnSum d L) (L - 1 - i) =
                        DecimalDigits.output q i + DecimalDigits.output q (L - 1 - i))
                    (FoldedDecimal.output_congr_upto (DecimalDigits.columnSum d L) q L hrep i hi)))
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        DecimalDigits.output q i + _a = DecimalDigits.output q i + DecimalDigits.output q (L - 1 - i))
                      (FoldedDecimal.output_congr_upto (DecimalDigits.columnSum d L) q L hrep (L - 1 - i) hm)))
                  (Eq.refl (DecimalDigits.output q i + DecimalDigits.output q (L - 1 - i)))))⟩))
    fun hc =>
    let_fun hq := Eq.trans (Eq.symm hcarry) hc;
    let_fun hw :=
      of_eq_true
        (Eq.trans
          (congrArg (fun x => x = L + 1)
            (ite_cond_eq_false L (L + 1) (Eq.trans (congrArg (fun x => x = 0) hq) (Init.Data.Nat.Basic._auxLemma.3 0))))
          (eq_self (L + 1)));
    Eq.mpr
      (id
        (congrArg
          (fun _a =>
            ∃ e,
              DecimalDigits.Canonical (Lychrel196.step n) e _a ∧
                ∀ (i : Nat), i < _a → DecimalDigits.columnSum e _a i = FoldedDecimal.nextColumns q L i)
          hw))
      (Exists.intro (DecimalDigits.extended (DecimalDigits.columnSum d L) L)
        ⟨FoldedDecimal.canonical_next_overflow n d L hcan hc, fun i a =>
          Eq.mpr
            (id
              (congrArg
                (Eq
                  (DecimalDigits.extended (DecimalDigits.columnSum d L) L i +
                    DecimalDigits.extended (DecimalDigits.columnSum d L) L (L + 1 - 1 - i)))
                (Eq.trans
                  (ite_congr (Eq.trans (congrArg (fun x => x = 0) hq) _proof_112✝)
                    (fun a => Eq.refl (DecimalDigits.output q i + DecimalDigits.output q (L - 1 - i))) fun a =>
                    Eq.refl (DecimalDigits.extended q L i + DecimalDigits.extended q L (L + 1 - 1 - i)))
                  (if_false (DecimalDigits.output q i + DecimalDigits.output q (L - 1 - i))
                    (DecimalDigits.extended q L i + DecimalDigits.extended q L (L + 1 - 1 - i))))))
            (Eq.mpr
              (id
                (congrArg
                  (fun _a =>
                    _a + DecimalDigits.extended (DecimalDigits.columnSum d L) L (L + 1 - 1 - i) =
                      DecimalDigits.extended q L i + DecimalDigits.extended q L (L + 1 - 1 - i))
                  (FoldedDecimal.extended_congr_upto (DecimalDigits.columnSum d L) q L hrep i)))
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      DecimalDigits.extended q L i + _a =
                        DecimalDigits.extended q L i + DecimalDigits.extended q L (L + 1 - 1 - i))
                    (FoldedDecimal.extended_congr_upto (DecimalDigits.columnSum d L) q L hrep (L + 1 - 1 - i))))
                (Eq.refl (DecimalDigits.extended q L i + DecimalDigits.extended q L (L + 1 - 1 - i)))))⟩)
theorem FoldedDecimal.valid_word_realizable : ∀ (q : Nat → Nat) (L : Nat),
  0 < L →
    0 < q 0 →
      (∀ (i : Nat), i < L → q i ≤ 18) →
        (∀ (i : Nat), i < L → q i = q (L - 1 - i)) →
          (∀ (i : Nat), i < L → i = L - 1 - i → q i % 2 = 0) →
            ∃ n d, 0 < n ∧ DecimalDigits.Canonical n d L ∧ ∀ (i : Nat), i < L → DecimalDigits.columnSum d L i = q i :=
fun q L hL houter hq hs hcenter =>
  let d := FoldedDecimal.realizingDigit q L;
  let_fun hlead := FoldedDecimal.realizingDigit_leading_positive q L hL houter hs hcenter;
  Exists.intro (DecimalDigits.value d L)
    (Exists.intro d
      ⟨DecimalDigits.value_positive d L hL hlead,
        ⟨⟨hL, ⟨FoldedDecimal.realizingDigit_bounded q L hq, ⟨hlead, rfl⟩⟩⟩,
          FoldedDecimal.realizingDigit_columns q L hs hcenter⟩⟩)
