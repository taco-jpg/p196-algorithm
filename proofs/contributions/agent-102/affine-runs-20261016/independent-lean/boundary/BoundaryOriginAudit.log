Agent102.word_nil : Agent102.word [] = []
Agent102.word_cons (r : Agent102.Run) (rs : List Agent102.Run) :
  Agent102.word (r :: rs) = List.replicate r.count r.digit ++ Agent102.word rs
Agent102.word_append (rs ts : List Agent102.Run) : Agent102.word (rs ++ ts) = Agent102.word rs ++ Agent102.word ts
Agent102.word_length (rs : List Agent102.Run) : (Agent102.word rs).length = (List.map Agent102.Run.count rs).sum
Agent102.word_reverse (rs : List Agent102.Run) : Agent102.word rs.reverse = (Agent102.word rs).reverse
Agent102.Span.shift_covers (s : Agent102.Span) (offset i : Nat) : (s.shift offset).covers (i + offset) ↔ s.covers i
Agent102.Span.shift_overlaps (s t : Agent102.Span) (offset : Nat) :
  (s.shift offset).overlaps (t.shift offset) ↔ s.overlaps t
Agent102.spansFrom_shift (rs : List Agent102.Run) (start offset : Nat) :
  Agent102.spansFrom (start + offset) rs = List.map (fun s => s.shift offset) (Agent102.spansFrom start rs)
Agent102.spansFrom_eq_map_spans (rs : List Agent102.Run) (start : Nat) :
  Agent102.spansFrom start rs = List.map (fun s => s.shift start) (Agent102.spans rs)
Agent102.spansFrom_append (rs ts : List Agent102.Run) (start : Nat) :
  Agent102.spansFrom start (rs ++ ts) =
    Agent102.spansFrom start rs ++ Agent102.spansFrom (start + (Agent102.word rs).length) ts
Agent102.length_spansFrom (rs : List Agent102.Run) (start : Nat) : (Agent102.spansFrom start rs).length = rs.length
Agent102.length_spans (rs : List Agent102.Run) : (Agent102.spans rs).length = rs.length
Agent102.mem_spansFrom_bounds {rs : List Agent102.Run} {start : Nat} {s : Agent102.Span}
  (hs : s ∈ Agent102.spansFrom start rs) : start ≤ s.lo ∧ s.lo ≤ s.hi ∧ s.hi ≤ start + (Agent102.word rs).length
Agent102.exists_mem_spansFrom_covers {rs : List Agent102.Run} {start i : Nat} (hstart : start ≤ i)
  (hi : i < start + (Agent102.word rs).length) : ∃ s, s ∈ Agent102.spansFrom start rs ∧ s.covers i
Agent102.exists_mem_spansFrom_covers_iff (rs : List Agent102.Run) (start i : Nat) :
  (∃ s, s ∈ Agent102.spansFrom start rs ∧ s.covers i) ↔ start ≤ i ∧ i < start + (Agent102.word rs).length
Agent102.mem_spans_bounds {rs : List Agent102.Run} {s : Agent102.Span} (hs : s ∈ Agent102.spans rs) :
  s.lo ≤ s.hi ∧ s.hi ≤ (Agent102.word rs).length
Agent102.exists_mem_spans_covers {rs : List Agent102.Run} {i : Nat} (hi : i < (Agent102.word rs).length) :
  ∃ s, s ∈ Agent102.spans rs ∧ s.covers i
Agent102.exists_mem_spans_covers_iff (rs : List Agent102.Run) (i : Nat) :
  (∃ s, s ∈ Agent102.spans rs ∧ s.covers i) ↔ i < (Agent102.word rs).length
Agent102.eq_of_mem_spansFrom_covers {rs : List Agent102.Run} {start i : Nat} {s t : Agent102.Span}
  (hs : s ∈ Agent102.spansFrom start rs) (ht : t ∈ Agent102.spansFrom start rs) (hsi : s.covers i) (hti : t.covers i) :
  s = t
Agent102.eq_of_mem_spans_covers {rs : List Agent102.Run} {i : Nat} {s t : Agent102.Span} (hs : s ∈ Agent102.spans rs)
  (ht : t ∈ Agent102.spans rs) (hsi : s.covers i) (hti : t.covers i) : s = t
Agent102.getElem?_word_of_mem_spansFrom {rs : List Agent102.Run} {start i : Nat} {s : Agent102.Span}
  (hs : s ∈ Agent102.spansFrom start rs) (hi : s.covers i) : (Agent102.word rs)[i - start]? = some s.digit
Agent102.getElem?_word_of_covers {rs : List Agent102.Run} {s : Agent102.Span} {i : Nat} (hs : s ∈ Agent102.spans rs)
  (hi : s.covers i) : (Agent102.word rs)[i]? = some s.digit
Agent102.Span.overlaps_iff_exists_covers (s t : Agent102.Span) : s.overlaps t ↔ ∃ i, s.covers i ∧ t.covers i
Agent102.Span.overlaps_of_covers {s t : Agent102.Span} {i : Nat} (hs : s.covers i) (ht : t.covers i) : s.overlaps t
Agent102.word_eq_iff_length_and_overlap_digits (A B : List Agent102.Run) :
  Agent102.word A = Agent102.word B ↔
    (Agent102.word A).length = (Agent102.word B).length ∧
      ∀ (s : Agent102.Span),
        s ∈ Agent102.spans A → ∀ (t : Agent102.Span), t ∈ Agent102.spans B → s.overlaps t → s.digit = t.digit
Agent102.word_eq_iff_count_sum_and_overlap_digits (A B : List Agent102.Run) :
  Agent102.word A = Agent102.word B ↔
    (List.map Agent102.Run.count A).sum = (List.map Agent102.Run.count B).sum ∧
      ∀ (s : Agent102.Span),
        s ∈ Agent102.spans A → ∀ (t : Agent102.Span), t ∈ Agent102.spans B → s.overlaps t → s.digit = t.digit
Agent102.Affine.eval_zero (k : Nat) : Agent102.Affine.zero.eval k = 0
Agent102.Affine.eval_add (f g : Agent102.Affine) (k : Nat) : (f.add g).eval k = f.eval k + g.eval k
Agent102.Affine.intercept_bounds_of_cutoff (f : Agent102.Affine) (k : Nat) (hk : f.cutoff ≤ k) :
  -↑k < f.intercept ∧ f.intercept < ↑k
Agent102.Affine.eval_pos_of_slope_pos (f : Agent102.Affine) (k : Nat) (hk : f.cutoff ≤ k) (hs : 0 < f.slope) :
  0 < f.eval k
Agent102.Affine.eval_neg_of_slope_neg (f : Agent102.Affine) (k : Nat) (hk : f.cutoff ≤ k) (hs : f.slope < 0) :
  f.eval k < 0
Agent102.Affine.eval_nonneg_iff (f : Agent102.Affine) (k : Nat) (hk : f.cutoff ≤ k) :
  0 ≤ f.eval k ↔ 0 < f.slope ∨ f.slope = 0 ∧ 0 ≤ f.intercept
Agent102.Affine.eval_neg_iff (f : Agent102.Affine) (k : Nat) (hk : f.cutoff ≤ k) :
  f.eval k < 0 ↔ f.slope < 0 ∨ f.slope = 0 ∧ f.intercept < 0
Agent102.Affine.eval_positivePart (f : Agent102.Affine) (k : Nat) (hk : f.cutoff ≤ k) :
  f.positivePart.eval k = ↑(f.eval k).toNat
Agent102.Affine.eval_positivePart_nonneg (f : Agent102.Affine) (k : Nat) (hk : f.cutoff ≤ k) : 0 ≤ f.positivePart.eval k
Agent102.Affine.compareCutoff_comm (f g : Agent102.Affine) : f.compareCutoff g = g.compareCutoff f
Agent102.Affine.eval_lt_of_slope_lt (f g : Agent102.Affine) (k : Nat) (hk : f.compareCutoff g ≤ k)
  (hs : f.slope < g.slope) : f.eval k < g.eval k
Agent102.Affine.eval_le_iff (f g : Agent102.Affine) (k : Nat) (hk : f.compareCutoff g ≤ k) :
  f.eval k ≤ g.eval k ↔ f.slope < g.slope ∨ f.slope = g.slope ∧ f.intercept ≤ g.intercept
Agent102.Affine.eval_lt_iff (f g : Agent102.Affine) (k : Nat) (hk : f.compareCutoff g ≤ k) :
  f.eval k < g.eval k ↔ f.slope < g.slope ∨ f.slope = g.slope ∧ f.intercept < g.intercept
Agent102.Affine.eval_eq_iff (f g : Agent102.Affine) (k : Nat) (hk : f.compareCutoff g ≤ k) :
  f.eval k = g.eval k ↔ f.slope = g.slope ∧ f.intercept = g.intercept
Agent102.Affine.eval_le_stable (f g : Agent102.Affine) (K k : Nat) (hK : f.compareCutoff g ≤ K) (hk : K ≤ k) :
  f.eval k ≤ g.eval k ↔ f.eval K ≤ g.eval K
Agent102.Affine.eval_lt_stable (f g : Agent102.Affine) (K k : Nat) (hK : f.compareCutoff g ≤ K) (hk : K ≤ k) :
  f.eval k < g.eval k ↔ f.eval K < g.eval K
Agent102.Affine.eval_eq_stable (f g : Agent102.Affine) (K k : Nat) (hK : f.compareCutoff g ≤ K) (hk : K ≤ k) :
  f.eval k = g.eval k ↔ f.eval K = g.eval K
Agent102.AffineBoundary.wordAt_moving (k : Nat) : Agent102.wordAt Agent102.AffineBoundary.moving k = List.replicate k 1
Agent102.AffineBoundary.wordAt_fixed (N k : Nat) :
  Agent102.wordAt (Agent102.AffineBoundary.fixed N) k = List.replicate N 1
Agent102.AffineBoundary.moving_fixed_eq_iff (k N : Nat) :
  Agent102.wordAt Agent102.AffineBoundary.moving k = Agent102.wordAt (Agent102.AffineBoundary.fixed N) k ↔ k = N
Agent102.AffineBoundary.compareCutoff_moving_fixed (N : Nat) :
  Agent102.AffineBoundary.movingLength.compareCutoff (Agent102.AffineBoundary.fixedLength N) = N + 1
Agent102.AffineBoundary.moving_fixed_stable_iff (N K : Nat) :
  (∀ (k : Nat),
      K ≤ k →
        (Agent102.wordAt Agent102.AffineBoundary.moving k = Agent102.wordAt (Agent102.AffineBoundary.fixed N) k ↔
          Agent102.wordAt Agent102.AffineBoundary.moving K = Agent102.wordAt (Agent102.AffineBoundary.fixed N) K)) ↔
    N < K
Agent102.AffineBoundary.equality_changes_arbitrarily_late (K : Nat) :
  ∃ A B k, K ≤ k ∧ Agent102.wordAt A k = Agent102.wordAt B k ∧ Agent102.wordAt A (k + 1) ≠ Agent102.wordAt B (k + 1)
Agent102.AffineBoundary.no_uniform_wordAt_cutoff :
  ¬∃ K,
      ∀ (A B : List Agent102.RunSpec) (k : Nat),
        K ≤ k → (Agent102.wordAt A k = Agent102.wordAt B k ↔ Agent102.wordAt A K = Agent102.wordAt B K)
Agent102.AffineBoundary.run_structure_counterexample :
  Agent102.AffineBoundary.splitRuns ≠ Agent102.AffineBoundary.longRuns ∧
    Agent102.word Agent102.AffineBoundary.splitRuns = Agent102.word Agent102.AffineBoundary.longRuns
Agent102.AffineBoundary.overlap_digits_without_width :
  (∀ (s : Agent102.Span),
      s ∈ Agent102.spans Agent102.AffineBoundary.shortRuns →
        ∀ (t : Agent102.Span), t ∈ Agent102.spans Agent102.AffineBoundary.longRuns → s.overlaps t → s.digit = t.digit) ∧
    (∃ s,
        s ∈ Agent102.spans Agent102.AffineBoundary.shortRuns ∧
          ∃ t, t ∈ Agent102.spans Agent102.AffineBoundary.longRuns ∧ s.overlaps t) ∧
      (Agent102.word Agent102.AffineBoundary.shortRuns).length ≠
          (Agent102.word Agent102.AffineBoundary.longRuns).length ∧
        Agent102.word Agent102.AffineBoundary.shortRuns ≠ Agent102.word Agent102.AffineBoundary.longRuns
Agent102.AffineBoundary.zero_span_cross_inequalities :
  Agent102.AffineBoundary.emptySpan.lo = Agent102.AffineBoundary.emptySpan.hi ∧
    Agent102.AffineBoundary.emptySpan.lo < Agent102.AffineBoundary.coveringSpan.hi ∧
      Agent102.AffineBoundary.coveringSpan.lo < Agent102.AffineBoundary.emptySpan.hi ∧
        ¬Agent102.AffineBoundary.emptySpan.overlaps Agent102.AffineBoundary.coveringSpan ∧
          Agent102.AffineBoundary.emptySpan.digit ≠ Agent102.AffineBoundary.coveringSpan.digit
Agent102.AffineBoundary.zero_span_realized :
  Agent102.AffineBoundary.emptySpan ∈ Agent102.spans Agent102.AffineBoundary.withZeroRuns ∧
    Agent102.AffineBoundary.coveringSpan ∈ Agent102.spans Agent102.AffineBoundary.withoutZeroRuns ∧
      Agent102.word Agent102.AffineBoundary.withZeroRuns = Agent102.word Agent102.AffineBoundary.withoutZeroRuns
Agent102.AffineBoundary.cross_inequalities_false_negative :
  Agent102.word Agent102.AffineBoundary.withZeroRuns = Agent102.word Agent102.AffineBoundary.withoutZeroRuns ∧
    ¬∀ (s : Agent102.Span),
        s ∈ Agent102.spans Agent102.AffineBoundary.withZeroRuns →
          ∀ (t : Agent102.Span),
            t ∈ Agent102.spans Agent102.AffineBoundary.withoutZeroRuns → s.lo < t.hi → t.lo < s.hi → s.digit = t.digit
