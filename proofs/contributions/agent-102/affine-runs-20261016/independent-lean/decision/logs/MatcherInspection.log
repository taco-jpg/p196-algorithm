def Agent102.lengthCutoff.match_1.{u_1} : (motive : List Agent102.RunSpec → Sort u_1) →
  (x : List Agent102.RunSpec) →
    (Unit → motive []) → ((r : Agent102.RunSpec) → (rs : List Agent102.RunSpec) → motive (r :: rs)) → motive x :=
fun motive x h_1 h_2 => List.casesOn x (h_1 ()) fun head tail => h_2 head tail
def Agent102.widthAffine : List Agent102.RunSpec → Agent102.Affine :=
fun x =>
  List.brecOn x fun x f =>
    (match (motive := (x : List Agent102.RunSpec) → List.below x → Agent102.Affine) x with
      | [] => fun x => Agent102.Affine.zero
      | r :: rs => fun x => r.length.positivePart.add x.1)
      f
def Agent102.spanSpecsFrom : Agent102.Affine → List Agent102.RunSpec → List Agent102.AffineSpan :=
fun start x =>
  List.brecOn (motive := fun x => Agent102.Affine → List Agent102.AffineSpan) x
    (fun x f start =>
      (match (motive :=
          (x : List Agent102.RunSpec) →
            List.below (motive := fun x => Agent102.Affine → List Agent102.AffineSpan) x → List Agent102.AffineSpan)
          x with
        | [] => fun x => []
        | r :: rs => fun x =>
          { digit := r.digit, lo := start, hi := start.add r.length.positivePart } ::
            x.1 (start.add r.length.positivePart))
        f)
    start
