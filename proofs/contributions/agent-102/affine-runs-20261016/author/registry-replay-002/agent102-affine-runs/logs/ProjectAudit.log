Agent102.word_eq_iff_count_sum_and_overlap_digits (A B : List Agent102.Run) :
  Agent102.word A = Agent102.word B ↔
    (List.map Agent102.Run.count A).sum = (List.map Agent102.Run.count B).sum ∧
      ∀ (s : Agent102.Span),
        s ∈ Agent102.spans A → ∀ (t : Agent102.Span), t ∈ Agent102.spans B → s.overlaps t → s.digit = t.digit
Agent102.le_maxList_of_mem {n : Nat} {ns : List Nat} (h : n ∈ ns) : n ≤ Agent102.maxList ns
Agent102.cutoff_le_lengthCutoff {r : Agent102.RunSpec} {rs : List Agent102.RunSpec} (h : r ∈ rs) :
  r.length.cutoff ≤ Agent102.lengthCutoff rs
Agent102.wordAt_nil (k : Nat) : Agent102.wordAt [] k = []
Agent102.wordAt_cons (r : Agent102.RunSpec) (rs : List Agent102.RunSpec) (k : Nat) :
