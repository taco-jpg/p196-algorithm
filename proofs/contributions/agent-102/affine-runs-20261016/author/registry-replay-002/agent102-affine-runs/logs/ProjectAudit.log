Agent102.Affine.eval_neg_of_slope_neg (f : Agent102.Affine) (k : Nat) (hk : f.cutoff ≤ k) (hs : f.slope < 0) :
  f.eval k < 0
Agent102.Affine.eval_nonneg_iff (f : Agent102.Affine) (k : Nat) (hk : f.cutoff ≤ k) :
