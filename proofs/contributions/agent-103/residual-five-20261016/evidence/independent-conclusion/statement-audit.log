theorem Agent103.ResidualFive.occurrence_necessary_conditions : ∀ (t r : Nat),
  Lychrel196.orbit 196 t = Agent119.EightFamilies.fam 5 r →
    105 ≤ t ∧
      1 ≤ r ∧
        t % 6 = 3 ∧
          (Agent119.EightFamilies.V (t - 1)).fst = 2 * r + 4 ∧
            (Agent119.EightFamilies.V (t - 2)).fst = 2 * r + 4 ∧
              DecimalDigits.carry (Agent119.EightFamilies.V (t - 1)).snd (Agent119.EightFamilies.V (t - 1)).fst = 0 ∧
                DecimalDigits.carry (Agent119.EightFamilies.V (t - 2)).snd (Agent119.EightFamilies.V (t - 2)).fst = 0 ∧
                  Lychrel196.orbit 196 (t - 1) = 33 * 10 ^ (2 * r + 2) + 22 ∧
                    (∀ (i : Nat),
                        i < 2 * r + 4 →
                          (Agent119.EightFamilies.V (t - 2)).snd i = Agent103.ResidualFive.fiveSourceDigit r i) ∧
                      ∀ (i : Nat),
                        i ≤ 2 * r + 4 →
                          DecimalDigits.carry (Agent119.EightFamilies.V (t - 2)).snd i =
                            if 2 ≤ i ∧ i ≤ 2 * r + 3 then 1 else 0 :=
fun t r h =>
  And.casesOn
    (Agent119.EightFamilies.early_or_short 5 r t (of_decide_eq_true (id (Eq.refl true)))
      (of_decide_eq_true (id (Eq.refl true))) h)
    fun left hr =>
    And.casesOn (Agent103.ResidualFive.occurrence_final_carries t r h) fun hc1 hc2 =>
      And.casesOn (Agent103.ResidualFive.occurrence_two_step_shape t r h) fun hw2 right =>
        And.casesOn right fun hq hm =>
          ⟨Agent103.ResidualFive.occurrence_at_least105 t r h,
            ⟨hr,
              ⟨Agent103.ResidualFive.occurrence_time_mod6 t r h,
                ⟨(Agent103.ResidualFive.occurrence_penultimate_pairs t r h).left,
                  ⟨hw2, ⟨hc1, ⟨hc2, ⟨hm, ⟨hq, Agent103.ResidualFive.occurrence_internal_carries t r h⟩⟩⟩⟩⟩⟩⟩⟩⟩
theorem Agent103.ResidualFive.occurrence_necessary_conditions_unfolded : ∀ (t r : Nat),
  Lychrel196.orbit 196 t = 55 * (10 ^ (2 * r + 2) + 1) →
    105 ≤ t ∧
      1 ≤ r ∧
        t % 6 = 3 ∧
          Lychrel196.orbit 196 (t - 1) = 33 * 10 ^ (2 * r + 2) + 22 ∧
            (Agent119.EightFamilies.V (t - 2)).fst = 2 * r + 4 ∧
              ∀ (i : Nat),
                i < 2 * r + 4 → (Agent119.EightFamilies.V (t - 2)).snd i = Agent103.ResidualFive.fiveSourceDigit r i :=
fun t r h =>
  let_fun hf := id h;
  let_fun hn := Agent103.ResidualFive.occurrence_necessary_conditions t r hf;
  ⟨hn.left,
    ⟨hn.right.left,
      ⟨hn.right.right.left,
        ⟨hn.right.right.right.right.right.right.right.left,
          ⟨hn.right.right.right.right.left, hn.right.right.right.right.right.right.right.right.left⟩⟩⟩⟩⟩
theorem Agent103.ResidualFiveWitness.first_positive_hit_six : 0 < 6 ∧
  Lychrel196.Palindrome (Lychrel196.orbit Agent103.ResidualFiveWitness.seed 6) ∧
    ∀ (i : Nat), 0 < i → i < 6 → ¬Lychrel196.Palindrome (Lychrel196.orbit Agent103.ResidualFiveWitness.seed i) :=
⟨of_decide_eq_true (id (Eq.refl true)),
  ⟨Agent103.ResidualFiveWitness.palindrome_at_six, fun i x hi => Agent103.ResidualFiveWitness.nonpal_before_six i hi⟩⟩
theorem Agent103.ResidualFiveWitness.mod99_matches_196 : ∀ (i : Nat),
  Lychrel196.orbit Agent103.ResidualFiveWitness.seed i % 99 = Lychrel196.orbit 196 (3 + i) % 99 :=
fun i =>
  let_fun h196 := of_decide_eq_true (id (Eq.refl true));
  Eq.mpr
    (id
      (congrArg (fun _a => Lychrel196.orbit Agent103.ResidualFiveWitness.seed i % 99 = _a % 99)
        (LychrelCertificates.orbit_add 196 3 i)))
    (Eq.mpr
      (id
        (congrArg (fun _a => Lychrel196.orbit Agent103.ResidualFiveWitness.seed i % 99 = Lychrel196.orbit _a i % 99)
          h196))
      (Eq.mpr
        (id
          (congrArg (fun _a => _a = Lychrel196.orbit 7436 i % 99)
            (Agent423.TemporalResidues.orbit_mod99_pow_of_dvd11 Agent103.ResidualFiveWitness.seed i
              (of_decide_eq_true (id (Eq.refl true))))))
        (Eq.mpr
          (id
            (congrArg (fun _a => 2 ^ i * Agent103.ResidualFiveWitness.seed % 99 = _a)
              (Agent423.TemporalResidues.orbit_mod99_pow_of_dvd11 7436 i (of_decide_eq_true (id (Eq.refl true))))))
          (let_fun hs := of_decide_eq_true (id (Eq.refl true));
          trans
            (trans (Nat.mul_mod (2 ^ i) Agent103.ResidualFiveWitness.seed 99)
              (Eq.mpr (id (congrArg (fun _a => 2 ^ i % 99 * _a % 99 = 2 ^ i % 99 * (7436 % 99) % 99) hs))
                (Eq.refl (2 ^ i % 99 * (7436 % 99) % 99))))
            (Eq.symm (Nat.mul_mod (2 ^ i) 7436 99))))))
theorem Agent103.ResidualFiveWitness.mod99_trajectory_insufficient : ¬∀ (n : Nat),
    0 < n →
      (∀ (i : Nat), Lychrel196.orbit n i % 99 = Lychrel196.orbit 196 (3 + i) % 99) →
        ∀ (t : Nat), Lychrel196.orbit n t ≠ 55 * (10 ^ 32 + 1) :=
fun h =>
  h Agent103.ResidualFiveWitness.seed Agent103.ResidualFiveWitness.seed_positive
    Agent103.ResidualFiveWitness.mod99_matches_196 6 Agent103.ResidualFiveWitness.target_at_six
theorem Agent103.ResidualFiveWitness.residual_five_witness : ∃ n,
  0 < n ∧
    n ≠ 196 ∧
      (∀ (i : Nat), Lychrel196.orbit n i % 99 = Lychrel196.orbit 196 (3 + i) % 99) ∧
        Lychrel196.orbit n 6 = 55 * (10 ^ 32 + 1) ∧
          Lychrel196.Palindrome (Lychrel196.orbit n 6) ∧
            ∀ (i : Nat), i < 6 → ¬Lychrel196.Palindrome (Lychrel196.orbit n i) :=
Exists.intro Agent103.ResidualFiveWitness.seed
  ⟨Agent103.ResidualFiveWitness.seed_positive,
    ⟨Agent103.ResidualFiveWitness.seed_ne_196,
      ⟨Agent103.ResidualFiveWitness.mod99_matches_196,
        ⟨Agent103.ResidualFiveWitness.target_at_six,
          ⟨Agent103.ResidualFiveWitness.palindrome_at_six, Agent103.ResidualFiveWitness.nonpal_before_six⟩⟩⟩⟩⟩
