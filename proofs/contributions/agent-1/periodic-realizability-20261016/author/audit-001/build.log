theorem Agent1.Periodic.periodicWord_admissible : ∀ (B H w : Agent8.Word) (k : Nat),
  Agent1.Periodic.ValidPeriodic B H w →
    0 < k →
      FoldedDecimal.Admissible (List.length (Agent1.Periodic.periodicWord B H w k)) fun i =>
        (Agent1.Periodic.periodicWord B H w k)[i]?.getD 0 :=
fun B H w k hv hk =>
  let_fun hc := Agent1.Periodic.periodicWord_canonical B H w k hv hk;
  ⟨List.length_pos_iff.mpr hc.left,
    ⟨id
        (Eq.mp
          (congrArg (LT.lt 0) (Eq.trans List.headD_eq_head?_getD (congrArg (fun x => x.getD 0) List.head?_eq_getElem?)))
          hc.right.right.right),
      ⟨fun i hi =>
        Eq.mpr (id (congrArg (fun x => x.getD 0 ≤ 18) (List.getElem?_eq_getElem hi)))
          (hc.right.right.left (Agent1.Periodic.periodicWord B H w k)[i] (List.getElem_mem hi)),
        ⟨fun i hi =>
          let_fun hr := List.getElem?_reverse hi;
          congrArg (fun o => o.getD 0)
            (Eq.mp
              (congrArg
                (fun _a =>
                  _a[i]? =
                    (Agent1.Periodic.periodicWord B H w k)[List.length (Agent1.Periodic.periodicWord B H w k) - 1 - i]?)
                hc.right.left)
              hr),
          fun i hi hfixed =>
          let_fun hlen := Agent1.Periodic.periodicWord_length B H w k;
          let_fun hiMid :=
            Decidable.byContradiction fun a =>
              Agent1.Periodic.periodicWord_admissible._proof_1 B H w k i hi hfixed hlen a;
          let_fun hodd :=
            Decidable.byContradiction fun a =>
              Agent1.Periodic.periodicWord_admissible._proof_2 B H w k i hi hfixed hlen hiMid a;
          let_fun hPS :=
            Eq.mpr
              (id
                (congr
                  (congrArg Eq
                    (Eq.trans List.length_append
                      (congrArg (HAdd.hAdd (List.length B)) (Agent1.RepeatedBlock.pow_length w k))))
                  (Eq.trans List.length_append
                    (congr
                      (congrArg HAdd.hAdd
                        (Eq.trans (Agent1.RepeatedBlock.pow_length (List.reverse w) k)
                          (congrArg (HMul.hMul k) List.length_reverse)))
                      List.length_reverse))))
              (Decidable.byContradiction fun a => Agent1.Periodic.periodicWord_admissible._proof_3 B H w k i a);
          let_fun hm :=
            Agent1.Periodic.middle_append_eq (B ++ Agent1.RepeatedBlock.pow w k) H
              (Agent1.RepeatedBlock.pow (List.reverse w) k ++ List.reverse B) hPS hodd;
          let_fun hmiddle :=
            Eq.mpr
              (id
                (congrArg (fun x => x = H[List.length H / 2]?)
                  (congr
                    (congrArg getElem?
                      (Eq.trans
                        (Eq.trans
                          (congrArg (fun x => x ++ List.reverse B)
                            (Eq.trans
                              (Eq.trans
                                (congrArg (fun x => x ++ Agent1.RepeatedBlock.pow (List.reverse w) k)
                                  (List.append_assoc B (Agent1.RepeatedBlock.pow w k) H))
                                (List.append_assoc B (Agent1.RepeatedBlock.pow w k ++ H)
                                  (Agent1.RepeatedBlock.pow (List.reverse w) k)))
                              (congrArg (HAppend.hAppend B)
                                (List.append_assoc (Agent1.RepeatedBlock.pow w k) H
                                  (Agent1.RepeatedBlock.pow (List.reverse w) k)))))
                          (List.append_assoc B
                            (Agent1.RepeatedBlock.pow w k ++ (H ++ Agent1.RepeatedBlock.pow (List.reverse w) k))
                            (List.reverse B)))
                        (congrArg (HAppend.hAppend B)
                          (Eq.trans
                            (List.append_assoc (Agent1.RepeatedBlock.pow w k)
                              (H ++ Agent1.RepeatedBlock.pow (List.reverse w) k) (List.reverse B))
                            (congrArg (HAppend.hAppend (Agent1.RepeatedBlock.pow w k))
                              (List.append_assoc H (Agent1.RepeatedBlock.pow (List.reverse w) k) (List.reverse B)))))))
                    (congrArg (fun x => x.length / 2)
                      (Eq.trans
                        (Eq.trans
                          (congrArg (fun x => x ++ List.reverse B)
                            (Eq.trans
                              (Eq.trans
                                (congrArg (fun x => x ++ Agent1.RepeatedBlock.pow (List.reverse w) k)
                                  (List.append_assoc B (Agent1.RepeatedBlock.pow w k) H))
                                (List.append_assoc B (Agent1.RepeatedBlock.pow w k ++ H)
                                  (Agent1.RepeatedBlock.pow (List.reverse w) k)))
                              (congrArg (HAppend.hAppend B)
                                (List.append_assoc (Agent1.RepeatedBlock.pow w k) H
                                  (Agent1.RepeatedBlock.pow (List.reverse w) k)))))
                          (List.append_assoc B
                            (Agent1.RepeatedBlock.pow w k ++ (H ++ Agent1.RepeatedBlock.pow (List.reverse w) k))
                            (List.reverse B)))
                        (congrArg (HAppend.hAppend B)
                          (Eq.trans
                            (List.append_assoc (Agent1.RepeatedBlock.pow w k)
                              (H ++ Agent1.RepeatedBlock.pow (List.reverse w) k) (List.reverse B))
                            (congrArg (HAppend.hAppend (Agent1.RepeatedBlock.pow w k))
                              (List.append_assoc H (Agent1.RepeatedBlock.pow (List.reverse w) k)
                                (List.reverse B))))))))))
              (Eq.mp
                (congrArg (fun x => x = H[List.length H / 2]?)
                  (congr
                    (congrArg getElem?
                      (Eq.trans
                        (Eq.trans
                          (congrArg (fun x => x ++ (Agent1.RepeatedBlock.pow (List.reverse w) k ++ List.reverse B))
                            (List.append_assoc B (Agent1.RepeatedBlock.pow w k) H))
                          (List.append_assoc B (Agent1.RepeatedBlock.pow w k ++ H)
                            (Agent1.RepeatedBlock.pow (List.reverse w) k ++ List.reverse B)))
                        (congrArg (HAppend.hAppend B)
                          (List.append_assoc (Agent1.RepeatedBlock.pow w k) H
                            (Agent1.RepeatedBlock.pow (List.reverse w) k ++ List.reverse B)))))
                    (congrArg (fun x => x.length / 2)
                      (Eq.trans
                        (Eq.trans
                          (congrArg (fun x => x ++ (Agent1.RepeatedBlock.pow (List.reverse w) k ++ List.reverse B))
                            (List.append_assoc B (Agent1.RepeatedBlock.pow w k) H))
                          (List.append_assoc B (Agent1.RepeatedBlock.pow w k ++ H)
                            (Agent1.RepeatedBlock.pow (List.reverse w) k ++ List.reverse B)))
                        (congrArg (HAppend.hAppend B)
                          (List.append_assoc (Agent1.RepeatedBlock.pow w k) H
                            (Agent1.RepeatedBlock.pow (List.reverse w) k ++ List.reverse B)))))))
                hm);
          id
            (Eq.mpr (id (congrArg (fun _a => (Agent1.Periodic.periodicWord B H w k)[_a]?.getD 0 % 2 = 0) hiMid))
              (Eq.mpr (id (congrArg (fun _a => _a.getD 0 % 2 = 0) hmiddle)) (hv.center_even hodd)))⟩⟩⟩⟩
theorem Agent1.Periodic.periodicWord_realizable : ∀ (B H w : Agent8.Word) (k : Nat),
  Agent1.Periodic.ValidPeriodic B H w →
    0 < k →
      ∃ n d,
        0 < n ∧
          DecimalDigits.Canonical n d (List.length (Agent1.Periodic.periodicWord B H w k)) ∧
            ∀ (i : Nat),
              i < List.length (Agent1.Periodic.periodicWord B H w k) →
                DecimalDigits.columnSum d (List.length (Agent1.Periodic.periodicWord B H w k)) i =
                  (Agent1.Periodic.periodicWord B H w k)[i]?.getD 0 :=
fun B H w k hv hk =>
  And.casesOn (Agent1.Periodic.periodicWord_admissible B H w k hv hk) fun hL right =>
    And.casesOn right fun houter right =>
      And.casesOn right fun hbound right =>
        And.casesOn right fun hsym hcenter =>
          FoldedDecimal.valid_word_realizable (fun i => (Agent1.Periodic.periodicWord B H w k)[i]?.getD 0)
            (List.length (Agent1.Periodic.periodicWord B H w k)) hL houter hbound hsym hcenter
