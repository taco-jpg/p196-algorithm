AUDIT_SAFE_CONSTANT Agent1.Periodic.periodicWord_admissible._proof_3 theorem=true : [propext, Quot.sound]
AUDIT_SAFE_CONSTANT Agent1.Periodic.periodicWord_realizable theorem=true : [propext, Quot.sound]
AUDIT_SAFE_CONSTANT Agent1.Periodic.periodicWord_admissible theorem=true : [propext, Quot.sound]
AUDIT_SAFE_CONSTANT Agent1.Periodic.periodicWord_admissible._proof_2 theorem=true : [propext, Quot.sound]
AUDIT_SAFE_CONSTANT Agent1.Periodic.periodicWord_admissible._proof_1 theorem=true : [propext, Quot.sound]
