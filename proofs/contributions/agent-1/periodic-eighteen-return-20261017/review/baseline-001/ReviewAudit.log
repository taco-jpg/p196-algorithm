    Agent1.Periodic.periodicWord (Agent1.Periodic.quotientOuter B H w) (Agent1.Periodic.quotientCenter B H w)
      (Agent1.Periodic.rawPeriod B H w)
      (k - 2 + Agent1.Periodic.outerPeriods B H w + Agent1.Periodic.centerPeriods B H w)
Agent1.Periodic.quotient_irreducible (B H w : Agent8.Word) (hB : Agent8.Bounded B 18) (hH : Agent8.Bounded H 18)
  (hw : Agent8.Bounded w 18) (hlen : List.length w = 4) :
  (¬∃ D, Agent1.Periodic.quotientOuter B H w = D ++ Agent1.Periodic.rawPeriod B H w) ∧
