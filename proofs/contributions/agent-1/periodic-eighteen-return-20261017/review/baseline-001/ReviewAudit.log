      (Agent1.Periodic.rawPeriod B H w) (k - 2)
Agent1.Periodic.raw_guard (B H w : Agent8.Word) (k : Nat) (hv : Agent1.Periodic.ValidPeriodic B H w) (hk : 3 ≤ k) :
  Agent8.stepWord (Agent1.Periodic.periodicWord B H w k) =
    Agent1.Periodic.periodicWord (Agent1.Periodic.rawOuter B H w) (Agent1.Periodic.rawCenter B H w)
      (Agent1.Periodic.rawPeriod B H w) (k - 2)
Agent1.Periodic.raw_block_lengths (B H w : Agent8.Word) (hB : Agent8.Bounded B 18) (hH : Agent8.Bounded H 18)
  (hw : Agent8.Bounded w 18) (hlen : List.length w = 4) :
  List.length (Agent1.Periodic.rawOuter B H w) = List.length B + 4 ∧
