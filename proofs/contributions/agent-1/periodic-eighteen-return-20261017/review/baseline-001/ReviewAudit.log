  Agent1.RepeatedBlock.pow w (m + n) = Agent1.RepeatedBlock.pow w m ++ Agent1.RepeatedBlock.pow w n
Agent1.Periodic.pow_succ_right (w : Agent8.Word) (n : Nat) :
  Agent1.RepeatedBlock.pow w (n + 1) = Agent1.RepeatedBlock.pow w n ++ w
Agent1.Periodic.pow_reverse (w : Agent8.Word) (n : Nat) :
  List.reverse (Agent1.RepeatedBlock.pow w n) = Agent1.RepeatedBlock.pow (List.reverse w) n
Agent1.Periodic.zipAdd_append_eq (a a' b b' : Agent8.Word) (h : List.length a = List.length b) :
  Agent8.zipAdd (a ++ a') (b ++ b') = Agent8.zipAdd a b ++ Agent8.zipAdd a' b'
Agent1.Periodic.zipAdd_length_eq (a b : Agent8.Word) (h : List.length a = List.length b) :
  List.length (Agent8.zipAdd a b) = List.length a
Agent1.Periodic.zipAdd_comm_eq (a b : Agent8.Word) : Agent8.zipAdd a b = Agent8.zipAdd b a
Agent1.Periodic.zipAdd_reverse_eq (a b : Agent8.Word) (h : List.length a = List.length b) :
  List.reverse (Agent8.zipAdd a b) = Agent8.zipAdd (List.reverse a) (List.reverse b)
Agent1.Periodic.zipAdd_pow (a b : Agent8.Word) (n : Nat) (h : List.length a = List.length b) :
  Agent8.zipAdd (Agent1.RepeatedBlock.pow a n) (Agent1.RepeatedBlock.pow b n) =
    Agent1.RepeatedBlock.pow (Agent8.zipAdd a b) n
Agent1.Periodic.pow_rotate_append (p s : Agent8.Word) (n : Nat) :
  Agent1.RepeatedBlock.pow (p ++ s) n ++ p = p ++ Agent1.RepeatedBlock.pow (s ++ p) n
Agent1.Periodic.pair_three_parts (l m r : Agent8.Word) (h : List.length l = List.length r) :
  Agent8.pair (l ++ m ++ r) =
    Agent8.zipAdd l (List.reverse r) ++ Agent8.pair m ++ List.reverse (Agent8.zipAdd l (List.reverse r))
Agent1.Periodic.pair_periodic_digits (A U C V Z : Agent8.Word) (b h g n : Nat) (hA : List.length A = b + 4)
  (hU : List.length U = 4) (hC : List.length C = h + 4) (hV : List.length V = 4) (hZ : List.length Z = b + g)
  (hg : g ≤ 4) :
  Agent8.pair (A ++ Agent1.RepeatedBlock.pow U (n + 2) ++ C ++ Agent1.RepeatedBlock.pow V (n + 2) ++ Z) =
    Agent1.Periodic.periodicWord (Agent1.Periodic.zipperOuter A V Z g) (Agent1.Periodic.zipperCenter U C V g)
      (Agent1.Periodic.zipperPeriod U V g) (n + 1)
Agent1.Periodic.zipper_block_lengths (A U C V Z : Agent8.Word) (b h g : Nat) (hA : List.length A = b + 4)
  (hU : List.length U = 4) (hC : List.length C = h + 4) (hV : List.length V = 4) (hZ : List.length Z = b + g)
  (hg : g ≤ 4) :
  List.length (Agent1.Periodic.zipperOuter A V Z g) = b + 4 ∧
    List.length (Agent1.Periodic.zipperPeriod U V g) = 4 ∧
      List.length (Agent1.Periodic.zipperCenter U C V g) = h + 8 + g
Agent1.Periodic.stepWord_periodic_form (B H w : Agent8.Word) (n : Nat) (hB : Agent8.Bounded B 18)
  (hH : Agent8.Bounded H 18) (hw : Agent8.Bounded w 18) (hlen : List.length w = 4) :
  Agent8.stepWord (Agent1.Periodic.periodicWord B H w (n + 3)) =
    Agent1.Periodic.periodicWord
      (Agent1.Periodic.zipperOuter (Agent1.Periodic.leftGuardDigits B w) (Agent1.Periodic.rightPeriodDigits B H w)
        (Agent1.Periodic.rightGuardDigits B H w) (Agent1.Periodic.rawGamma B H w))
      (Agent1.Periodic.zipperCenter (Agent1.Periodic.leftPeriodDigits B w) (Agent1.Periodic.centerGuardDigits B H w)
        (Agent1.Periodic.rightPeriodDigits B H w) (Agent1.Periodic.rawGamma B H w))
      (Agent1.Periodic.zipperPeriod (Agent1.Periodic.leftPeriodDigits B w) (Agent1.Periodic.rightPeriodDigits B H w)
        (Agent1.Periodic.rawGamma B H w))
      (n + 1)
Agent1.Periodic.raw_blocks_eq_zipper (B H w : Agent8.Word) (hB : Agent8.Bounded B 18) (hH : Agent8.Bounded H 18)
  (hw : Agent8.Bounded w 18) (hlen : List.length w = 4) :
  Agent1.Periodic.rawOuter B H w =
      Agent1.Periodic.zipperOuter (Agent1.Periodic.leftGuardDigits B w) (Agent1.Periodic.rightPeriodDigits B H w)
        (Agent1.Periodic.rightGuardDigits B H w) (Agent1.Periodic.rawGamma B H w) ∧
    Agent1.Periodic.rawPeriod B H w =
        Agent1.Periodic.zipperPeriod (Agent1.Periodic.leftPeriodDigits B w) (Agent1.Periodic.rightPeriodDigits B H w)
          (Agent1.Periodic.rawGamma B H w) ∧
      Agent1.Periodic.rawCenter B H w =
        Agent1.Periodic.zipperCenter (Agent1.Periodic.leftPeriodDigits B w) (Agent1.Periodic.centerGuardDigits B H w)
          (Agent1.Periodic.rightPeriodDigits B H w) (Agent1.Periodic.rawGamma B H w)
Agent1.Periodic.raw_guard_bounded (B H w : Agent8.Word) (k : Nat) (hB : Agent8.Bounded B 18) (hH : Agent8.Bounded H 18)
  (hw : Agent8.Bounded w 18) (hlen : List.length w = 4) (hk : 3 ≤ k) :
