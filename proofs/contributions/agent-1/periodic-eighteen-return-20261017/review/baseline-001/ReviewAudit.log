Agent1.Periodic.stripPeriodCenter_test_iff (w H : Agent8.Word) :
  H = w ++ Agent1.Periodic.stripPeriodMiddle w H ++ List.reverse w ↔
    2 * List.length w ≤ List.length H ∧
      List.take (List.length w) H = w ∧ List.drop (List.length H - List.length w) H = List.reverse w
Agent1.Periodic.stripPeriodCenter_empty (H : Agent8.Word) : Agent1.Periodic.stripPeriodCenter [] H = (H, 0)
Agent1.Periodic.stripPeriodCenterAux_decomposition (w H : Agent8.Word) (fuel : Nat) :
