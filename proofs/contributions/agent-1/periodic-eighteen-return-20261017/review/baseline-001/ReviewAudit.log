  (hw : Agent8.Bounded w 18) (hlen : List.length w = 4) :
  List.reverse (Agent1.Periodic.rawCenter B H w) = Agent1.Periodic.rawCenter B H w
Agent1.Periodic.raw_blocks_bounded (B H w : Agent8.Word) (hB : Agent8.Bounded B 18) (hH : Agent8.Bounded H 18)
  (hw : Agent8.Bounded w 18) :
  Agent8.Bounded (Agent1.Periodic.rawOuter B H w) 18 ∧
    Agent8.Bounded (Agent1.Periodic.rawPeriod B H w) 18 ∧ Agent8.Bounded (Agent1.Periodic.rawCenter B H w) 18
