Agent1.Periodic.zero_quotient_actual_step (B H : Agent8.Word) (k n : Nat) (d : Nat → Nat) (hB : Agent8.Bounded B 18)
  (hH : Agent8.Bounded H 18) (hk : 3 ≤ k)
  (hcan : DecimalDigits.Canonical n d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)))
  (hrep :
    ∀ (i : Nat),
      i < List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k) →
        DecimalDigits.columnSum d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)) i =
          (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)[i]?.getD 0) :
  let Q' :=
    Agent1.Periodic.periodicWord (Agent1.Periodic.quotientOuter B H [0, 0, 0, 0])
      (Agent1.Periodic.quotientCenter B H [0, 0, 0, 0]) [0, 0, 0, 0]
      (k - 2 + Agent1.Periodic.outerPeriods B H [0, 0, 0, 0] + Agent1.Periodic.centerPeriods B H [0, 0, 0, 0]);
  ∃ d',
    DecimalDigits.Canonical (Lychrel196.step n) d' (List.length Q') ∧
      ∀ (i : Nat), i < List.length Q' → DecimalDigits.columnSum d' (List.length Q') i = Q'[i]?.getD 0
Agent1.Periodic.periodicWord_admissible (B H w : Agent8.Word) (k : Nat) (hv : Agent1.Periodic.ValidPeriodic B H w)
  (hk : 0 < k) :
  FoldedDecimal.Admissible (List.length (Agent1.Periodic.periodicWord B H w k)) fun i =>
    (Agent1.Periodic.periodicWord B H w k)[i]?.getD 0
Agent1.Periodic.periodicWord_realizable (B H w : Agent8.Word) (k : Nat) (hv : Agent1.Periodic.ValidPeriodic B H w)
  (hk : 0 < k) :
  ∃ n d,
    0 < n ∧
      DecimalDigits.Canonical n d (List.length (Agent1.Periodic.periodicWord B H w k)) ∧
        ∀ (i : Nat),
          i < List.length (Agent1.Periodic.periodicWord B H w k) →
            DecimalDigits.columnSum d (List.length (Agent1.Periodic.periodicWord B H w k)) i =
              (Agent1.Periodic.periodicWord B H w k)[i]?.getD 0
Agent1.Periodic.quotient_path_guarded_step (B H w : Nat → Agent8.Word) (k : Nat → Nat) (N : Nat)
  (hp : Agent1.Periodic.QuotientPath B H w N) (hguard : ∀ (i : Nat), i < N → 3 ≤ k i)
  (hkstep :
    ∀ (i : Nat),
      i < N →
        k (i + 1) =
          k i - 2 + Agent1.Periodic.outerPeriods (B i) (H i) (w i) + Agent1.Periodic.centerPeriods (B i) (H i) (w i))
  (i : Nat) (hi : i < N) :
  Agent8.stepWord (Agent1.Periodic.quotientPathWord B H w k i) = Agent1.Periodic.quotientPathWord B H w k (i + 1)
Agent1.Periodic.quotient_path_actual_prefix (B H w : Nat → Agent8.Word) (k : Nat → Nat) (N : Nat)
  (hp : Agent1.Periodic.QuotientPath B H w N) (hguard : ∀ (i : Nat), i < N → 3 ≤ k i)
  (hkstep :
    ∀ (i : Nat),
      i < N →
        k (i + 1) =
          k i - 2 + Agent1.Periodic.outerPeriods (B i) (H i) (w i) + Agent1.Periodic.centerPeriods (B i) (H i) (w i))
  (n : Nat) (d : Nat → Nat)
  (hcan : DecimalDigits.Canonical n d (List.length (Agent1.Periodic.quotientPathWord B H w k 0)))
  (hrep :
    ∀ (j : Nat),
      j < List.length (Agent1.Periodic.quotientPathWord B H w k 0) →
        DecimalDigits.columnSum d (List.length (Agent1.Periodic.quotientPathWord B H w k 0)) j =
          (Agent1.Periodic.quotientPathWord B H w k 0)[j]?.getD 0)
  (t : Nat) :
  t ≤ N →
    0 < Lychrel196.orbit n t ∧
      ∃ d',
        DecimalDigits.Canonical (Lychrel196.orbit n t) d' (List.length (Agent1.Periodic.quotientPathWord B H w k t)) ∧
          ∀ (j : Nat),
            j < List.length (Agent1.Periodic.quotientPathWord B H w k t) →
              DecimalDigits.columnSum d' (List.length (Agent1.Periodic.quotientPathWord B H w k t)) j =
                (Agent1.Periodic.quotientPathWord B H w k t)[j]?.getD 0
Agent1.Periodic.quotientPathExponent_lower_bound (B H w : Nat → Agent8.Word) (N i : Nat) :
  i ≤ N → 2 * (N - i) + 3 ≤ Agent1.Periodic.quotientPathExponent B H w (2 * N + 3) i
Agent1.Periodic.quotient_path_finite_realizable (B H w : Nat → Agent8.Word) (N : Nat)
  (hp : Agent1.Periodic.QuotientPath B H w N) (hv : Agent1.Periodic.ValidPeriodic (B 0) (H 0) (w 0)) :
  let k := Agent1.Periodic.quotientPathExponent B H w (2 * N + 3);
  ∃ n,
    0 < n ∧
      ∀ (t : Nat),
        t ≤ N →
          ∃ d,
            DecimalDigits.Canonical (Lychrel196.orbit n t) d
                (List.length (Agent1.Periodic.quotientPathWord B H w k t)) ∧
              ∀ (j : Nat),
                j < List.length (Agent1.Periodic.quotientPathWord B H w k t) →
                  DecimalDigits.columnSum d (List.length (Agent1.Periodic.quotientPathWord B H w k t)) j =
                    (Agent1.Periodic.quotientPathWord B H w k t)[j]?.getD 0
Agent1.Periodic.mem_pow_iff (w : Agent8.Word) (k x : Nat) : x ∈ Agent1.RepeatedBlock.pow w k ↔ x ∈ w ∧ 0 < k
Agent1.Periodic.mem_periodicWord_iff (B H w : Agent8.Word) (k x : Nat) (hk : 0 < k) :
  x ∈ Agent1.Periodic.periodicWord B H w k ↔ x ∈ B ++ H ++ w
Agent1.Periodic.periodicWord_head (B H w : Agent8.Word) (k : Nat) (hk : 0 < k) (hw : w ≠ []) :
  List.headD (Agent1.Periodic.periodicWord B H w k) 0 = List.headD (B ++ w) 0
Agent1.Periodic.mem_stripped_alphabet_iff (B H w : Agent8.Word) (x : Nat) :
  x ∈ (Agent1.Periodic.stripPeriodSuffix w B).fst ++ (Agent1.Periodic.stripPeriodCenter w H).fst ++ w ↔ x ∈ B ++ H ++ w
Agent1.Periodic.outside_bounds (B H w : Agent8.Word) (hv : Agent1.Periodic.ValidPeriodic B H w) :
  0 < Agent1.Periodic.outside B w ∧ Agent1.Periodic.outside B w ≤ 18
Agent1.Periodic.quotient_outside_step (B H w : Agent8.Word) (hv : Agent1.Periodic.ValidPeriodic B H w) :
  let e := Agent8.lastInput (Agent1.Periodic.periodicWord B H w 3);
  e ≤ 1 ∧
    Agent1.Periodic.rawGamma B H w = Agent8.overflow (Agent1.Periodic.outside B w) e ∧
      Agent1.Periodic.outside (Agent1.Periodic.quotientOuter B H w) (Agent1.Periodic.rawPeriod B H w) =
        Agent8.nextExterior (Agent1.Periodic.outside B w) e
Agent1.Periodic.quotient_path_valid (B H w : Nat → Agent8.Word) (N : Nat) (hp : Agent1.Periodic.QuotientPath B H w N)
  (hv : Agent1.Periodic.ValidPeriodic (B 0) (H 0) (w 0)) (i : Nat) (hi : i ≤ N) :
  Agent1.Periodic.ValidPeriodic (B i) (H i) (w i)
Agent1.Periodic.quotient_path_closed_outside_clock_bounds (B H w : Nat → Agent8.Word) (N : Nat)
  (hp : Agent1.Periodic.QuotientPath B H w N) (hv : Agent1.Periodic.ValidPeriodic (B 0) (H 0) (w 0))
  (hclosed : Agent1.Periodic.outside (B N) (w N) = Agent1.Periodic.outside (B 0) (w 0)) :
  2 * Agent1.Periodic.quotientClockSum B H w N ≤ N ∧ N ≤ 4 * Agent1.Periodic.quotientClockSum B H w N
Agent1.Periodic.quotient_return_clock_gain (B H w : Nat → Agent8.Word) (N : Nat)
  (hp : Agent1.Periodic.QuotientPath B H w N) (hv : Agent1.Periodic.ValidPeriodic (B 0) (H 0) (w 0)) (hN : 0 < N)
  (hreturn : B N = B 0 ∧ H N = H 0 ∧ w N = w 0) :
  ∃ G,
    0 < G ∧
      Agent1.Periodic.quotientClockSum B H w N = 8 * G ∧
        Agent1.Periodic.quotientDeltaSum B H w N = ↑G ∧ 16 * G ≤ N ∧ N ≤ 32 * G
Agent1.Periodic.quotient_return_length_ge_sixteen (B H w : Nat → Agent8.Word) (N : Nat)
  (hp : Agent1.Periodic.QuotientPath B H w N) (hv : Agent1.Periodic.ValidPeriodic (B 0) (H 0) (w 0)) (hN : 0 < N)
  (hreturn : B N = B 0 ∧ H N = H 0 ∧ w N = w 0) : 16 ≤ N
Agent1.Periodic.quotientPathExponent_accounting (B H w : Nat → Agent8.Word) (k0 N : Nat)
  (hguard : ∀ (i : Nat), i < N → 3 ≤ Agent1.Periodic.quotientPathExponent B H w k0 i) :
  ↑(Agent1.Periodic.quotientPathExponent B H w k0 N) = ↑k0 + Agent1.Periodic.quotientDeltaSum B H w N
Agent1.Periodic.quotientCycleExponent_guarded (B H w : Nat → Agent8.Word) (N G : Nat) (hN : 0 < N) (t : Nat) :
  3 ≤ Agent1.Periodic.quotientCycleExponent B H w N G t
Agent1.Periodic.quotientCycleExponent_step (B H w : Nat → Agent8.Word) (N G : Nat) (hN : 0 < N)
  (hend : Agent1.Periodic.quotientPathExponent B H w (2 * N + 3) N = 2 * N + 3 + G) (t : Nat) :
  Agent1.Periodic.quotientCycleExponent B H w N G (t + 1) =
    Agent1.Periodic.quotientCycleExponent B H w N G t - 2 +
        Agent1.Periodic.outerPeriods (B (t % N)) (H (t % N)) (w (t % N)) +
      Agent1.Periodic.centerPeriods (B (t % N)) (H (t % N)) (w (t % N))
Agent1.Periodic.quotient_return_guarded_schedule (B H w : Nat → Agent8.Word) (N : Nat)
  (hp : Agent1.Periodic.QuotientPath B H w N) (hv : Agent1.Periodic.ValidPeriodic (B 0) (H 0) (w 0)) (hN : 0 < N)
  (hreturn : B N = B 0 ∧ H N = H 0 ∧ w N = w 0) :
  ∃ k,
    k 0 = 2 * N + 3 ∧
      (∀ (t : Nat), 3 ≤ k t) ∧
        ∀ (t : Nat),
          k (t + 1) =
            k t - 2 + Agent1.Periodic.outerPeriods (B (t % N)) (H (t % N)) (w (t % N)) +
              Agent1.Periodic.centerPeriods (B (t % N)) (H (t % N)) (w (t % N))
