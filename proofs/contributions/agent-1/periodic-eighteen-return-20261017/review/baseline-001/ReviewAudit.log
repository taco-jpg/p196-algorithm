Agent1.Periodic.raw_guard_of_stripped (B H w B' H' : Agent8.Word) (u v k : Nat) (hB : Agent8.Bounded B 18)
  (hH : Agent8.Bounded H 18) (hw : Agent8.Bounded w 18) (hlen : List.length w = 4) (hk : 3 ≤ k)
  (ho : Agent1.Periodic.rawOuter B H w = B' ++ Agent1.RepeatedBlock.pow (Agent1.Periodic.rawPeriod B H w) u)
  (hc :
    Agent1.Periodic.rawCenter B H w =
      Agent1.RepeatedBlock.pow (Agent1.Periodic.rawPeriod B H w) v ++ H' ++
        Agent1.RepeatedBlock.pow (List.reverse (Agent1.Periodic.rawPeriod B H w)) v) :
  Agent8.stepWord (Agent1.Periodic.periodicWord B H w k) =
    Agent1.Periodic.periodicWord B' H' (Agent1.Periodic.rawPeriod B H w) (k - 2 + u + v)
Agent1.Periodic.stripped_width_balance (B H w B' H' : Agent8.Word) (u v : Nat) (hB : Agent8.Bounded B 18)
  (hH : Agent8.Bounded H 18) (hw : Agent8.Bounded w 18) (hlen : List.length w = 4)
  (ho : Agent1.Periodic.rawOuter B H w = B' ++ Agent1.RepeatedBlock.pow (Agent1.Periodic.rawPeriod B H w) u)
  (hc :
    Agent1.Periodic.rawCenter B H w =
      Agent1.RepeatedBlock.pow (Agent1.Periodic.rawPeriod B H w) v ++ H' ++
        Agent1.RepeatedBlock.pow (List.reverse (Agent1.Periodic.rawPeriod B H w)) v) :
  2 * ↑(List.length B') + ↑(List.length H') + 8 * (↑u + ↑v - 2) =
    2 * ↑(List.length B) + ↑(List.length H) + ↑(Agent1.Periodic.rawGamma B H w)
Agent1.Periodic.quotient_step_bounded (B H w : Agent8.Word) (k : Nat) (hB : Agent8.Bounded B 18)
