Agent1.Periodic.stripPeriodSuffix_empty_block (B : Agent8.Word) : Agent1.Periodic.stripPeriodSuffix [] B = (B, 0)
Agent1.Periodic.stripPeriodSuffix_length (w B : Agent8.Word) (hw : w ≠ []) :
  List.length B =
