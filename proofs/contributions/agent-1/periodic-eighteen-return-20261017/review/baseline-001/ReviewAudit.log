Agent1.Periodic.periodicWord_absorb (B H w : Agent8.Word) (u v k : Nat) :
  Agent1.Periodic.periodicWord (B ++ Agent1.RepeatedBlock.pow w u)
      (Agent1.RepeatedBlock.pow w v ++ H ++ Agent1.RepeatedBlock.pow (List.reverse w) v) w k =
