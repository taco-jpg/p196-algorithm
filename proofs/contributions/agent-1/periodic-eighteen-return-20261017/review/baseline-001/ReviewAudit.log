        Agent1.Periodic.quotientCenter B H w =
          Agent1.Periodic.rawPeriod B H w ++ K ++ List.reverse (Agent1.Periodic.rawPeriod B H w)
Agent1.Periodic.quotient_width_balance (B H w : Agent8.Word) (hB : Agent8.Bounded B 18) (hH : Agent8.Bounded H 18)
  (hw : Agent8.Bounded w 18) (hlen : List.length w = 4) :
  2 * ↑(List.length (Agent1.Periodic.quotientOuter B H w)) + ↑(List.length (Agent1.Periodic.quotientCenter B H w)) +
      8 * Agent1.Periodic.exponentDelta B H w =
    2 * ↑(List.length B) + ↑(List.length H) + ↑(Agent1.Periodic.rawGamma B H w)
Agent1.Periodic.quotient_exponent_accounting (B H w : Agent8.Word) (k : Nat) (hk : 3 ≤ k) :
  1 ≤ k - 2 + Agent1.Periodic.outerPeriods B H w + Agent1.Periodic.centerPeriods B H w ∧
    ↑(k - 2 + Agent1.Periodic.outerPeriods B H w + Agent1.Periodic.centerPeriods B H w) =
      ↑k + Agent1.Periodic.exponentDelta B H w
Agent1.Periodic.quotient_path_width_balance (B H w : Nat → Agent8.Word) (N : Nat)
  (hp : Agent1.Periodic.QuotientPath B H w N) :
  ↑(2 * List.length (B N) + List.length (H N)) + 8 * Agent1.Periodic.quotientDeltaSum B H w N =
    ↑(2 * List.length (B 0) + List.length (H 0)) + ↑(Agent1.Periodic.quotientClockSum B H w N)
Agent1.Periodic.quotient_path_equal_width_clock (B H w : Nat → Agent8.Word) (N : Nat)
  (hp : Agent1.Periodic.QuotientPath B H w N)
  (hwidth : 2 * List.length (B N) + List.length (H N) = 2 * List.length (B 0) + List.length (H 0)) :
  8 * Agent1.Periodic.quotientDeltaSum B H w N = ↑(Agent1.Periodic.quotientClockSum B H w N) ∧
    8 ∣ Agent1.Periodic.quotientClockSum B H w N ∧
      Agent1.Periodic.quotientDeltaSum B H w N = ↑(Agent1.Periodic.quotientClockSum B H w N / 8)
