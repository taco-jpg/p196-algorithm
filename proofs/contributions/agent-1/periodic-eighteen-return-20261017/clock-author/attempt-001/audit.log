Agent1.Periodic.periodicWord_carry_eq_rawGamma (B H w : Agent8.Word) (k : Nat) (hB : Agent8.Bounded B 18)
  (hH : Agent8.Bounded H 18) (hw : Agent8.Bounded w 18) (hk : 0 < k) :
  DecimalDigits.carry (fun j => (Agent1.Periodic.periodicWord B H w k)[j]?.getD 0)
