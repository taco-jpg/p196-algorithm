theorem Agent1.Periodic.zeroExponent_guarded_prefix : ∀ (s : Agent1.Periodic.ZeroState),
  Agent1.Periodic.ValidPeriodic s.fst s.snd [0, 0, 0, 0] →
    ∀ (M N : Nat),
      (∀ (t : Nat),
          t ≤ N →
            2 * List.length (Agent1.Periodic.zeroStateOrbit s t).fst +
                List.length (Agent1.Periodic.zeroStateOrbit s t).snd ≤
              M) →
        ∀ (t : Nat),
          t ≤ N →
            3 ≤ Agent1.Periodic.zeroExponent s (M + 3) t ∧
              M + 24 ≤
                2 * List.length (Agent1.Periodic.zeroStateOrbit s t).fst +
                    List.length (Agent1.Periodic.zeroStateOrbit s t).snd +
                  8 * Agent1.Periodic.zeroExponent s (M + 3) t :=
fun s hv M N hbound t ht =>
  Nat.recAux (motive := fun t =>
    t ≤ N →
      3 ≤ Agent1.Periodic.zeroExponent s (M + 3) t ∧
        M + 24 ≤
          2 * List.length (Agent1.Periodic.zeroStateOrbit s t).fst +
              List.length (Agent1.Periodic.zeroStateOrbit s t).snd +
            8 * Agent1.Periodic.zeroExponent s (M + 3) t)
    (fun ht => id (Decidable.byContradiction fun a => Agent1.Periodic.zeroExponent_guarded_prefix._proof_1 s M N a))
    (fun t ih ht =>
      let_fun hprev :=
        ih (Decidable.byContradiction fun a => Agent1.Periodic.zeroExponent_guarded_prefix._proof_2 N t ht a);
      let_fun hw :=
        Agent1.Periodic.zero_width_step (Agent1.Periodic.zeroStateOrbit s t) (Agent1.Periodic.zeroExponent s (M + 3) t)
          (Agent1.Periodic.zeroStateOrbit_valid s hv t) hprev.left;
      let_fun hnext := hbound (t + 1) ht;
      id
        (id
          ⟨Decidable.byContradiction fun a =>
              Agent1.Periodic.zeroExponent_guarded_prefix._proof_3 s M N t hprev hw hnext a,
            Decidable.byContradiction fun a =>
              Agent1.Periodic.zeroExponent_guarded_prefix._proof_4 s M N t hprev hw a⟩))
    t ht
theorem Agent1.Periodic.zeroLiftWord_step_prefix : ∀ (s : Agent1.Periodic.ZeroState),
  Agent1.Periodic.ValidPeriodic s.fst s.snd [0, 0, 0, 0] →
    ∀ (M N : Nat),
      (∀ (t : Nat),
          t ≤ N →
            2 * List.length (Agent1.Periodic.zeroStateOrbit s t).fst +
                List.length (Agent1.Periodic.zeroStateOrbit s t).snd ≤
              M) →
        ∀ (t : Nat),
          t < N →
            Agent8.stepWord (Agent1.Periodic.zeroLiftWord s (M + 3) t) =
              Agent1.Periodic.zeroLiftWord s (M + 3) (t + 1) :=
fun s hv M N hbound t ht =>
  let_fun hv' := Agent1.Periodic.zeroStateOrbit_valid s hv t;
  let_fun hk :=
    (Agent1.Periodic.zeroExponent_guarded_prefix s hv M N hbound t
        (Decidable.byContradiction fun a => Agent1.Periodic.zeroLiftWord_step_prefix._proof_5 N t ht a)).left;
  let_fun hs :=
    Agent1.Periodic.quotient_step_bounded (Agent1.Periodic.zeroStateOrbit s t).fst
      (Agent1.Periodic.zeroStateOrbit s t).snd [0, 0, 0, 0] (Agent1.Periodic.zeroExponent s (M + 3) t) hv'.outer_bounded
      hv'.center_bounded hv'.period_bounded hv'.period_length hk;
  id
    (Eq.mp
      (congrArg
        (fun _a =>
          Agent8.stepWord
              (Agent1.Periodic.periodicWord (Agent1.Periodic.zeroStateOrbit s t).fst
                (Agent1.Periodic.zeroStateOrbit s t).snd [0, 0, 0, 0] (Agent1.Periodic.zeroExponent s (M + 3) t)) =
            Agent1.Periodic.periodicWord
              (Agent1.Periodic.quotientOuter (Agent1.Periodic.zeroStateOrbit s t).fst
                (Agent1.Periodic.zeroStateOrbit s t).snd [0, 0, 0, 0])
              (Agent1.Periodic.quotientCenter (Agent1.Periodic.zeroStateOrbit s t).fst
                (Agent1.Periodic.zeroStateOrbit s t).snd [0, 0, 0, 0])
              _a
              (Agent1.Periodic.zeroExponent s (M + 3) t - 2 +
                  Agent1.Periodic.outerPeriods (Agent1.Periodic.zeroStateOrbit s t).fst
                    (Agent1.Periodic.zeroStateOrbit s t).snd [0, 0, 0, 0] +
                Agent1.Periodic.centerPeriods (Agent1.Periodic.zeroStateOrbit s t).fst
                  (Agent1.Periodic.zeroStateOrbit s t).snd [0, 0, 0, 0]))
        (Agent1.Periodic.rawPeriod_zero (Agent1.Periodic.zeroStateOrbit s t).fst
          (Agent1.Periodic.zeroStateOrbit s t).snd hv'.outer_bounded hv'.center_bounded))
      hs)
