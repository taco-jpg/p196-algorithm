theorem Agent1.Periodic.quotient_return_initial_outside : ∀ (B H w : Nat → Agent8.Word) (N : Nat),
  Agent1.Periodic.QuotientPath B H w N →
    Agent1.Periodic.ValidPeriodic (B 0) (H 0) (w 0) →
      w 0 = [14, 14, 4, 4] →
        0 < N →
          B N = B 0 ∧ H N = H 0 ∧ w N = w 0 →
            Agent1.Periodic.outside (B 0) (w 0) = 9 ∨ Agent1.Periodic.outside (B 0) (w 0) = 10 :=
fun B H w N hp hv hphase hN hreturn =>
  let_fun hb := Agent1.Periodic.outside_bounds (B 0) (H 0) (w 0) hv;
  let_fun hfinite :=
    Decidable.byContradiction fun a => Agent1.Periodic.quotient_return_initial_outside._proof_6 B w N hb a;
  let_fun hmem :=
    let_fun hi := Agent1.Periodic.outerCatalog_initial ⟨Agent1.Periodic.outside (B 0) (w 0), hfinite⟩ hb.left;
    Eq.mpr
      (id
        (congrArg (Membership.mem Agent1.Periodic.outerCatalog)
          (congr (congrArg Prod.mk hphase) (congrArg (Agent1.Periodic.outside (B 0)) hphase))))
      (Eq.mp
        (congrArg (fun x => ([14, 14, 4, 4], Agent1.Periodic.outside (B 0) x) ∈ Agent1.Periodic.outerCatalog) hphase)
        hi);
  Exists.casesOn (Agent1.Periodic.quotient_return_core B H w N hp hv hmem hN hreturn) fun c h =>
    And.casesOn h fun hc hall =>
      let_fun hc0 := (hall 0 (Nat.zero_le N)).right;
      Agent1.Periodic.outerComponent_initial_core (w 0, Agent1.Periodic.outside (B 0) (w 0)) hmem hphase
        (Eq.mpr (id (congrArg (fun _a => _a ∈ [8, 129, 130]) hc0)) hc)
