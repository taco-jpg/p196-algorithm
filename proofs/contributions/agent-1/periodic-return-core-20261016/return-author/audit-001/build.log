                      (Eq.trans _proof_4✝
                        (congrArg (Or (Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) = 129))
                          (Eq.trans _proof_4✝
                            (Eq.trans
                              (congrArg
                                (Or (Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) = 130))
                                _proof_5✝)
                              (or_false
                                (Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) =
                                  130)))))))))
                (Or.casesOn
                  (Eq.mp
                    (Eq.trans _proof_4✝
                      (congrArg (Or (Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) = 8))
                        (Eq.trans _proof_4✝
                          (congrArg
                            (Or (Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) = 129))
                            (Eq.trans _proof_4✝
                              (congrArg
                                (Or (Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) = 130))
                                (Eq.trans _proof_4✝
                                  (Eq.trans
                                    (congrArg
                                      (Or
                                        (Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) =
                                          131))
                                      _proof_5✝)
                                    (or_false
                                      (Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) =
                                        131))))))))))
                    (Eq.mp (congrArg (fun _a => Agent1.Periodic.outerComponent _a ∈ [8, 129, 130, 131]) hs) hfour))
                  (fun h8 => Or.inl h8) fun h =>
                  Or.casesOn h (fun h129 => Or.inr (Or.inl h129)) fun h =>
