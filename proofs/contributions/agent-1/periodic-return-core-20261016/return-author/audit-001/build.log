theorem Agent1.Periodic.quotient_return_component_constant : ∀ (B H w : Nat → Agent8.Word) (N : Nat),
  Agent1.Periodic.QuotientPath B H w N →
    Agent1.Periodic.ValidPeriodic (B 0) (H 0) (w 0) →
      (w 0, Agent1.Periodic.outside (B 0) (w 0)) ∈ Agent1.Periodic.outerCatalog →
        B N = B 0 ∧ H N = H 0 ∧ w N = w 0 →
          ∀ (i : Nat),
            i ≤ N →
              Agent1.Periodic.outerComponent (w i, Agent1.Periodic.outside (B i) (w i)) =
                Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) :=
fun B H w N hp hv hmem hreturn =>
  let component := fun i => Agent1.Periodic.outerComponent (w i, Agent1.Periodic.outside (B i) (w i));
  let_fun hcert :=
    ⟨fun i a => id (Agent1.Periodic.componentRank_pos (component i)), fun i hi hne =>
      Exists.casesOn
        (Agent1.Periodic.quotient_path_outer_edge B H w N hp hv hmem i
          (Decidable.byContradiction fun a => Agent1.Periodic.quotient_return_component_constant._proof_1 N i hi a))
        fun e h =>
        And.casesOn h fun he right =>
          And.casesOn right fun hs right =>
            And.casesOn right fun left right =>
              And.casesOn right fun left ht =>
                let_fun hne' :=
                  Eq.mpr
                    (id
                      (congrArg (fun _a => Agent1.Periodic.outerComponent _a ≠ Agent1.Periodic.outerComponent e.target)
                        hs))
                    (Eq.mpr
                      (id
                        (congrArg
                          (fun _a =>
                            Agent1.Periodic.outerComponent (w i, Agent1.Periodic.outside (B i) (w i)) ≠
                              Agent1.Periodic.outerComponent _a)
                          ht))
                      hne);
                let_fun hd := Agent1.Periodic.outerEdge_rank_drop e he hne';
                id
                  (Eq.mp
                    (congr
                      (congrArg (fun x => LE.le (1 + Agent1.Periodic.componentRank (Agent1.Periodic.outerComponent x)))
                        ht)
                      (congrArg (fun x => Agent1.Periodic.componentRank (Agent1.Periodic.outerComponent x)) hs))
                    hd)⟩;
  let_fun hclose :=
    id
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) =
                Agent1.Periodic.outerComponent (w N, Agent1.Periodic.outside _a (w N)))
            hreturn.left))
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0)) =
                  Agent1.Periodic.outerComponent (_a, Agent1.Periodic.outside (B 0) _a))
              hreturn.right.right))
          (Eq.refl (Agent1.Periodic.outerComponent (w 0, Agent1.Periodic.outside (B 0) (w 0))))));
  let_fun hinter :=
    CondensationBound.component_interval component (fun x => 1) Agent1.Periodic.componentRank (N + 1) 0 N hcert
      (fun x x => Nat.zero_lt_one) (Nat.zero_le N)
      (Decidable.byContradiction fun a => Agent1.Periodic.quotient_return_component_constant._proof_2 B w N a) hclose;
  fun i hi => hinter i (Nat.zero_le i) hi
theorem Agent1.Periodic.quotient_return_core : ∀ (B H w : Nat → Agent8.Word) (N : Nat),
