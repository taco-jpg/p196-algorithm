Agent11HighBase.numeric_two_step_threshold (b : Int) (digits : List Int) (hb : 3 ≤ b)
  (hd : ReverseAdd.DigitBounds b digits) (hp : PhysicalWidth.PositiveLast digits)
  (hh : ∀ (x : Int), x ∈ ReverseAdd.pairs digits → b - 1 ≤ x ∧ x ≤ 2 * b - 2)
  (ho : b ≤ (ReverseAdd.pairs digits).headD 0) :
  let first := Agent11HighBase.ordinaryStep b digits;
  let second := Agent11HighBase.ordinaryStep b first;
  ReverseAdd.DigitBounds b first ∧
    PhysicalWidth.PositiveLast first ∧
      ReverseAdd.DigitBounds b second ∧
        PhysicalWidth.PositiveLast second ∧
          SignedDigitUniqueness.eval b first =
              SignedDigitUniqueness.eval b digits + SignedDigitUniqueness.eval b digits.reverse ∧
            SignedDigitUniqueness.eval b second =
                SignedDigitUniqueness.eval b first + SignedDigitUniqueness.eval b first.reverse ∧
              (second.reverse = second ↔
                ∀ (i : Nat) (h : i + 1 < (ReverseAdd.pairs digits).length),
                  (ReverseAdd.pairs digits)[i] + (ReverseAdd.pairs digits)[i + 1] ≤ 3 * b - 3)
Agent11HighBase.numeric_interval_first_hit (b : Int) (digits : List Int) (hb : 3 ≤ b)
  (hd : ReverseAdd.DigitBounds b digits) (hp : PhysicalWidth.PositiveLast digits)
  (hh : ∀ (x : Int), x ∈ ReverseAdd.pairs digits → b - 1 ≤ x ∧ x ≤ b + (b - 1) / 2 - 1)
  (ho : b ≤ (ReverseAdd.pairs digits).headD 0) :
  (∀ (t : Nat),
      ReverseAdd.DigitBounds b (Agent11HighBase.digitOrbit b digits t) ∧
        PhysicalWidth.PositiveLast (Agent11HighBase.digitOrbit b digits t) ∧
          0 < SignedDigitUniqueness.eval b (Agent11HighBase.digitOrbit b digits t) ∧
            SignedDigitUniqueness.eval b (Agent11HighBase.digitOrbit b digits (t + 1)) =
              SignedDigitUniqueness.eval b (Agent11HighBase.digitOrbit b digits t) +
                SignedDigitUniqueness.eval b (Agent11HighBase.digitOrbit b digits t).reverse) ∧
    (Agent11HighBase.FirstPositivePalindrome b digits 1 ↔ ∀ (x : Int), x ∈ ReverseAdd.pairs digits → x = b + 1) ∧
      (Agent11HighBase.FirstPositivePalindrome b digits 2 ↔ ¬∀ (x : Int), x ∈ ReverseAdd.pairs digits → x = b + 1) ∧
        (Agent11HighBase.FirstPositivePalindrome b digits 1 ∨ Agent11HighBase.FirstPositivePalindrome b digits 2)
Agent11HighBase.binary_threshold_counterexample :
  ReverseAdd.DigitBounds 2 [1, 1, 1] ∧
