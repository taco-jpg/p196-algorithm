                Agent11HighBase.ordinaryStep 2 (Agent11HighBase.ordinaryStep 2 [1, 1, 1]) ∧
              ¬∀ (s : Int), s ∈ Agent11HighBase.adjacent (ReverseAdd.pairs [1, 1, 1]) → s ≤ 3 * 2 - 3
