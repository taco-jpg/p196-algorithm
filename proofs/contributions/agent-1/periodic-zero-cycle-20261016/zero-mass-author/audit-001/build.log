theorem Agent1.Periodic.zero_period_wordSum : ∀ (B H : Agent8.Word) (k : Nat),
  DecimalMass.wordSum (fun i => (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)[i]?.getD 0)
      (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)) =
    2 * List.sum B + List.sum H :=
fun B H k =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a = 2 * List.sum B + List.sum H)
        (Agent1.Periodic.wordSum_list✝ (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k))))
    (let_fun hz := rfl;
    Eq.mpr
      (id
        (congrArg (fun x => x = 2 * List.sum B + List.sum H)
          (Eq.trans
            (Eq.trans
              (congrArg
                (fun x =>
                  List.sum
                    (B ++ Agent1.RepeatedBlock.pow [0, 0, 0, 0] k ++ H ++ Agent1.RepeatedBlock.pow x k ++
                      List.reverse B))
                hz)
              (Agent1.Periodic.sum_append✝
                (B ++ Agent1.RepeatedBlock.pow [0, 0, 0, 0] k ++ H ++ Agent1.RepeatedBlock.pow [0, 0, 0, 0] k)
                (List.reverse B)))
            (congr
              (congrArg HAdd.hAdd
                (Eq.trans
                  (Agent1.Periodic.sum_append✝ (B ++ Agent1.RepeatedBlock.pow [0, 0, 0, 0] k ++ H)
                    (Agent1.RepeatedBlock.pow [0, 0, 0, 0] k))
                  (congr
                    (congrArg HAdd.hAdd
                      (Eq.trans (Agent1.Periodic.sum_append✝ (B ++ Agent1.RepeatedBlock.pow [0, 0, 0, 0] k) H)
                        (congrArg (fun x => x + List.sum H)
                          (Eq.trans (Agent1.Periodic.sum_append✝ B (Agent1.RepeatedBlock.pow [0, 0, 0, 0] k))
                            (congrArg (HAdd.hAdd (List.sum B)) (Agent1.Periodic.pow_zero_sum✝ k))))))
                    (Agent1.Periodic.pow_zero_sum✝ k))))
              (Agent1.Periodic.sum_reverse✝ B)))))
      (Decidable.byContradiction fun a => Agent1.Periodic.zero_period_wordSum._proof_2 B H a))
theorem Agent1.Periodic.zero_period_digitSum : ∀ (B H : Agent8.Word) (k n : Nat) (d : Nat → Nat),
  DecimalDigits.Canonical n d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)) →
    (∀ (i : Nat),
        i < List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k) →
          DecimalDigits.columnSum d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)) i =
            (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)[i]?.getD 0) →
      2 * DecimalMass.digitSum n = 2 * List.sum B + List.sum H :=
fun B H k n d hc hrep =>
  trans
    (trans
      (trans
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                2 * DecimalMass.digitSum _a =
                  2 * DecimalMass.wordSum d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)))
              (Eq.symm hc.right.right.right)))
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  2 * _a = 2 * DecimalMass.wordSum d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)))
                (DecimalMass.digitSum_value d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k))
                  hc.right.left)))
            (Eq.refl (2 * DecimalMass.wordSum d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k))))))
        (Eq.symm (DecimalMass.wordSum_columns d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)))))
      (DecimalMass.wordSum_congr
        (DecimalDigits.columnSum d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)))
        (fun i => (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)[i]?.getD 0)
        (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)) hrep))
    (Agent1.Periodic.zero_period_wordSum B H k)
theorem Agent1.Periodic.zero_period_digitSum_le : ∀ (B H : Agent8.Word) (k n : Nat) (d : Nat → Nat) (M : Nat),
  DecimalDigits.Canonical n d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)) →
    (∀ (i : Nat),
        i < List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k) →
          DecimalDigits.columnSum d (List.length (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)) i =
            (Agent1.Periodic.periodicWord B H [0, 0, 0, 0] k)[i]?.getD 0) →
      2 * List.sum B + List.sum H ≤ M → DecimalMass.digitSum n ≤ M :=
fun B H k n d M hc hrep hmass =>
  let_fun hm := Agent1.Periodic.zero_period_digitSum B H k n d hc hrep;
  Decidable.byContradiction fun a => Agent1.Periodic.zero_period_digitSum_le._proof_3 B H n M hmass hm a
