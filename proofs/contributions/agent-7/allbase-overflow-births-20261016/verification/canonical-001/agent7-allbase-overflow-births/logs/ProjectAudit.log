P196.Agent7.AllBaseOverflow.canonical_reverse_add_overflow_theorem (b : Int) (digits : List Int)
  (xs : List (Int × Bool)) (hb : 2 ≤ b) (hd : ReverseAdd.DigitBounds b digits) (hp : PhysicalWidth.PositiveLast digits)
  (hqs : List.map Prod.fst xs = ReverseAdd.pairs digits)
