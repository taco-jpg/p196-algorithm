    PhysicalWidth.PositiveLast output ∧
      output.length = digits.length + 1 ∧
        SignedDigitUniqueness.eval b output = SignedDigitUniqueness.eval b digits + ReverseAdd.reversedValue b digits ∧
          (Q.getD 0 0 = 1 + q0 % b ∧ Q.getD xs.length 0 = 1 + q0 % b) ∧
            (0 < Q.getD 0 0 ∧ 0 < Q.getD xs.length 0) ∧
              ((Q.getD 0 0 = 2 * b - 2 ↔ b = 2 ∧ q0 = 1) ∧ (Q.getD xs.length 0 = 2 * b - 2 ↔ b = 2 ∧ q0 = 1)) ∧
                ∀ (i : Nat) (hi0 : 0 < i) (hi : i < xs.length),
                  let a := xs[i - 1].fst;
                  let z := xs[i].fst;
                  let u := ActualBaseBirths.incoming b xs i;
                  let v := ActualBaseBirths.incoming b xs (xs.length - i);
                  (Q.getD i 0 = 0 ↔
                      a = 0 ∧ z = 0 ∨
                        a = b - 1 ∧ z = b - 1 ∧ u = 1 ∧ v = 1 ∨ a = b - 1 ∧ z = b ∧ u = 0 ∨ a = b ∧ z = b - 1 ∧ v = 0) ∧
                    (Q.getD i 0 = 2 * b - 2 ↔
                        a = 2 * b - 2 ∧ z = 2 * b - 2 ∨
                          a = b - 1 ∧ z = b - 1 ∧ u = 0 ∧ v = 0 ∨
                            a = b - 1 ∧ z = b - 2 ∧ u = 1 ∨ a = b - 2 ∧ z = b - 1 ∧ v = 1) ∧
                      (Q.getD i 0 = 0 ∧ ¬(a = 0 ∧ z = 0) ∨ Q.getD i 0 = 2 * b - 2 ∧ ¬(a = 2 * b - 2 ∧ z = 2 * b - 2) →
                        a = b - 1 ∨ z = b - 1)
