theorem initialShortChecked : checkInitial ranks 38 [7,3,9,9,3,7] = true := by decide +kernel
theorem initialDigitsChecked {a b c d : Nat} (ha : a < 10) (hb : b < 10) (hc : c < 10) (hd : d < 10) : checkInitial ranks 38 [7,3,9,a,b,c,d] = true := by
  have h := initialLongChecked _ (initialWord_index_lt ha hb hc hd)
