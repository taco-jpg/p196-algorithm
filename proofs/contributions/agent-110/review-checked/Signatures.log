Agent112.Admissibility.automatic_admissibility : ∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = Bool.true → ∃ H M, Agent109.Cert.Admissible0 cert H M
Agent110.Checked.period_at_least_four : ∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = Bool.true → 4 ≤ cert.P
Agent110.Checked.six_phase_constraints : ∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = Bool.true →
    Agent2Exterior.SixPhase (cert.st 0).c →
      Agent110.Accounting.totalGam cert = 2 * (Agent110.Accounting.totalG cert + Agent110.Accounting.totalH cert) ∧
        0 ≤ Agent110.Accounting.totalG cert ∧
          0 ≤ Agent110.Accounting.totalH cert ∧
            Agent110.Accounting.totalG cert % 9 = 0 ∧
              Agent110.Accounting.totalH cert % 9 = 0 ∧
                Agent110.Accounting.totalGam cert % 18 = 0 ∧
                  18 ≤ Agent110.Accounting.totalGam cert ∧
                    2 * Agent110.Accounting.totalGam cert ≤ ↑cert.P ∧
                      ↑cert.P ≤ 4 * Agent110.Accounting.totalGam cert ∧ cert.P % 6 = 0 ∧ 42 ≤ cert.P
Agent110.Checked.saturated_period_constraints : ∀ (cert : Agent109.Cert.Certificate),
  Agent109.Cert.check cert = Bool.true →
    Agent2Exterior.SixPhase (cert.st 0).c →
      2 * Agent110.Accounting.totalGam cert = ↑cert.P → cert.P % 72 = 0 ∧ 72 ≤ cert.P
