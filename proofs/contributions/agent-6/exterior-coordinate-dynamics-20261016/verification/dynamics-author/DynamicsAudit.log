Agent6.ExteriorCoordinates.betaNum_eq (c : Nat) (B : List Nat) :
  Agent6.ExteriorCoordinates.betaNum c B = 9 * ↑(Agent115.ExteriorFactorization.lowValue B) - ↑c * 10 ^ B.length
'Agent6.ExteriorCoordinates.betaNum_eq' depends on axioms: [propext, Quot.sound]
Agent6.ExteriorCoordinates.betaNum_outerNext_raw (c : Nat) (B : List Nat) :
  Agent6.ExteriorCoordinates.betaNum (P196.Agent7.Finite.outerNext { c := c, B := B }).c
      (P196.Agent7.Finite.outerNext { c := c, B := B }).B =
    9 * ↑(Agent115.ExteriorFactorization.lowValue (Agent115.ExteriorFactorization.rawSucc c B)) -
      ↑(2 * (c - 9 * if 10 ≤ c then 1 else 0)) * 10 ^ (B.length + 1)
'Agent6.ExteriorCoordinates.betaNum_outerNext_raw' depends on axioms: [propext, Quot.sound]
Agent6.ExteriorCoordinates.betaNum_outerNext (c : Nat) (B : List Nat) :
  Agent6.ExteriorCoordinates.betaNum (P196.Agent7.Finite.outerNext { c := c, B := B }).c
      (P196.Agent7.Finite.outerNext { c := c, B := B }).B =
    Agent6.ExteriorCoordinates.betaNum c B + Agent6.ExteriorCoordinates.highContribution c B
'Agent6.ExteriorCoordinates.betaNum_outerNext' depends on axioms: [propext, Classical.choice, Quot.sound]
