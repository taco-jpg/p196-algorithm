import ActualHighReturn
import LocalHigh

/-! An exact criterion for an actual two-step return to the high region.
The reflection width and the carries are those of the actual first
successor. Width one and overlapping reflected positions are included. -/

namespace Agent105.ReturnCriterion

open DecimalDigits FoldedDecimal OverflowCarryNormalization HighCarryReduction
  Agent105.HighReturnPrefix Agent105.ActualHighReturn Agent105.LocalHigh

/-- Under actual second-step nonoverflow, the exterior has this formula
at every positive initial width, including width one. -/
theorem second_outer_formula (q : Nat → Nat) (L : Nat)
    (ha : Admissible L q) (hq : HighCarryWord q L)
    (hc : carry (nextColumns q L) (L + 1) = 0) :
    nextColumns (nextColumns q L) (L + 1) 0 =
      2 * (q 0 - 9) + carry (nextColumns q L) L := by
  have hp := first_admissible q L ha hq
  have hp0 := nextColumns_zero q L ha.1 hq
  have hpL := nextColumns_last q L ha.1 hq
  have ha9 : q 0 - 9 < 10 := by
    have hb := hq.1 0 ha.1
    omega
  have hsum : q 0 - 9 + carry (nextColumns q L) L < 10 := by
    have hdiv : (nextColumns q L L + carry (nextColumns q L) L) / 10 = 0 := hc
    rw [hpL] at hdiv
    omega
  rw [folded_emission_no_overflow _ _ 0 (by omega) hp.2.2.2.1 hc]
  simp only [hp0, carry, Nat.add_zero, Nat.add_sub_cancel, Nat.sub_zero,
    Nat.mod_eq_of_lt ha9, Nat.mod_eq_of_lt hsum]
  omega

/-- The strengthened high-region exterior condition is exactly the
original exterior threshold fourteen, once second overflow is excluded. -/
theorem second_outer_high_iff (q : Nat → Nat) (L : Nat)
    (ha : Admissible L q) (hq : HighCarryWord q L)
    (hc : carry (nextColumns q L) (L + 1) = 0) :
    10 ≤ nextColumns (nextColumns q L) (L + 1) 0 ↔ 14 ≤ q 0 := by
  rw [second_outer_formula q L ha hq hc]
  have hp := first_admissible q L ha hq
  have hb := carry_bounded (nextColumns q L) (L + 1) hp.2.2.1 L (by omega)
  omega

/-- The exterior threshold is forced by an actual high return, without
any restriction requiring the first three positions to be distinct. -/
theorem high_return_outer_ge_fourteen (q : Nat → Nat) (L : Nat)
    (ha : Admissible L q) (hq : HighCarryWord q L)
    (hr : HighCarryWord (iterPairs q L 2).2 (iterPairs q L 2).1) :
    14 ≤ q 0 := by
  have hc := high_return_no_second_overflow q L ha hq hr
  have hs := high_return_state q L ha hq hr
  rw [hs] at hr
  have hout := hr.2
  change 10 ≤ nextColumns (nextColumns q L) (L + 1) 0 at hout
  exact (second_outer_high_iff q L ha hq hc).mp hout

/-- Complete necessary and sufficient conditions for an actual high
return. All carry values are generated by the actual first successor;
there are no selectable carry controls or assumed target-high premises
on the right-hand side. -/
theorem high_return_iff (q : Nat → Nat) (L : Nat)
    (ha : Admissible L q) (hq : HighCarryWord q L) :
    HighCarryWord (iterPairs q L 2).2 (iterPairs q L 2).1 ↔
      carry (nextColumns q L) (L + 1) = 0 ∧
      14 ≤ q 0 ∧
      ∀ i, i < L + 1 →
        LocalAllowed (nextColumns q L i)
          (actualCarrySum (nextColumns q L) (L + 1) i) := by
  have hp := first_admissible q L ha hq
  constructor
  · intro hr
    have hc := high_return_no_second_overflow q L ha hq hr
    have hout := high_return_outer_ge_fourteen q L ha hq hr
    have hs := high_return_state q L ha hq hr
    rw [hs] at hr
    refine ⟨hc, hout, ?_⟩
    intro i hi
    exact (nextColumns_high_iff (nextColumns q L) (L + 1) i
      hp.2.2.1 hp.2.2.2.1 hi hc).mp (hr.1 i hi)
  · rintro ⟨hc, hout, hlocal⟩
    have hw := HighCarryReduction.nextWidth_eq q L ha.1 hq
    change HighCarryWord (nextColumns (nextColumns q L) (nextWidth q L))
      (nextWidth (nextColumns q L) (nextWidth q L))
    rw [hw]
    have hw' : nextWidth (nextColumns q L) (L + 1) = L + 1 := by
      simp only [nextWidth, hc, if_true]
    rw [hw']
    refine ⟨?_, (second_outer_high_iff q L ha hq hc).mpr hout⟩
    intro i hi
    exact (nextColumns_high_iff (nextColumns q L) (L + 1) i
      hp.2.2.1 hp.2.2.2.1 hi hc).mpr (hlocal i hi)

#print axioms second_outer_formula
#print axioms second_outer_high_iff
#print axioms high_return_outer_ge_fourteen
#print axioms high_return_iff

end Agent105.ReturnCriterion
