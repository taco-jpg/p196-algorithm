Agent105.AffineDynamics.wordAt_nil (k : Nat) : Agent102.wordAt [] k = []
Agent105.AffineDynamics.wordAt_cons (r : Agent102.RunSpec) (rs : List Agent102.RunSpec) (k : Nat) :
  Agent102.wordAt (r :: rs) k = List.replicate (r.length.eval k).toNat r.digit ++ Agent102.wordAt rs k
Agent105.AffineDynamics.wordAt_append (rs ss : List Agent102.RunSpec) (k : Nat) :
  Agent102.wordAt (rs ++ ss) k = Agent102.wordAt rs k ++ Agent102.wordAt ss k
Agent105.AffineDynamics.wordAt_singleton (r : Agent102.RunSpec) (k : Nat) :
  Agent102.wordAt [r] k = List.replicate (r.length.eval k).toNat r.digit
Agent105.AffineDynamics.wordAt_constRun (digit count k : Nat) :
  Agent102.wordAt [Agent105.AffineDynamics.constRun digit count] k = List.replicate count digit
Agent105.AffineDynamics.wordAt_reverse (rs : List Agent102.RunSpec) (k : Nat) :
  Agent102.wordAt rs.reverse k = (Agent102.wordAt rs k).reverse
Agent105.AffineDynamics.minusOne_eval (f : Agent102.Affine) (k : Nat) :
  (Agent105.AffineDynamics.minusOne f).eval k = f.eval k - 1
Agent105.AffineDynamics.minusOne_toNat (f : Agent102.Affine) (k : Nat) :
  ((Agent105.AffineDynamics.minusOne f).eval k).toNat = (f.eval k).toNat - 1
Agent105.AffineDynamics.specBound_nil (b : Nat) : Agent105.AffineDynamics.SpecBound [] b
Agent105.AffineDynamics.specBound_cons {r : Agent102.RunSpec} {rs : List Agent102.RunSpec} {b : Nat} (hr : r.digit ≤ b)
  (hs : Agent105.AffineDynamics.SpecBound rs b) : Agent105.AffineDynamics.SpecBound (r :: rs) b
Agent105.AffineDynamics.specBound_reverse {rs : List Agent102.RunSpec} {b : Nat}
  (h : Agent105.AffineDynamics.SpecBound rs b) : Agent105.AffineDynamics.SpecBound rs.reverse b
Agent105.AffineDynamics.wordAt_bounded (rs : List Agent102.RunSpec) (b k : Nat)
  (h : Agent105.AffineDynamics.SpecBound rs b) : Agent8.Bounded (Agent102.wordAt rs k) b
Agent105.AffineDynamics.hasAffineRuns_wordAt (rs : List Agent102.RunSpec) (b : Nat)
  (h : Agent105.AffineDynamics.SpecBound rs b) : Agent105.AffineDynamics.HasAffineRuns (Agent102.wordAt rs) b
Agent105.TailSelection.eventually_of_forall {P : Nat → Prop} (h : ∀ (k : Nat), P k) :
  Agent105.TailSelection.Eventually P
Agent105.TailSelection.eventually_mono {P Q : Nat → Prop} (hP : Agent105.TailSelection.Eventually P)
  (hPQ : ∀ (k : Nat), P k → Q k) : Agent105.TailSelection.Eventually Q
Agent105.TailSelection.eventually_and {P Q : Nat → Prop} (hP : Agent105.TailSelection.Eventually P)
  (hQ : Agent105.TailSelection.Eventually Q) : Agent105.TailSelection.Eventually fun k => P k ∧ Q k
Agent105.TailSelection.eventually_not_contradiction {P : Nat → Prop} (hP : Agent105.TailSelection.Eventually P)
  (hN : Agent105.TailSelection.Eventually fun k => ¬P k) : False
Agent105.TailSelection.tailStable_const (p : Prop) : Agent105.TailSelection.TailStable fun x => p
Agent105.TailSelection.tailStable_congr {P Q : Nat → Prop} (hPQ : ∀ (k : Nat), P k ↔ Q k)
  (hP : Agent105.TailSelection.TailStable P) : Agent105.TailSelection.TailStable Q
Agent105.TailSelection.tailStable_of_eventually {P : Nat → Prop} (hP : Agent105.TailSelection.Eventually P) :
  Agent105.TailSelection.TailStable P
Agent105.TailSelection.tailStable_of_eventually_not {P : Nat → Prop}
  (hP : Agent105.TailSelection.Eventually fun k => ¬P k) : Agent105.TailSelection.TailStable P
Agent105.TailSelection.tailStable_not {P : Nat → Prop} (hP : Agent105.TailSelection.TailStable P) :
  Agent105.TailSelection.TailStable fun k => ¬P k
Agent105.TailSelection.tailStable_and {P Q : Nat → Prop} (hP : Agent105.TailSelection.TailStable P)
  (hQ : Agent105.TailSelection.TailStable Q) : Agent105.TailSelection.TailStable fun k => P k ∧ Q k
Agent105.TailSelection.tailStable_iff_eventually_or_not {P : Nat → Prop} :
  Agent105.TailSelection.TailStable P ↔
    Agent105.TailSelection.Eventually P ∨ Agent105.TailSelection.Eventually fun k => ¬P k
Agent105.TailSelection.eventually_forall_list.{u} {α : Type u} (xs : List α) {P : α → Nat → Prop}
  (hP : ∀ (a : α), a ∈ xs → Agent105.TailSelection.Eventually (P a)) :
  Agent105.TailSelection.Eventually fun k => ∀ (a : α), a ∈ xs → P a k
Agent105.TailSelection.tailStable_forall_list.{u} {α : Type u} (xs : List α) {P : α → Nat → Prop}
  (hP : ∀ (a : α), a ∈ xs → Agent105.TailSelection.TailStable (P a)) :
  Agent105.TailSelection.TailStable fun k => ∀ (a : α), a ∈ xs → P a k
Agent105.TailSelection.tailStable_forall_pos_le (B : Nat) {R : Nat → Nat → Prop}
  (hR : ∀ (t : Nat), 1 ≤ t → t ≤ B → Agent105.TailSelection.TailStable (R t)) :
  Agent105.TailSelection.TailStable fun k => ∀ (t : Nat), 1 ≤ t → t ≤ B → R t k
Agent105.TailSelection.uniform_tail_of_finite_cover.{u} {α : Type u} (xs : List α) {R : α → Nat → Prop}
  (hStable : ∀ (t : α), t ∈ xs → Agent105.TailSelection.TailStable (R t))
  (hCover : Agent105.TailSelection.Eventually fun k => ∃ t, t ∈ xs ∧ R t k) :
  ∃ t, t ∈ xs ∧ Agent105.TailSelection.Eventually (R t)
Agent105.TailSelection.uniform_bounded_tail_selection (B : Nat) {R : Nat → Nat → Prop}
  (hStable : ∀ (t : Nat), 1 ≤ t → t ≤ B → Agent105.TailSelection.TailStable (R t))
  (hCover : Agent105.TailSelection.Eventually fun k => ∃ t, 1 ≤ t ∧ t ≤ B ∧ R t k) :
  ∃ t, 1 ≤ t ∧ t ≤ B ∧ Agent105.TailSelection.Eventually (R t)
Agent105.TailSelection.return_and_safety_tailStable (t : Nat) {Return Safe : Nat → Nat → Prop}
  (hReturn : Agent105.TailSelection.TailStable (Return t))
  (hSafe : ∀ (i : Nat), 1 ≤ i → i ≤ t → Agent105.TailSelection.TailStable (Safe i)) :
  Agent105.TailSelection.TailStable fun k => Return t k ∧ ∀ (i : Nat), 1 ≤ i → i ≤ t → Safe i k
Agent105.TailSelection.uniform_safe_return_time (B : Nat) {Return Safe : Nat → Nat → Prop}
  (hReturn : ∀ (t : Nat), 1 ≤ t → t ≤ B → Agent105.TailSelection.TailStable (Return t))
  (hSafe : ∀ (i : Nat), 1 ≤ i → i ≤ B → Agent105.TailSelection.TailStable (Safe i))
  (hCover :
    Agent105.TailSelection.Eventually fun k =>
      ∃ t, 1 ≤ t ∧ t ≤ B ∧ Return t k ∧ ∀ (i : Nat), 1 ≤ i → i ≤ t → Safe i k) :
  ∃ t, 1 ≤ t ∧ t ≤ B ∧ ∃ K, ∀ (k : Nat), K ≤ k → Return t k ∧ ∀ (i : Nat), 1 ≤ i → i ≤ t → Safe i k
Agent105.ReturnTimeBound.orbit_width_potential_bound (w : Agent8.Word) (t : Nat) (hw : Agent8.CanonicalPair w) :
  ↑t + Agent8.lowerPotential (List.headD (Agent8.orbit w t) 0) + 4 * ↑(List.length w) ≤
    Agent8.lowerPotential (List.headD w 0) + 4 * ↑(List.length (Agent8.orbit w t))
Agent105.ReturnTimeBound.return_width_potential_bound (w v : Agent8.Word) (t : Nat) (hw : Agent8.CanonicalPair w)
  (hreturn : Agent8.orbit w t = v) :
  ↑t + Agent8.lowerPotential (List.headD v 0) + 4 * ↑(List.length w) ≤
    Agent8.lowerPotential (List.headD w 0) + 4 * ↑(List.length v)
Agent105.ReturnTimeBound.return_time_bounds_of_width_gain (w v : Agent8.Word) (t gain : Nat)
  (hw : Agent8.CanonicalPair w) (hreturn : Agent8.orbit w t = v) (hhead : List.headD v 0 = List.headD w 0)
  (hwidth : List.length v = List.length w + gain) : 2 * gain ≤ t ∧ t ≤ 4 * gain
Agent105.ReturnTimeBound.positive_return_time_bound_of_width_gain (w v : Agent8.Word) (t gain : Nat)
  (hw : Agent8.CanonicalPair w) (hreturn : Agent8.orbit w t = v) (hhead : List.headD v 0 = List.headD w 0)
  (hwidth : List.length v = List.length w + gain) (ht : 0 < t) : 1 ≤ t ∧ t ≤ 4 * gain
Agent105.ReturnTimeBound.return_time_bound_with_offset (w v : Agent8.Word) (t gain sourceOffset targetOffset : Nat)
  (hw : Agent8.CanonicalPair w) (hreturn : Agent8.orbit w t = v)
  (hwidth : List.length v + sourceOffset ≤ List.length w + gain + targetOffset) :
  ↑t + 4 * ↑sourceOffset + Agent8.lowerPotential (List.headD v 0) ≤
    4 * ↑gain + 4 * ↑targetOffset + Agent8.lowerPotential (List.headD w 0)
Agent105.ReturnTimeBound.same_head_return_time_bound_with_offset (w v : Agent8.Word)
  (t gain sourceOffset targetOffset : Nat) (hw : Agent8.CanonicalPair w) (hreturn : Agent8.orbit w t = v)
  (hhead : List.headD v 0 = List.headD w 0)
  (hwidth : List.length v + sourceOffset ≤ List.length w + gain + targetOffset) :
  t + 4 * sourceOffset ≤ 4 * gain + 4 * targetOffset
Agent105.ReturnTimeBound.word_family_return_time_bound (Q : Nat → Agent8.Word) (k s A t : Nat) (hA : 0 < A) (hs : 0 < s)
  (ht : 0 < t) (hcanonical : Agent8.CanonicalPair (Q k)) (hreturn : Agent8.orbit (Q k) t = Q (k + s))
  (hhead : List.headD (Q (k + s)) 0 = List.headD (Q k) 0)
  (hwidth : List.length (Q (k + s)) = List.length (Q k) + A * s) : 0 < 4 * A * s ∧ 1 ≤ t ∧ t ≤ 4 * A * s
Agent105.ReturnTimeBound.affine_endpoint_return_time_bound (Q : Nat → Agent8.Word) (k s A B t : Nat) (hA : 0 < A)
  (hs : 0 < s) (ht : 0 < t) (hcanonical : Agent8.CanonicalPair (Q k)) (hreturn : Agent8.orbit (Q k) t = Q (k + s))
  (hhead : List.headD (Q (k + s)) 0 = List.headD (Q k) 0) (hsource : List.length (Q k) = A * k + B)
  (htarget : List.length (Q (k + s)) = A * (k + s) + B) : 0 < 4 * A * s ∧ 1 ≤ t ∧ t ≤ 4 * A * s
Agent105.ReturnTimeBound.affine_endpoint_return_time_bound_with_offset (Q : Nat → Agent8.Word)
  (k s A sourceOffset targetOffset t : Nat) (hA : 0 < A) (hs : 0 < s) (ht : 0 < t)
  (hcanonical : Agent8.CanonicalPair (Q k)) (hreturn : Agent8.orbit (Q k) t = Q (k + s))
  (hhead : List.headD (Q (k + s)) 0 = List.headD (Q k) 0) (hsource : List.length (Q k) = A * k + sourceOffset)
  (htarget : List.length (Q (k + s)) = A * (k + s) + targetOffset) :
  0 < 4 * A * s ∧ 1 ≤ t ∧ t + 4 * sourceOffset ≤ 4 * A * s + 4 * targetOffset
