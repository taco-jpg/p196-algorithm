Agent105.AffineNormalize.singleton_pow (x k : Nat) : Agent1.RepeatedBlock.pow [x] k = List.replicate k x
Agent105.AffineNormalize.terminalCarry_replicate_succ (x e k : Nat) (hx : x ≤ 18) (he : e ≤ 1) :
  Agent8.terminalCarry (List.replicate (k + 1) x) e = (x + e) / 10
Agent105.AffineNormalize.fixedDigits_replicate_succ (x e k : Nat) (hx : x ≤ 18) (he : e ≤ 1) :
  Agent8.fixedDigits (List.replicate (k + 1) x) e = [(x + e) % 10] ++ List.replicate k ((x + (x + e) / 10) % 10)
Agent105.AffineNormalize.normalize_replicate_succ (x e k : Nat) (hx : x ≤ 18) (he : e ≤ 1) :
  Agent8.normalize (List.replicate (k + 1) x) e =
    [(x + e) % 10] ++ List.replicate k ((x + (x + e) / 10) % 10) ++ if (x + e) / 10 = 0 then [] else [(x + e) / 10]
Agent105.AffineNormalize.terminalCarry_replicate_nine (m e : Nat) (he : e ≤ 1) :
  Agent8.terminalCarry (List.replicate m 9) e = e
Agent105.AffineNormalize.fixedDigits_replicate_nine (m e : Nat) (he : e ≤ 1) :
  Agent8.fixedDigits (List.replicate m 9) e = List.replicate m ((9 + e) % 10)
Agent105.AffineNormalize.normalize_replicate_nine (m e : Nat) (he : e ≤ 1) :
  Agent8.normalize (List.replicate m 9) e = List.replicate m ((9 + e) % 10) ++ if e = 0 then [] else [e]
Agent105.AffineNormalize.fixedRunSpec_bound (r : Agent102.RunSpec) (e : Nat) :
  Agent105.AffineDynamics.SpecBound (Agent105.AffineNormalize.fixedRunSpec r e) 9
Agent105.AffineNormalize.fixedDigits_carry_positive_run (r : Agent102.RunSpec) (e k : Nat) (hr : r.digit ≤ 18)
  (he : e ≤ 1) (hpos : 0 < (r.length.eval k).toNat) :
  Agent8.fixedDigits (List.replicate (r.length.eval k).toNat r.digit) e =
      Agent102.wordAt (Agent105.AffineNormalize.fixedRunSpec r e) k ∧
    Agent8.terminalCarry (List.replicate (r.length.eval k).toNat r.digit) e = (r.digit + e) / 10
