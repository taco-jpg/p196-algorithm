  (t gain sourceOffset targetOffset : Nat) (hw : Agent8.CanonicalPair w) (hreturn : Agent8.orbit w t = v)
  (hhead : List.headD v 0 = List.headD w 0)
  (hwidth : List.length v + sourceOffset ≤ List.length w + gain + targetOffset) :
