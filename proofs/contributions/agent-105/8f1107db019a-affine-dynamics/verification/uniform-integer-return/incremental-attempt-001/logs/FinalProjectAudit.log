  ↑t + Agent8.lowerPotential (List.headD (Agent8.orbit w t) 0) + 4 * ↑(List.length w) ≤
    Agent8.lowerPotential (List.headD w 0) + 4 * ↑(List.length (Agent8.orbit w t))
