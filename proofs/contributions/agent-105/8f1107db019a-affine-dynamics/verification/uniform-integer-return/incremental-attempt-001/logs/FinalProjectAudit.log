  ↑t + Agent8.lowerPotential (List.headD v 0) + 4 * ↑(List.length w) ≤
    Agent8.lowerPotential (List.headD w 0) + 4 * ↑(List.length v)
Agent105.ReturnTimeBound.return_time_bounds_of_width_gain (w v : Agent8.Word) (t gain : Nat)
