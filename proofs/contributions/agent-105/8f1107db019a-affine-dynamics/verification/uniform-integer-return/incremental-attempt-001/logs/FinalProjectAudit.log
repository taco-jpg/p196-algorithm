  (ht : 0 < t) (hcanonical : Agent8.CanonicalPair (Q k)) (hreturn : Agent8.orbit (Q k) t = Q (k + s))
  (hhead : List.headD (Q (k + s)) 0 = List.headD (Q k) 0)
  (hwidth : List.length (Q (k + s)) = List.length (Q k) + A * s) : 0 < 4 * A * s ∧ 1 ≤ t ∧ t ≤ 4 * A * s
