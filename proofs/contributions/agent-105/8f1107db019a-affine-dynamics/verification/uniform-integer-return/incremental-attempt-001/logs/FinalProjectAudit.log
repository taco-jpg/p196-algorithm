  (hs : 0 < s) (ht : 0 < t) (hcanonical : Agent8.CanonicalPair (Q k)) (hreturn : Agent8.orbit (Q k) t = Q (k + s))
  (hhead : List.headD (Q (k + s)) 0 = List.headD (Q k) 0) (hsource : List.length (Q k) = A * k + B)
  (htarget : List.length (Q (k + s)) = A * (k + s) + B) : 0 < 4 * A * s ∧ 1 ≤ t ∧ t ≤ 4 * A * s
