  (hw : Agent8.CanonicalPair w) (hreturn : Agent8.orbit w t = v) (hhead : List.headD v 0 = List.headD w 0)
  (hwidth : List.length v = List.length w + gain) (ht : 0 < t) : 1 ≤ t ∧ t ≤ 4 * gain
Agent105.ReturnTimeBound.return_time_bound_with_offset (w v : Agent8.Word) (t gain sourceOffset targetOffset : Nat)
  (hw : Agent8.CanonicalPair w) (hreturn : Agent8.orbit w t = v)
  (hwidth : List.length v + sourceOffset ≤ List.length w + gain + targetOffset) :
  ↑t + 4 * ↑sourceOffset + Agent8.lowerPotential (List.headD v 0) ≤
    4 * ↑gain + 4 * ↑targetOffset + Agent8.lowerPotential (List.headD w 0)
