theorem Agent105.UniformReturn.uniform_bounded_return : ∀ (Q : Nat → List Nat),
  Agent105.AffineDynamics.HasAffineRuns Q 18 →
    ∀ (s B : Nat),
      (Agent105.TailSelection.Eventually fun k => ∃ t, 1 ≤ t ∧ t ≤ B ∧ Agent8.orbit (Q k) t = Q (k + s)) →
        ∃ t, 1 ≤ t ∧ t ≤ B ∧ ∃ K, ∀ (k : Nat), K ≤ k → Agent8.orbit (Q k) t = Q (k + s) :=
fun Q hQ s B hcover =>
  Agent105.TailSelection.uniform_bounded_tail_selection B
