Agent105.UniformReturn.uniform_return_wordAt (rs : List Agent102.RunSpec)
  (hrs : Agent105.AffineDynamics.SpecBound rs 18) (s : Nat) (hA : 0 < Agent105.AffineShape.widthSlope rs) (hs : 0 < s)
  (hcanonical : Agent105.TailSelection.Eventually fun k => Agent8.CanonicalPair (Agent102.wordAt rs k))
  (hreturn :
    Agent105.TailSelection.Eventually fun k =>
      ∃ t, 0 < t ∧ Agent8.orbit (Agent102.wordAt rs k) t = Agent102.wordAt rs (k + s)) :
  ∃ t,
    1 ≤ t ∧
      t ≤ 4 * Agent105.AffineShape.widthSlope rs * s ∧
        ∃ K, ∀ (k : Nat), K ≤ k → Agent8.orbit (Agent102.wordAt rs k) t = Agent102.wordAt rs (k + s)
theorem Agent105.UniformReturn.uniform_return_wordAt : ∀ (rs : List Agent102.RunSpec),
  Agent105.AffineDynamics.SpecBound rs 18 →
    ∀ (s : Nat),
      0 < Agent105.AffineShape.widthSlope rs →
        0 < s →
          (Agent105.TailSelection.Eventually fun k => Agent8.CanonicalPair (Agent102.wordAt rs k)) →
            (Agent105.TailSelection.Eventually fun k =>
                ∃ t, 0 < t ∧ Agent8.orbit (Agent102.wordAt rs k) t = Agent102.wordAt rs (k + s)) →
              ∃ t,
                1 ≤ t ∧
                  t ≤ 4 * Agent105.AffineShape.widthSlope rs * s ∧
                    ∃ K, ∀ (k : Nat), K ≤ k → Agent8.orbit (Agent102.wordAt rs k) t = Agent102.wordAt rs (k + s) :=
fun rs hrs s hA hs hcanonical hreturn =>
  Exists.casesOn hcanonical fun Kc hc =>
    Exists.casesOn hreturn fun Kr hr =>
      Exists.casesOn (Agent105.AffineShape.wordAt_head_width_eventually rs) fun d h =>
        Exists.casesOn h fun Kw hw =>
          let_fun hcover :=
            Exists.intro (max Kw (max Kc Kr)) fun k hk =>
              let_fun hkw := Nat.le_trans (Nat.le_max_left Kw (max Kc Kr)) hk;
              let_fun hkc := Nat.le_trans (Nat.le_trans (Nat.le_max_left Kc Kr) (Nat.le_max_right Kw (max Kc Kr))) hk;
              let_fun hkr := Nat.le_trans (Nat.le_trans (Nat.le_max_right Kc Kr) (Nat.le_max_right Kw (max Kc Kr))) hk;
              Exists.casesOn (hr k hkr) fun t h =>
                And.casesOn h fun ht hret =>
                  let_fun hhead :=
                    Eq.mpr
                      (id
                        (congrArg (fun _a => _a = (Agent102.wordAt rs k).headD 0)
                          (hw (k + s)
                              (Decidable.byContradiction fun a =>
                                Agent105.UniformReturn.uniform_return_wordAt._proof_1 rs s hs Kc Kr Kw k hkw t
                                  a)).left))
                      (Eq.mpr (id (congrArg (fun _a => d = _a) (hw k hkw).left)) (Eq.refl d));
                  let_fun hwidth := (hw k hkw).right s;
                  let_fun hbound :=
                    Agent105.ReturnTimeBound.word_family_return_time_bound (Agent102.wordAt rs) k s
                      (Agent105.AffineShape.widthSlope rs) t hA hs ht (hc k hkc) hret hhead hwidth;
                  Exists.intro t ⟨hbound.right.left, ⟨hbound.right.right, hret⟩⟩;
          Agent105.UniformReturn.uniform_bounded_return (Agent102.wordAt rs)
            (Agent105.AffineDynamics.hasAffineRuns_wordAt rs 18 hrs) s (4 * Agent105.AffineShape.widthSlope rs * s)
            hcover
