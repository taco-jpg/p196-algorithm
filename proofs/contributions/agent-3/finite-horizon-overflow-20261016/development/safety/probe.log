List.getElem?_append.{u_1} {α : Type u_1} {l₁ l₂ : List α} {i : Nat} :
  (l₁ ++ l₂)[i]? = if i < l₁.length then l₁[i]? else l₂[i - l₁.length]?
List.getElem?_replicate.{u_1} {n : Nat} {α✝ : Type u_1} {a : α✝} {i : Nat} :
  (List.replicate n a)[i]? = if i < n then some a else none
List.getElem?_reverse.{u_1} {α : Type u_1} {l : List α} {i : Nat} (h : i < l.length) :
  l.reverse[i]? = l[l.length - 1 - i]?
