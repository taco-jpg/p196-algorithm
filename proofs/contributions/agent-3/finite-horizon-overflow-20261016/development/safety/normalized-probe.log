List.getElem?_zipWith.{u_1, u_2, u_3} {α : Type u_1} {β : Type u_2} {γ : Type u_3} {as : List α} {bs : List β}
  {f : α → β → γ} {i : Nat} :
  (List.zipWith f as bs)[i]? =
    match as[i]?, bs[i]? with
    | some a, some b => some (f a b)
    | x, x_1 => none
List.getElem_zipWith.{u_1, u_2, u_3} {α : Type u_1} {β : Type u_2} {γ : Type u_3} {f : α → β → γ} {l : List α}
  {l' : List β} {i : Nat} {h : i < (List.zipWith f l l').length} : (List.zipWith f l l')[i] = f l[i] l'[i]
List.getElem_reverse.{u_1} {α : Type u_1} {l : List α} {i : Nat} (h : i < l.reverse.length) :
  l.reverse[i] = l[l.length - 1 - i]
List.getElem?_reverse.{u_1} {α : Type u_1} {l : List α} {i : Nat} (h : i < l.length) :
  l.reverse[i]? = l[l.length - 1 - i]?
List.getElem?_cons_zero.{u_1} {α : Type u_1} {a : α} {l : List α} : (a :: l)[0]? = some a
List.getLast?_eq_getElem?.{u_1} {α : Type u_1} {l : List α} : l.getLast? = l[l.length - 1]?
List.getLastD.{u} {α : Type u} (as : List α) (fallback : α) : α
DecimalDigits.value_positive (d : Nat → Nat) (L : Nat) (hL : 0 < L) (hlead : 0 < d (L - 1)) :
  0 < DecimalDigits.value d L
FoldedDecimal.step_eq_word_value (n : Nat) (d q : Nat → Nat) (L : Nat) (hcan : DecimalDigits.Canonical n d L)
  (hrep : ∀ (i : Nat), i < L → DecimalDigits.columnSum d L i = q i) : Lychrel196.step n = DecimalDigits.value q L
Lychrel196.orbit (n : Nat) : Nat → Nat
Agent8.pair_length (w : Agent8.Word) : List.length (Agent8.pair w) = List.length w
