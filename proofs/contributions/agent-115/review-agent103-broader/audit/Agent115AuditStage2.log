BroaderBound.returns_le_90_plus_warmup : ∀ (q : Nat → Nat) (L R : Nat),
  FoldedDecimal.Admissible L q →
    2 ≤ L → (∀ (k : Nat), k ≤ R → BroaderClock.pairAt q L (7 * k) = (4, 4)) → R ≤ 90 + ScalarOrbit.warmup L
BroaderBound.returns_le_94 : ∀ (q : Nat → Nat) (L a R : Nat),
  FoldedDecimal.Admissible L q → 2 ≤ L → (∀ (k : Nat), k ≤ R → BroaderClock.pairAt q L (a + 7 * k) = (4, 4)) → R ≤ 94
BroaderBound.wide_returns_le_90 : ∀ (q : Nat → Nat) (L a R : Nat),
  FoldedDecimal.Admissible L q →
    2 ≤ L →
      14 ≤ ScalarOrbit.widthAt q L a → (∀ (k : Nat), k ≤ R → BroaderClock.pairAt q L (a + 7 * k) = (4, 4)) → R ≤ 90
BroaderBound.no_95_returns : ∀ (q : Nat → Nat) (L a : Nat),
  FoldedDecimal.Admissible L q → 2 ≤ L → ¬∀ (k : Nat), k ≤ 95 → BroaderClock.pairAt q L (a + 7 * k) = (4, 4)
BroaderClock.return_forces_clock : ∀ (q : Nat → Nat) (L a : Nat),
  FoldedDecimal.Admissible L q →
    2 ≤ L →
      BroaderClock.pairAt q L a = (4, 4) →
        BroaderClock.pairAt q L (a + 7) = (4, 4) →
          ∀ (i : Nat), i ≤ 7 → (OverflowCarryNormalization.iterPairs q L (a + i)).snd 0 = ScalarClock.phase i
BroaderHierarchy.finite_root_bound : ∀ (q : Nat → Nat) (L a s n : Nat) (path : Nat → Nat),
  FoldedDecimal.Admissible L q →
    14 ≤ L → ActualPrefixLift.ActualPath (ScalarFinite.graph BroaderJobData.data0) q L 2 a s path n → n ≤ 636
def ScalarOrbit.warmup : Nat → Nat :=
fun L => (14 - L + 2) / 3
def BroaderClock.pairAt : (Nat → Nat) → Nat → Nat → Nat × Nat :=
fun q L t => ((OverflowCarryNormalization.iterPairs q L t).snd 0, (OverflowCarryNormalization.iterPairs q L t).snd 1)
def FoldedDecimal.Admissible : Nat → (Nat → Nat) → Prop :=
fun L q =>
  0 < L ∧
    0 < q 0 ∧
      (∀ (i : Nat), i < L → q i ≤ 18) ∧
        (∀ (i : Nat), i < L → q i = q (L - 1 - i)) ∧ ∀ (i : Nat), i < L → i = L - 1 - i → q i % 2 = 0
def OverflowCarryNormalization.iterPairs : (Nat → Nat) → Nat → Nat → Nat × (Nat → Nat) :=
fun q L x =>
  Nat.brecOn x fun x f =>
    (match (motive := (x : Nat) → Nat.below x → Nat × (Nat → Nat)) x with
      | 0 => fun x => (L, q)
      | k.succ => fun x =>
        let prev := x.1;
        (FoldedDecimal.nextWidth prev.snd prev.fst, FoldedDecimal.nextColumns prev.snd prev.fst))
      f
