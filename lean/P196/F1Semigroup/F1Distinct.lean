theorem KL_length : KL.length = 434 := by decide +kernel

theorem KL_ok : ∀ i, i < nS → KL.getD i 0 = keyOf (Sget i) := by decide +kernel

theorem KL_nodup : KL.Nodup := by decide +kernel

/-- the states `Sget 0 .. Sget 433` are pairwise distinct relations -/
theorem Sget_inj (i j : Nat) (hi : i < nS) (hj : j < nS) (h : Sget i = Sget j) : i = j := by
  by_cases hne : i = j
  · exact hne
  exfalso
  have hpw : List.Pairwise (fun a b => a ≠ b) KL := KL_nodup
  rw [List.pairwise_iff_getElem] at hpw
  have hi' : i < KL.length := by rw [KL_length]; exact hi
  have hj' : j < KL.length := by rw [KL_length]; exact hj
  have ki : KL[i] = keyOf (Sget i) := by
    have := KL_ok i hi
    rwa [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi', Option.getD_some] at this
  have kj : KL[j] = keyOf (Sget j) := by
    have := KL_ok j hj
    rwa [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj', Option.getD_some] at this
  have hkey : KL[i] = KL[j] := by rw [ki, kj, h]
  rcases Nat.lt_or_gt_of_ne hne with hlt | hgt
  · exact hpw i j hi' hj' hlt hkey
  · exact hpw j i hj' hi' hgt hkey.symm

/-- Main statement: exactly 434 pairwise distinct relation states are reachable. -/
theorem reachable_relations_434 :
    nS = 434 ∧
    (∀ w, ∃ i, i < nS ∧ run initRel w = Sget i) ∧
    (∀ i, i < nS → ∃ w, run initRel w = Sget i) ∧
    (∀ i j, i < nS → j < nS → Sget i = Sget j → i = j) :=
  ⟨rfl, S_is_reachable_set.1, S_is_reachable_set.2, Sget_inj⟩

end F1
