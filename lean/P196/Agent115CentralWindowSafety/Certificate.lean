def packed (s : State) : Nat := certificate.getD s.val 0

def rank (s : State) : Nat := packed s / 76

def selectedControl (s : State) : Fin 76 :=
  ⟨packed s % 76, Nat.mod_lt _ (by decide)⟩

theorem certificate_size : certificate.size = 551 := by decide

/-- The arithmetic image bound is proved uniformly, without table evaluation. -/
theorem selected_bounded (s : State) :
    rawNext s (selectedControl s).val < 551 :=
  rawNext_bounded s (selectedControl s).val

def selected (s : State) : State :=
  ⟨rawNext s (selectedControl s).val, selected_bounded s⟩

theorem selected_edge (s : State) : Edge s (selected s) :=
  ⟨selectedControl s, rfl⟩

/-- Each Boolean row recomputes the chosen arithmetic successor. -/
def rowOK (s : State) : Bool :=
  decide ((safe s = true → rank (selected s) < rank s) ∧
    (safe s = true ↔ 0 < rank s) ∧ rank s ≤ 4)

/-- Small blocks keep ordinary kernel reduction within the build budget. -/
def checkBlock (block : Nat) : Bool :=
  (List.range 19).all fun offset =>
    let i := 19 * block + offset
    if hi : i < 551 then rowOK ⟨i, hi⟩ else false

