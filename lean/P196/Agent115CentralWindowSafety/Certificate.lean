private theorem checkedBlock : ∀ block, block < 29 → checkBlock block = true
  | 0, _ => checked00
  | 1, _ => checked01
  | 2, _ => checked02
  | 3, _ => checked03
  | 4, _ => checked04
  | 5, _ => checked05
  | 6, _ => checked06
  | 7, _ => checked07
  | 8, _ => checked08
  | 9, _ => checked09
  | 10, _ => checked10
  | 11, _ => checked11
  | 12, _ => checked12
  | 13, _ => checked13
  | 14, _ => checked14
  | 15, _ => checked15
  | 16, _ => checked16
  | 17, _ => checked17
  | 18, _ => checked18
  | 19, _ => checked19
  | 20, _ => checked20
  | 21, _ => checked21
  | 22, _ => checked22
  | 23, _ => checked23
  | 24, _ => checked24
  | 25, _ => checked25
  | 26, _ => checked26
  | 27, _ => checked27
  | 28, _ => checked28
  | n + 29, h => by omega

private theorem rowOK_true (s : State) : rowOK s = true := by
  have hb : s.val / 19 < 29 := by have := s.isLt; omega
  have hk : s.val % 19 < 19 := Nat.mod_lt _ (by decide)
  have h := checkedBlock (s.val / 19) hb
  unfold checkBlock at h
  have hr := List.all_eq_true.mp h (s.val % 19) (List.mem_range.mpr hk)
  have heq : 19 * (s.val / 19) + s.val % 19 = s.val := by omega
  simpa only [heq, dif_pos s.isLt] using hr

private theorem rows (s : State) :
    (safe s = true → rank (selected s) < rank s) ∧
    (safe s = true ↔ 0 < rank s) ∧ rank s ≤ 4 :=
  of_decide_eq_true (rowOK_true s)

/-- The substantive finite decrease follows from the checked Boolean rows. -/
theorem selected_rank_decreases (s : State) :
    safe s = true → rank (selected s) < rank s := (rows s).1

theorem safe_iff_positive_rank (s : State) :
    safe s = true ↔ 0 < rank s := (rows s).2.1

theorem rank_le_four (s : State) : rank s ≤ 4 := (rows s).2.2

/-- Any set closed under EVERY local control and contained in the safe
predicate is empty. Selected escape edges suffice; other edges may cycle. -/
theorem universally_safe_empty (S : State → Prop) (hS : UniversallySafe S) :
    ∀ s, ¬ S s :=
  no_invariant_of_selected_descent rank selected (fun s _ => selected_edge s)
    selected_rank_decreases S hS

theorem no_nonempty_universally_safe :
    ¬ ∃ S : State → Prop, UniversallySafe S ∧ ∃ s, S s := by
  rintro ⟨S, hS, s, hs⟩
  exact universally_safe_empty S hS s hs

