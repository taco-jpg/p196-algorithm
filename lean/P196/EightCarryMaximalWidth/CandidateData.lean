import P196.EightCarryMaximalWidth.EncodedHistory

/-!
Finite candidate data for the two short symmetric difference patterns.
Every narrowing step is certified by coverage of a complete bounded
enumeration in the importing certificate modules. Extra candidates would
be harmless: the final stage excludes every extension of the last cover.
-/

namespace EightCarryMaximalWidth.Candidates
open PrefixHistory

abbrev Pair := List Nat × List Nat

def accepted (p : Pair) : Bool := survivesEncoded 8 p.1 p.2

/-- One-sided coverage is sufficient for elimination. Membership is tested
first, so already retained candidates need no repeated survival evaluation. -/
def covered (starts allowed : List Pair) : Bool :=
  starts.all fun p => allowed.contains p || !accepted p

theorem covered_mem (starts allowed : List Pair) (h : covered starts allowed = true)
    (p : Pair) (hp : p ∈ starts) (ha : accepted p = true) : p ∈ allowed := by
  have hc := List.all_eq_true.mp h p hp
  have hm : allowed.contains p = true := by simpa only [ha, Bool.not_true,
    Bool.or_false] using hc
  exact List.contains_iff_mem.mp hm

/-- Every admissible three-column start with difference (0,0,1),
partitioned by its positive exterior coefficient. -/
def startsAt (p : Nat) : List Pair :=
  (List.range 19).flatMap fun b =>
    (List.range 18).map fun a => ([p, b, a + 1], [p, b, a])

/-- Append every bounded coefficient pair with the prescribed offsets. -/
def extensions (leftOffset rightOffset count : Nat) (ps : List Pair) : List Pair :=
  ps.flatMap fun p => (List.range count).map fun a =>
    (p.1 ++ [a + leftOffset], p.2 ++ [a + rightOffset])

