theorem startsAt_mem (p b a : Nat) (hb : b < 19) (ha : a < 18) :
    ([p, b, a + 1], [p, b, a]) ∈ startsAt p := by
  apply List.mem_flatMap.mpr
  refine ⟨b, List.mem_range.mpr hb, ?_⟩
  exact List.mem_map.mpr ⟨a, List.mem_range.mpr ha, rfl⟩

theorem triples_mem_of_mem_at (p : Nat) (hp : 1 ≤ p) (hp' : p ≤ 18)
    (x : Pair) (hx : x ∈ triplesAt p) : x ∈ triples := by
  apply List.mem_flatMap.mpr
  refine ⟨p - 1, List.mem_range.mpr (by omega), ?_⟩
  simpa only [Nat.sub_add_cancel hp] using hx

theorem extensions_mem (leftOffset rightOffset count : Nat) (ps : List Pair)
    (s r : List Nat) (hp : (s, r) ∈ ps) (a : Nat) (ha : a < count) :
    (s ++ [a + leftOffset], r ++ [a + rightOffset]) ∈
      extensions leftOffset rightOffset count ps := by
  apply List.mem_flatMap.mpr
  refine ⟨(s, r), hp, ?_⟩
  exact List.mem_map.mpr ⟨a, List.mem_range.mpr ha, rfl⟩

