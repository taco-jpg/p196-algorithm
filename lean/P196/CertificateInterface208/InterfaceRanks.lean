import P196.Agent2SaturatedProfile.ReturnCertificate

/-! Exact finite rank for complementary interfaces of length at most two.
The carry is allowed to be either bit independently on every edge.
Only the local Ar formula and literal permitted trims are checked.
No ordinary orbit is enumerated. -/
namespace Agent208.Interface
open Agent109 Agent109.Cert

/-- The original interface update, with a freely supplied final-carry bit. -/
def raw (c : Nat) (A : Word) (g : Nat) : Word :=
  let D := norm A (kOf c)
  let R := norm A.reverse (kOf (18 - c))
  let u := (18 - c) + D.2 - 10 * kOf (18 - c)
  let v := c + R.2 - 10 * kOf c
  if g = 0 then
    zipAdd ([tOf c] ++ D.1 ++ [u])
      ([v] ++ R.1.reverse ++ [tOf (18 - c)])
  else zipAdd (D.1 ++ [u]) ([v] ++ R.1.reverse)

theorem Ar_eq_raw (c : Nat) (B A C : Word) :
    Ar c B A C = raw c A (data c B A C).γ := by
  rfl

theorem raw_length_le (c : Nat) (A : Word) (g : Nat) :
    (raw c A g).length ≤ A.length + 2 := by
  unfold raw
  split <;> rw [zipAdd_length] <;> simp [norm_length]

/-- Codes 0, 1..19, 20..380 enumerate exactly the bounded short words. -/
def decodeWord (i : Nat) : Word :=
  if i = 0 then [] else if i < 20 then [i - 1]
  else [(i - 20) / 19, (i - 20) % 19]

def wordCode : Word → Nat
  | [] => 0
  | [a] => a + 1
  | a :: b :: _ => 20 + 19 * a + b

def phaseCode (c : Nat) : Nat := c / 2 - 1

/-- Packed rank rows, with one hexadecimal digit per final coefficient. -/
