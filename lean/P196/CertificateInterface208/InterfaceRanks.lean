def rank (c : Nat) : Word → Nat
  | [] => emptyRank c
  | [a] => singletonRanks c / 16 ^ a % 16
  | a :: b :: _ => pairRanks c a / 16 ^ b % 16

/-- Reconstruct a potential middle after the supplied two trim counts. -/
def middle (W : Word) (j k : Nat) : Word :=
  (W.drop j).take (W.length - j - k)

def edgeCheck (c : Nat) (A : Word) (g j k : Nat) : Bool :=
  let cp := tOf c + tOf c
  let W := raw c A g
  let V := middle W j k
  if W = List.replicate j cp ++ V ++ List.replicate k (18 - cp) ∧ V.length ≤ 2
    then decide (rank cp V < rank c A)
    else true

def rowCheck (c : Nat) (A : Word) : Bool :=
  (List.range 2).all fun g => (List.range 5).all fun j =>
    (List.range 5).all fun k => edgeCheck c A g j k

def phaseCheck (p : Nat) : Bool :=
  (List.range 381).all fun a => rowCheck (2 * (p + 1)) (decodeWord a)

set_option maxRecDepth 200000
set_option maxHeartbeats 0

theorem phase0 : phaseCheck 0 = true := by decide +kernel

theorem phase1 : phaseCheck 1 = true := by decide +kernel

theorem phase2 : phaseCheck 2 = true := by decide +kernel

theorem phase3 : phaseCheck 3 = true := by decide +kernel

theorem phase4 : phaseCheck 4 = true := by decide +kernel

theorem phase5 : phaseCheck 5 = true := by decide +kernel

theorem phase6 : phaseCheck 6 = true := by decide +kernel

theorem phase7 : phaseCheck 7 = true := by decide +kernel

theorem phaseCheck_true (p : Nat) (hp : p < 8) : phaseCheck p = true := by
  have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 ∨ p = 5 ∨ p = 6 ∨ p = 7 := by omega
  rcases this with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact phase0
  · exact phase1
  · exact phase2
  · exact phase3
  · exact phase4
  · exact phase5
  · exact phase6
  · exact phase7

end Agent208.Interface
#print axioms Agent208.Interface.phaseCheck_true
