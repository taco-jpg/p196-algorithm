/-- An actual quotient transition has a stored product edge with its actual
clock, exceptional phase carry label, and physical outside target. -/
theorem quotient_outer_catalog_edge (B H w : Word)
    (hv : ValidPeriodic B H w) (hs : (w,outside B w) ∈ outerCatalog) :
    ∃ e, e ∈ outerEdges ∧ e.source = (w,outside B w) ∧
      e.clock = rawGamma B H w ∧
      e.carries = (if w = [9,9,9,9] then
        some (leftEntry B, rightEntry B H w) else none) ∧
      e.target = (rawPeriod B H w,
        outside (quotientOuter B H w) (rawPeriod B H w)) := by
  have hphase := outerCatalog_phase_mem (w,outside B w) hs
  obtain ⟨pe, hpe, hsource, hclock, hcarries, htarget⟩ :=
    rawPeriod_catalog_edge B H w hv.outer_bounded hv.center_bounded
      hv.period_bounded hv.period_length hphase
  obtain ⟨hbit, hgamma, hout⟩ := quotient_outside_step B H w hv
  let input := lastInput (periodicWord B H w 3)
  let q' := nextExterior (outside B w) input
  let e : OuterEdge := ⟨(w,outside B w), pe.clock, pe.carries, (pe.target,q')⟩
  have hchoice : q' ∈ outerImages (outside B w) pe.clock := by
    rw [hclock, hgamma]
    exact mem_outerImages_of_actual (outside B w) input hbit
  have houtput : e ∈ outerOutputs (w,outside B w) :=
    outerOutputs_mem_of_phaseEdge (w,outside B w) pe hpe hsource q' hchoice
  refine ⟨e, ?_, rfl, hclock, hcarries, ?_⟩
  · rw [outerEdges_spec]
    exact List.mem_flatMap.mpr ⟨(w,outside B w), hs, houtput⟩
  · change (pe.target,q') = _
    rw [htarget]
    exact congrArg (fun q => (rawPeriod B H w,q)) hout.symm

/-- Product membership and the original complete validity predicate are
preserved together by the exact maximal quotient. -/
theorem quotient_valid_in_outerCatalog (B H w : Word)
    (hv : ValidPeriodic B H w) (hs : (w,outside B w) ∈ outerCatalog) :
    ValidPeriodic (quotientOuter B H w) (quotientCenter B H w) (rawPeriod B H w) ∧
      (rawPeriod B H w, outside (quotientOuter B H w) (rawPeriod B H w)) ∈
        outerCatalog := by
  refine ⟨quotient_valid B H w hv, ?_⟩
  obtain ⟨e, he, _, _, _, ht⟩ := quotient_outer_catalog_edge B H w hv hs
  rw [← ht]
  exact outerEdge_target_mem e he

