import P196.EightCarryMaximalWidth.CertificateTools

/-!
Literal covers for two width-seven difference profiles observed seven times.
The imported encoded history checker is used with observation count seven.
Coverage is one-sided: retained literals bypass survival evaluation, and every
other bounded start is rejected by a separate kernel decision.
-/

namespace SevenCarryMaximalWidth.Candidates

open EightCarryMaximalWidth.PrefixHistory

abbrev Pair := EightCarryMaximalWidth.Candidates.Pair

/-- A single finite coverage obligation, using the imported history checker. -/
abbrev Leaf (allowed : List Pair) (p : Pair) : Prop :=
  (allowed.contains p || !survivesEncoded 7 p.1 p.2) = true

/-- A genuinely surviving prefix must belong to its certified literal cover. -/
theorem leaf_mem (allowed : List Pair) (p : Pair) (h : Leaf allowed p)
    (hs : survivesEncoded 7 p.1 p.2 = true) : p ∈ allowed := by
  apply List.contains_iff_mem.mp
  simpa only [Leaf, hs, Bool.not_true, Bool.or_false] using h


